# --- Secrets / tooling (NEVER commit) ---
.claude/                # fable5 evidence log captures raw commands incl. rig sudo password
settings.json
settings.local.json
.env
.env.*
*.pem
*.key
credentials.json
*_secret*
*_token*

# --- Databases / user data ---
*.sqlite
*.sqlite3
*.db

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Runtime output (regenerable; not source) ---
logs/
**/logs/
runs/
**/runs/

# --- OS junk ---
.DS_Store
Thumbs.db

# bf-p4c compiler output (regenerable from the .p4 sources) — do not track
**/compile*/out/
**/compile*/*.log
**/*_telem/out/
**/shadow/out/
**/probe_widen/o_k*/
deliverables/meeting_package/
deliverables/timing_meeting_package_*.tar.gz
deliverables/timing_tutorial/source/__pycache__/
research/timing_final/evidence/timing_final/

# bf-p4c compiler output trees are regenerable; keep only artifacts/ in git
build_*/

# publisher-copyrighted reference PDFs (imported into Zotero; must not reach public GitHub)
D3/
paper/rewrite/corpus/references/*.pdf
defense4/size/native_parity/evidence/E_FINAL/scripts/__pycache__/
**/__pycache__/

# --- manuscript build outputs (paper/rewrite): regenerable by pipeline/build.sh ---
paper/rewrite/pipeline/build/
# timestamped lin_check scorecards are build products; the named *.md reports are tracked
paper/rewrite/pipeline/reports/main_*.txt
paper/rewrite/pipeline/reports/main_*.json
paper/rewrite/pipeline/reports/*_flat*
*.aux
*.bbl
*.blg
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex

# uv-generated lockfile and venv from reproduce.sh (interpreter resolution), not source
defense4/timing/uv.lock
defense4/timing/.venv/
defense4/timing/evidence/campaign_v1/repro/.venv/
paper/rewrite/corpus/*.pdf

# Provenance logs for the 2026-09-16 hardware sessions are evidence, not build noise, so they are
# kept despite the compile-log rule above.
!defense4/timing/audit_current/epsilon_candidate/compile_2026091*/*.log

# Incoming review documents live beside the repository, not in it: the repository answers a
# review in its own files, and keeping the review too duplicates what the answer already says.
DNP3_*_Review_*.md
DNP3_*_Implementation_and_Paper_Review.md

