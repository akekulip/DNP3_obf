# Secrets and user data (never commit)
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials.json
**/settings.json
**/settings.local.json
**/*_secret*
**/*_token*
*.sqlite
*.sqlite3
*.db

# Private agent/session state and local archives
.claude/
.codex/
.agents/
.omx/
Archive/**
!Archive/README.md

# Python/editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
.vscode/
.idea/

# Rebuildable SDK products; sources, manifests and selected evidence are explicit.
results/**/compile_*/out/
results/**/compile_*/source/
results/**/model_*/model_*.log
results/**/model_*/model.out
results/**/model_*/model_stdout.txt
results/**/model_*/startup_stdout.txt
results/**/model_*/switchd.out
results/**/model_*/switchd.log
results/**/model_*/console.log

