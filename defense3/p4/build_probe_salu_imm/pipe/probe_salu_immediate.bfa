parser ingress:
  start: $entry_point.start
  init_zero: [ H3, B1, B0, B2 ]
  hdr_len_adj: 16
  states:
    $entry_point.start:
      *:
        0..1: H0  # bit[7..15] -> H0 bit[8..0]: ingress::ig_intr_md.ingress_port
        16..17: TH7  # ingress::hdr.eth.dst[47:32].32-47
        18..21: TW5  # ingress::hdr.eth.dst[31:0].0-31
        22..23: TH6  # ingress::hdr.eth.src[47:32].32-47
        24..27: TW4  # ingress::hdr.eth.src[31:0].0-31
        28..29: H2  # ingress::hdr.eth.etype
        B2: 1  # value 1 -> B2 bit[0]: ingress::hdr.eth.$valid
        shift: 30
        buf_req: 30
        next: end
deparser ingress:
  dictionary:
    TH7: B2(0)  # ingress::hdr.eth.dst.32-47 if ingress::hdr.eth.$valid
    TW5: B2(0)  # ingress::hdr.eth.dst.0-31 if ingress::hdr.eth.$valid
    TH6: B2(0)  # ingress::hdr.eth.src.32-47 if ingress::hdr.eth.$valid
    TW4: B2(0)  # ingress::hdr.eth.src.0-31 if ingress::hdr.eth.$valid
    H2: B2(0)  # ingress::hdr.eth.etype if ingress::hdr.eth.$valid
  egress_unicast_port: H1(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  bypss_egr: B1(0..0)  # bit[0]: ingress::ig_intr_md_for_tm.bypass_egress
  mirror:
    select: B0(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H0(0..9)  # bit[9..0]: ingress::$tmp2
