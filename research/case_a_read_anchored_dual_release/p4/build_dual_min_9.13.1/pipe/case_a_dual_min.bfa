    - { name : hdr.min_parse_depth_padding_0$1.$valid, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.min_parse_depth_padding_0$2.$valid, live_start : deparser, live_end : deparser, mutually_exclusive_with: [  ] }
    H16:
    - { name : eg_intr_md.egress_port, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
parser ingress:
  start: $init_match
  init_zero: [ B5, B6, H5, B7, H3, W4, W7, B8, W5, W6, W1, W2, W8, B9, B10, W9, W10, B11, H7, W12, B12, B13, B14, B15, H10, H12, H11, H4, H6, H1, B1, B0, B2, H2, B4 ]
  bitwise_or: [ B4 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        load: { half : 0..1 }
        buf_req: 2
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0b*******001000100:
        0..3: TW6  # bit[16..31] -> TW6 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W3  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        load: { byte1 : 16 }
        shift: 16
        buf_req: 17
        next: from_pgen
      0b*******000001000:
        0..3: TW6  # bit[16..31] -> TW6 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W3  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        B5: 1  # value 1 -> B5 bit[7..0]: ingress::meta.src_ok
        B6: 1  # value 1 -> B6 bit[7..0]: ingress::meta.dequeued
        load: { half : 28..29 }
        shift: 16
        buf_req: 30
        next: parse_eth
      0x****:
        0..3: TW6  # bit[16..31] -> TW6 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W3  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: end
    from_pgen:
      match: [ byte1 ]
      value_set IgParser.pgen_app 2:
        handle: 511
        field_mapping:
          pkt.lookahead(0..7) : byte1(0..7)
        0..3: W11  # bit[0..7] -> W11 bit[31..24]: ingress::hdr.pgen.pipe_app
        4..5: H9  # ingress::hdr.pgen.packet_id
        B5: 1  # value 1 -> B5 bit[7..0]: ingress::meta.src_ok
        H5: 256  # value 1 -> H5 bit[15..8]: ingress::meta.is_pgen
        load: { half : 18..19 }
        shift: 6
        buf_req: 20
        next: parse_eth
      0x**:
        buf_req: 0
        next: end
    parse_eth:
      match: [ half ]
      0x88c5:
        0..1: TH8  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW5  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH7  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW4  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH6  # ingress::hdr.eth.etype
        B4: 1  # value 1 -> B4 bit[0]: ingress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: parse_dual
      0x****:
        0..1: TH8  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW5  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH7  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW4  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH6  # ingress::hdr.eth.etype
        B4: 1  # value 1 -> B4 bit[0]: ingress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: end
    parse_dual:
      *:
        0: B3  # ingress::hdr.dl.role
        1..2: H8
            # - bit[8..15] -> H8 bit[15..8]: ingress::hdr.dl.phase
            # - bit[16..23] -> H8 bit[7..0]: ingress::hdr.dl.gen
        1..2: H3  # bit[16..23] -> H3 bit[7..0]: ingress::meta.my_gen
        3..6: W0  # ingress::hdr.dl.seq
        B4: 2  # value 1 -> B4 bit[1]: ingress::hdr.dl.$valid
        B7: 1  # value 1 -> B7 bit[7..0]: ingress::meta.is_dual
        shift: 7
        buf_req: 7
        next: end
deparser ingress:
  dictionary:
    TH8: B4(0)  # ingress::hdr.eth.dst.32-47 if ingress::hdr.eth.$valid
    TW5: B4(0)  # ingress::hdr.eth.dst.0-31 if ingress::hdr.eth.$valid
    TH7: B4(0)  # ingress::hdr.eth.src.32-47 if ingress::hdr.eth.$valid
    TW4: B4(0)  # ingress::hdr.eth.src.0-31 if ingress::hdr.eth.$valid
    TH6: B4(0)  # ingress::hdr.eth.etype if ingress::hdr.eth.$valid
    B3: B4(1)  # ingress::hdr.dl.role if ingress::hdr.dl.$valid
    H8: B4(1)
        # - bit[15..8]: ingress::hdr.dl.phase if ingress::hdr.dl.$valid
        # - bit[7..0]: ingress::hdr.dl.gen if ingress::hdr.dl.$valid
    W0: B4(1)  # ingress::hdr.dl.seq if ingress::hdr.dl.$valid
  egress_unicast_port: H0(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  qid: B1(0..4)  # bit[4..0]: ingress::ig_intr_md_for_tm.qid
  bypss_egr: B2(0..0)  # bit[0]: ingress::ig_intr_md_for_tm.bypass_egress
  drop_ctl: B1(5..7)  # bit[7..5]: ingress::ig_intr_md_for_dprsr.drop_ctl
  mirror:
    select: B0(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H2(0..9)  # bit[9..0]: ingress::$tmp2
    1:
      - H1(0..9)  # bit[9..0]: ingress::meta.clone_ses
      - H6  # ingress::meta.clone_tag.16-31
      - H4  # ingress::meta.clone_tag.0-15
parser egress:
  start: $entry_point.start.min_parse_depth_accept_initial
  init_zero: [ B16 ]
  bitwise_or: [ B16 ]
  hdr_len_adj: 27
  meta_opt: 8191
  states:
    $entry_point.start.min_parse_depth_accept_initial:
      *:
        counter:
          imm: 38
        0..1: H16  # bit[7..15] -> H16 bit[8..0]: egress::eg_intr_md.egress_port
        intr_md: 9
        shift: 27
        buf_req: 27
        next: $entry_point.start.min_parse_depth_accept_initial.$ctr_stall0
    $entry_point.start.min_parse_depth_accept_initial.$ctr_stall0:
      *:
        buf_req: 0
        next: $entry_point.start.min_parse_depth_accept_initial.$split_0
    $entry_point.start.min_parse_depth_accept_initial.$split_0:
      match: [ ctr_neg, ctr_zero ]
      0x0:
        counter: dec 11
        0: TB0  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[87:80].80-87
        1..2: TH12  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[79:64].64-79
        3..6: TW1  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[63:32].32-63
        7..10: TW0  # egress::hdr.min_parse_depth_padding_0[0].packet_payload[31:0].0-31
        B16: 8  # value 8 -> B16 bit[3..0]: egress::hdr.min_parse_depth_padding_0.$stkvalid
        shift: 11
        buf_req: 11
        next: min_parse_depth_accept_loop.$split_0
      0b**:
        buf_req: 0
        next: end
    min_parse_depth_accept_loop.$split_0:
      match: [ ctr_neg, ctr_zero ]
      0x0:
        counter: dec 11
        0: TB1  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[87:80].80-87
        1..2: TH13  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[79:64].64-79
        3..6: TW3  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[63:32].32-63
        7..10: TW2  # egress::hdr.min_parse_depth_padding_0[1].packet_payload[31:0].0-31
        B16: 4  # value 4 -> B16 bit[3..0]: egress::hdr.min_parse_depth_padding_0.$stkvalid
        shift: 11
        buf_req: 11
        next: min_parse_depth_accept_loop.$it1.$split_0
      0b**:
        buf_req: 0
        next: end
    min_parse_depth_accept_loop.$it1.$split_0:
      match: [ ctr_neg, ctr_zero ]
      0x0:
        counter: dec 11
        0: TB2  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[87:80].80-87
        1..2: TH14  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[79:64].64-79
        3..4: TH3  # egress::hdr.min_parse_depth_padding_0[2].packet_payload[63:48].48-63
