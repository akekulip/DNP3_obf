stage 0 ingress:
  phase0_match IgParser.$PORT_METADATA:
    p4:
      name: IgParser.$PORT_METADATA
      size: 288
      preferred_match_type: exact
      match_type: exact
    size: 288
    p4_param_order:
      ig_intr_md.ingress_port: { type: exact, size: 9 }
    format: {ig_intr_md: 0..63}
    constant_value: 0
    actions:
      set_port_metadata:
      - handle: 0x20000000
      - p4_param_order: { ig_intr_md: 64 } 
  ternary_match tbl_drop_pkt 0:
    p4: { name: tbl_drop_pkt, hidden: true }
    gateway:
      name: cond-10
      input_xbar:
        exact group 0: { 0: meta.src_ok }
      row: 0
      bus: 1
      unit: 1
      match: { 0: meta.src_ok }
      0x00:
        run_table: true
      miss:
        next:  tbl_drop_pkt_0
