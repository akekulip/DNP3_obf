parser ingress:
  start: $init_match
  init_zero: [ B5, B6, H1, B7, H4, B8, W2, B9, W5, W3, W4, W6, B10, H6, W7, W8, B11, W10, B12, B13, B14, B15, H11, H8, B4, H13, H12, H5, H7, H2, B1, B0, B2, H3, H10 ]
  bitwise_or: [ H10 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        load: { half : 0..1 }
        buf_req: 2
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0b*******000001000:
        0..3: TW14  # bit[16..31] -> TW14 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W1  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: from_loopback
      0b*******000001011:
        0..3: TW14  # bit[16..31] -> TW14 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W1  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: from_outstation
      0b*******001000000:
        0..3: TW14  # bit[16..31] -> TW14 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W1  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: from_outstation
      0b*******000001001:
        0..3: TW14  # bit[16..31] -> TW14 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W1  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        H1: 64  # value 64 -> H1 bit[8..0]: ingress::meta.fwd_port
        B7: 1  # value 1 -> B7 bit[7..0]: ingress::meta.port_ok
        load: { half : 28..29 }
        shift: 16
        buf_req: 30
        next: parse_eth
      0b*******001000100:
        0..3: TW14  # bit[16..31] -> TW14 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W1  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        load: { byte1 : 16 }
        shift: 16
        buf_req: 17
        next: from_pgen
      0x****:
        0..3: TW14  # bit[16..31] -> TW14 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W1  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: end
    from_loopback:
      *:
        B8: 1  # value 1 -> B8 bit[7..0]: ingress::meta.dequeued
        B6: 1  # value 1 -> B6 bit[7..0]: ingress::meta.dir
        H1: 9  # value 9 -> H1 bit[8..0]: ingress::meta.fwd_port
        B7: 1  # value 1 -> B7 bit[7..0]: ingress::meta.port_ok
        load: { half : 12..13 }
        buf_req: 14
        next: parse_eth
    parse_eth:
      match: [ half ]
      0x88c1:
        0..1: TH21  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW10  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH20  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW9  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH19  # ingress::hdr.eth.etype
        H10: 1  # value 1 -> H10 bit[0]: ingress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: parse_token
      0x0800:
        0..1: TH21  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW10  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH20  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW9  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH19  # ingress::hdr.eth.etype
        H10: 1  # value 1 -> H10 bit[0]: ingress::hdr.eth.$valid
        load: { byte1 : 14, byte0 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x****:
        0..1: TH21  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW10  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH20  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW9  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH19  # ingress::hdr.eth.etype
        H10: 1  # value 1 -> H10 bit[0]: ingress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: end
    parse_token:
      *:
        0: B3  # ingress::hdr.ib.role
        1..2: H9
            # - bit[8..15] -> H9 bit[15..8]: ingress::hdr.ib.slot
            # - bit[16..23] -> H9 bit[7..0]: ingress::hdr.ib.gen
        1..2: H4  # bit[16..23] -> H4 bit[7..0]: ingress::meta.gen_in
        3..6: W0  # ingress::hdr.ib.seq
        H10: 2  # value 1 -> H10 bit[1]: ingress::hdr.ib.$valid
        B5: 1  # value 1 -> B5 bit[7..0]: ingress::meta.role
        shift: 7
        buf_req: 7
        next: end
    parse_ipv4:
      match: [ byte0, byte1 ]
      0x06*5:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
