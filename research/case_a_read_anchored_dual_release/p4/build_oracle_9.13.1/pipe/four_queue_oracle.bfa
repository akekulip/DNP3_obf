    B4:
    - { name : hdr.oracle.role, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B5:
    - { name : hdr.eth.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    - { name : hdr.oracle.$valid, live_start : parser, live_end : deparser, mutually_exclusive_with: [  ] }
    B6:
    - { name : meta.port_ok, live_start : parser, live_end : 0, mutually_exclusive_with: [  ] }
    B7:
    - { name : meta.dequeued, live_start : parser, live_end : 0, mutually_exclusive_with: [  ] }
