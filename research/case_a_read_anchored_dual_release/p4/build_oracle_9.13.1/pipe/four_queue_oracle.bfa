  hdr.eth.dst.32-47: TH8
  hdr.eth.src.0-31: TW5
  hdr.eth.src.32-47: TH7
  hdr.eth.etype: TH6
  hdr.oracle.trial_id: TH9
  hdr.oracle.role: B4
  hdr.oracle.per_role_seq: TW4(16..31)
  hdr.oracle.global_inj_seq: TW4(0..15)
  hdr.oracle.pass: B3
  ig_intr_md_for_dprsr.drop_ctl: {  stage 1..12: B1(5..7) } 
  ig_intr_md_for_dprsr.mirror_type: {  stage 12: B0(0..2) } 
  ig_intr_md_for_tm.ucast_egress_port: {  stage 1..12: H0(0..8) } 
  ig_intr_md_for_tm.bypass_egress: {  stage 1..12: B2(0) } 
  ig_intr_md_for_tm.qid: {  stage 1..12: B1(0..4) } 
