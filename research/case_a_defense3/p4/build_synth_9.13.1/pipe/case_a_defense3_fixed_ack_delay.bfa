  hdr.min_parse_depth_padding_0$2.packet_payload.0-15: TH10
  hdr.min_parse_depth_padding_0$2.packet_payload.16-31: TH11
  hdr.min_parse_depth_padding_0$2.packet_payload.32-63: TW12
  hdr.min_parse_depth_padding_0$2.packet_payload.64-79: TH23
