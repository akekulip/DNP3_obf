parser ingress:
  start: $init_match
  init_zero: [ B10, B11, H1, B12, B4, B13, W5, B14, W7, W6, W2, W1, B15, W12, W13, W36, W8, H7, B9, W3, H9, H10, W37, W9, B7, H8, B5, H4, B6, H2, B1, B0, B2, H3, H6 ]
  bitwise_or: [ H6 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        load: { half : 0..1 }
        buf_req: 2
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0b*******000001000:
        2: TB2  # ingress::ig_intr_md.ingress_mac_tstamp[47:40].40-47
        3: TB1  # ingress::ig_intr_md.ingress_mac_tstamp[39:32].32-39
        4..7: W4  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: from_loopback
      0b*******001000000:
        2: TB2  # ingress::ig_intr_md.ingress_mac_tstamp[47:40].40-47
        3: TB1  # ingress::ig_intr_md.ingress_mac_tstamp[39:32].32-39
        4..7: W4  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: from_relay
      0b*******000001011:
        2: TB2  # ingress::ig_intr_md.ingress_mac_tstamp[47:40].40-47
        3: TB1  # ingress::ig_intr_md.ingress_mac_tstamp[39:32].32-39
        4..7: W4  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: from_outstation
      0b*******000001001:
        2: TB2  # ingress::ig_intr_md.ingress_mac_tstamp[47:40].40-47
        3: TB1  # ingress::ig_intr_md.ingress_mac_tstamp[39:32].32-39
        4..7: W4  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        H1: 64  # value 64 -> H1 bit[8..0]: ingress::meta.fwd_port
        B12: 1  # value 1 -> B12 bit[7..0]: ingress::meta.port_ok
        load: { half : 28..29 }
        shift: 16
        buf_req: 30
        next: parse_eth
      0b*******001000100:
        2: TB2  # ingress::ig_intr_md.ingress_mac_tstamp[47:40].40-47
        3: TB1  # ingress::ig_intr_md.ingress_mac_tstamp[39:32].32-39
        4..7: W4  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        load: { byte1 : 16 }
        shift: 16
        buf_req: 17
        next: from_pgen
      0x****:
        2: TB2  # ingress::ig_intr_md.ingress_mac_tstamp[47:40].40-47
        3: TB1  # ingress::ig_intr_md.ingress_mac_tstamp[39:32].32-39
        4..7: W4  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        shift: 16
        buf_req: 16
        next: end
    from_loopback:
      *:
        B13: 1  # value 1 -> B13 bit[7..0]: ingress::meta.dequeued
        B11: 1  # value 1 -> B11 bit[7..0]: ingress::meta.dir
        H1: 9  # value 9 -> H1 bit[8..0]: ingress::meta.fwd_port
        B12: 1  # value 1 -> B12 bit[7..0]: ingress::meta.port_ok
        load: { half : 12..13 }
        buf_req: 14
        next: parse_eth
    parse_eth:
      match: [ half ]
      0x88c1:
        0..1: TH16  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW9  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH15  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW8  # ingress::hdr.eth.src[31:0].0-31
        12..13: H5  # ingress::hdr.eth.etype
        H6: 1  # value 1 -> H6 bit[0]: ingress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: parse_token
      0x0800:
        0..1: TH16  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW9  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH15  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW8  # ingress::hdr.eth.src[31:0].0-31
        12..13: H5  # ingress::hdr.eth.etype
        H6: 1  # value 1 -> H6 bit[0]: ingress::hdr.eth.$valid
        load: { byte1 : 14, half : 20..21, byte0 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x88c6:
        0..1: TH16  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW9  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH15  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW8  # ingress::hdr.eth.src[31:0].0-31
        12..13: H5  # ingress::hdr.eth.etype
        H6: 1  # value 1 -> H6 bit[0]: ingress::hdr.eth.$valid
        B10: 7  # value 7 -> B10 bit[7..0]: ingress::meta.role
        shift: 14
        buf_req: 14
        next: end
      0x88c7:
