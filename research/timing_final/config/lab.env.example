# lab.env.example — configuration for the DNP3 timing-normalizer lab interface.
#
# Copy to config/lab.env and edit for your lab.  Every script and the Makefile
# read this file (via scripts/lib/common.sh).  Nothing here is a secret:
# credentials live in ~/.lab_env (SSHPASS) which every script sources separately
# and which is NEVER stored in the repo.
#
# All values below are the VERIFIED lab settings for the current testbed
# (2026-07-25).  Override only what changes.

# ---- credentials file (sourced for $SSHPASS; sshpass -e uses it) -----------
LAB_ENV_FILE="${HOME}/.lab_env"

# ---- SSH targets (user@host) ----------------------------------------------
SW="decps@10.10.54.81"        # Tofino switch (SDE 9.13.2, bfrt grpc localhost:50052)
VIS="decps@10.10.54.19"       # Vision  (master side,     dp9, dir0)
HULK="decps@10.10.54.158"     # Hulk    (outstation side, dp11, dir1)

# ---- management IPs (for reachability preflight) --------------------------
SW_IP="10.10.54.81"
VIS_IP="10.10.54.19"
HULK_IP="10.10.54.158"

# ---- Vision interfaces -----------------------------------------------------
# The relay-facing interface is AUTO-DETECTED at run time as the one holding
# VIS_RELAY_ADDR (directive §18); this value is only the detection target and a
# fallback.  The data-plane interface toward the switch (dp9) is where MODE A
# replay traffic is injected and captured — it is NOT auto-detected (it carries
# no distinguishing IP), so set it explicitly here.
VIS_RELAY_ADDR="192.168.10.1"      # Vision's address on the relay subnet
VIS_RELAY_IFACE=""                 # leave EMPTY to auto-detect; set to override
VIS_DATA_IFACE="enp59s0f0np0"      # dp9-facing NIC (MAC 3c:fd:fe:cc:5d:c0)

# ---- Hulk interface --------------------------------------------------------
HULK_DATA_IFACE="enp59s0f0np0"     # dp11-facing NIC

# ---- physical SEL-751 relay (MODE B live read-only only) ------------------
SEL_IP="192.168.10.7"
SEL_MAC="00:30:A7:02:4C:A2"
SEL_LINK_ADDR="0"                  # outstation DNP3 link address (NOT 10)
MASTER_LINK_ADDR="1"
DNP3_PORT="20000"

# ---- program under test ----------------------------------------------------
PROG="dnp3_timing_normalizer"
P4_SRC_SHA256="82f572ce63d05baf94cf1d7ba39c68195326531581a848d4b958edeace3eadb0"

# ---- switch dev-ports and Traffic-Manager queues --------------------------
DP_VISION="9"                      # master-side host port  (dir0)
DP_HULK="11"                       # outstation-side host port (dir1)
DP_LOOP="8"                        # dp8 MAC-near internal loopback
PG_L="2"                           # port group of the loopback port
PG_L_NR="0"                        # pg-relative number of the loopback port
QB="7"                             # Q_BLOCK qid (strict HIGH)
QH="1"                             # Q_RESP/Q_HOLD qid (strict LOW)

# ---- switch build/run environment -----------------------------------------
# LOCAL compiler (01_build.sh runs offline on the dev box):
LOCAL_BFP4C_BIN="/home/philip/bf-sde-9.13.1/install/bin"
# ON-SWITCH SDE (02_load / 03_configure_tm / status use bfrt on the switch):
SW_SDE="/home/decps/Downloads/bf-sde-9.13.2"
SW_GRPC="localhost:50052"

# ---- program load / restore (gated bf_switchd swap) -----------------------
# 02_load.sh stages the compiled artifact and (re)launches bf_switchd.  The
# exact launch command is provided by the lab (like launch_mb.sh); point
# SW_TIMING_LAUNCH at it.  Restore always goes back to the queue microbench.
SW_TIMING_DIR="/home/decps/timing_final"
SW_TIMING_LAUNCH="/home/decps/timing_final/launch_tn.sh"   # VERIFIED this session: loads dnp3_timing_normalizer via tn_abs.conf
SW_RESTORE_LAUNCH="/home/decps/queue_microbench/launch_mb.sh"  # VERIFIED restore path
SW_RESTORE_PROG="queue_microbench"

# ---- local harness paths (reused as-is, NEVER forked) ---------------------
# Relative to the repository root.
HARNESS_DIR="research/ibspg_dnp3_replay/harness"
REPLAY_DIR="research/ibspg_dnp3_replay"
REPLAY_SPEC="research/ibspg_dnp3_replay/replay_spec_sel751.json"
REPLAY_FRAMES="research/ibspg_dnp3_replay/replay_frames_sel751.json"
# Control-plane setup on the switch (staged by 03_configure_tm.py):
SW_STAGE_DIR="/home/decps/timing_final_cp"
# Injector staging on Vision + Hulk (05/06 push p13_inject.py + the per-trial plan):
HOST_STAGE_DIR="/home/decps/timing_final"
# p13 harness helpers staged onto the switch for counter reads (05/06):
SW_READ_DIR="/home/decps/timing_final_cp"

# ---- experiment defaults ---------------------------------------------------
K="64"                             # blocker reservoir depth (C4: must be >= 64)
G_MS="25"                          # guard interval G in ms (must exceed native p99)
BUDGET="2000000"                   # blocker pass budget
TRIALS="10"                        # NTXN transactions per demo run
TXN_PERIOD_MS="250"
TOK_LEAD_MS="20"
ACK_LEAD_MS="70"
RESP_DELAY_MS="2"
START_LEAD_S="4"
TAIL_MS="1500"
TOL_MS="5"                         # CLRT-vs-G tolerance
TSHARK_TOL_US="50"                 # W3: in-house vs tshark median disagreement gate

# ---- output locations ------------------------------------------------------
EVID_DIR="research/timing_final/evidence/timing_final"
LOG_DIR="research/timing_final/logs"

# ---- python ----------------------------------------------------------------
RESEARCH_PYTHON="${HOME}/.venvs/research/bin/python"   # for 10_generate_figures.py
