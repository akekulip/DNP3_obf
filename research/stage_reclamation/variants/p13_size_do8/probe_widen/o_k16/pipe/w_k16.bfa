stage 0 egress:
  exact_match size_norm_0 7:
    p4: { name: Egress.size_norm, size: 32 }
    p4_param_order: 
      hdr.ipv4.total_len: { type: exact, size: 16, full_size: 16 }
      eg_intr_md.pkt_length: { type: exact, size: 16, full_size: 16 }
    row: 7
    bus: 0
    column: [ 2, 3, 4, 5 ]
    stash: 
      row: [ 7 ]
      col: [ 2 ]
      unit: [ 0 ]
    ways:
      - { group: 0, index: 0..9, select: 40..51 & 0x0, rams: [[7, 2]] }
      - { group: 0, index: 10..19, select: 40..51 & 0x0, rams: [[7, 3]] }
      - { group: 0, index: 20..29, select: 40..51 & 0x0, rams: [[7, 4]] }
      - { group: 0, index: 30..39, select: 40..51 & 0x0, rams: [[7, 5]] }
    input_xbar:
      exact group 0: { 64: hdr.ipv4.total_len, 80: eg_intr_md.pkt_length }
      hash 1:
        0..7: random(hdr.ipv4.total_len(10..15), eg_intr_md.pkt_length) ^ hdr.ipv4.total_len(0..7)
