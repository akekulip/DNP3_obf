parser ingress:
  start: $init_match
  init_zero: [ B5, B6, H1, B7, B3, B8, W2, B9, W4, W3, W5, B10, B4, W6, B15, W7, B11, B12, B13, B14, B1, B0, B2, H2, H3 ]
  bitwise_or: [ H3 ]
  hdr_len_adj: 16
  states:
    $init_match:
      *:
        0..3: TW14  # bit[16..31] -> TW14 bit[15..0]: ingress::ig_intr_md.ingress_mac_tstamp[47:32].32-47
        4..7: W1  # ingress::ig_intr_md.ingress_mac_tstamp[31:0].0-31
        load: { half : 0..1 }
        shift: 16
        buf_req: 16
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0b*******000001000:
        B8: 1  # value 1 -> B8 bit[7..0]: ingress::meta.dequeued
        B6: 1  # value 1 -> B6 bit[7..0]: ingress::meta.dir
        H1: 9  # value 9 -> H1 bit[8..0]: ingress::meta.fwd_port
        B7: 1  # value 1 -> B7 bit[7..0]: ingress::meta.port_ok
        load: { half : 12..13 }
        buf_req: 14
        next: parse_eth
      0b*******000001011:
        B6: 1  # value 1 -> B6 bit[7..0]: ingress::meta.dir
        H1: 9  # value 9 -> H1 bit[8..0]: ingress::meta.fwd_port
        B7: 1  # value 1 -> B7 bit[7..0]: ingress::meta.port_ok
        load: { half : 12..13 }
        buf_req: 14
        next: parse_eth
      0b*******000001001:
        H1: 11  # value 11 -> H1 bit[8..0]: ingress::meta.fwd_port
        B7: 1  # value 1 -> B7 bit[7..0]: ingress::meta.port_ok
        load: { half : 12..13 }
        buf_req: 14
        next: parse_eth
      0x****:
        buf_req: 0
        next: end
    parse_eth:
      match: [ half ]
      0x88c1:
        0..1: TH21  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW10  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH20  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW9  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH19  # ingress::hdr.eth.etype
        H3: 1  # value 1 -> H3 bit[0]: ingress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: parse_token
      0x0800:
        0..1: TH21  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW10  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH20  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW9  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH19  # ingress::hdr.eth.etype
        H3: 1  # value 1 -> H3 bit[0]: ingress::hdr.eth.$valid
        load: { byte1 : 14, byte0 : 23 }
        shift: 14
        buf_req: 24
        next: parse_ipv4
      0x****:
        0..1: TH21  # ingress::hdr.eth.dst[47:32].32-47
        2..5: TW10  # ingress::hdr.eth.dst[31:0].0-31
        6..7: TH20  # ingress::hdr.eth.src[47:32].32-47
        8..11: TW9  # ingress::hdr.eth.src[31:0].0-31
        12..13: TH19  # ingress::hdr.eth.etype
        H3: 1  # value 1 -> H3 bit[0]: ingress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: end
    parse_token:
      *:
        0: TB0  # ingress::hdr.ib.role
        1..2: TH0
            # - bit[8..15] -> TH0 bit[15..8]: ingress::hdr.ib.slot
            # - bit[16..23] -> TH0 bit[7..0]: ingress::hdr.ib.gen
        2: B3  # ingress::meta.gen_in
        3..6: W0  # ingress::hdr.ib.seq
        H3: 2  # value 1 -> H3 bit[1]: ingress::hdr.ib.$valid
        B5: 1  # value 1 -> B5 bit[7..0]: ingress::meta.role
        shift: 7
        buf_req: 7
        next: end
    parse_ipv4:
      match: [ byte0, byte1 ]
      0x06*5:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..7: TW3
            # - bit[32..47] -> TW3 bit[31..16]: ingress::hdr.ipv4.identification
            # - bit[48..50] -> TW3 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TW3 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..11: TW2
            # - bit[64..71] -> TW2 bit[31..24]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TW2 bit[23..16]: ingress::hdr.ipv4.protocol
            # - bit[80..95] -> TW2 bit[15..0]: ingress::hdr.ipv4.hdr_checksum
        12..13: TH13  # ingress::hdr.ipv4.src_addr[31:16].16-31
        14..15: TH12  # ingress::hdr.ipv4.src_addr[15:0].0-15
        16..19: TW11  # ingress::hdr.ipv4.dst_addr
        H3: 4  # value 1 -> H3 bit[2]: ingress::hdr.ipv4.$valid
        load: { byte0 : 2, byte1 : 3 }
        shift: 20
        buf_req: 20
        next: parse_tcp
      0x****:
        0..3: TW0
            # - bit[0..3] -> TW0 bit[31..28]: ingress::hdr.ipv4.version
            # - bit[4..7] -> TW0 bit[27..24]: ingress::hdr.ipv4.ihl
            # - bit[8..15] -> TW0 bit[23..16]: ingress::hdr.ipv4.diffserv
            # - bit[16..31] -> TW0 bit[15..0]: ingress::hdr.ipv4.total_len
        4..7: TW3
            # - bit[32..47] -> TW3 bit[31..16]: ingress::hdr.ipv4.identification
            # - bit[48..50] -> TW3 bit[15..13]: ingress::hdr.ipv4.flags
            # - bit[51..63] -> TW3 bit[12..0]: ingress::hdr.ipv4.frag_offset
        8..11: TW2
            # - bit[64..71] -> TW2 bit[31..24]: ingress::hdr.ipv4.ttl
            # - bit[72..79] -> TW2 bit[23..16]: ingress::hdr.ipv4.protocol
            # - bit[80..95] -> TW2 bit[15..0]: ingress::hdr.ipv4.hdr_checksum
        12..13: TH13  # ingress::hdr.ipv4.src_addr[31:16].16-31
        14..15: TH12  # ingress::hdr.ipv4.src_addr[15:0].0-15
        16..19: TW11  # ingress::hdr.ipv4.dst_addr
        H3: 4  # value 1 -> H3 bit[2]: ingress::hdr.ipv4.$valid
        shift: 20
        buf_req: 20
        next: end
    parse_tcp:
      *:
        0..1: TH5  # ingress::hdr.tcp.src_port
        2..3: TH4  # ingress::hdr.tcp.dst_port
        4..5: TH17  # ingress::hdr.tcp.seq_no[31:16].16-31
        6..7: TH16  # ingress::hdr.tcp.seq_no[15:0].0-15
        12..15: TW1
            # - bit[96..99] -> TW1 bit[31..28]: ingress::hdr.tcp.data_offset
            # - bit[100..103] -> TW1 bit[27..24]: ingress::hdr.tcp.res
            # - bit[104..111] -> TW1 bit[23..16]: ingress::hdr.tcp.flags
            # - bit[112..127] -> TW1 bit[15..0]: ingress::hdr.tcp.window
        H3: 8  # value 1 -> H3 bit[3]: ingress::hdr.tcp.$valid
        load: { half : 12..13 }
        shift: 8
        buf_req: 16
        next: parse_tcp.$split_0
    parse_tcp.$split_0:
      match: [ half, byte0, byte1 ]
      0b0101*******1*0000000000000101000:
        0..1: TH15  # ingress::hdr.tcp.ack_no[31:16].16-31
        2..3: TH14  # ingress::hdr.tcp.ack_no[15:0].0-15
        8..9: TH3  # ingress::hdr.tcp.checksum
        10..11: TH2  # ingress::hdr.tcp.urgent_ptr
        B5: 7  # value 7 -> B5 bit[7..0]: ingress::meta.role
        shift: 12
        buf_req: 12
        next: end
      0b0110*******1*0000000000000101100:
        0..1: TH15  # ingress::hdr.tcp.ack_no[31:16].16-31
        2..3: TH14  # ingress::hdr.tcp.ack_no[15:0].0-15
        8..9: TH3  # ingress::hdr.tcp.checksum
        10..11: TH2  # ingress::hdr.tcp.urgent_ptr
        B5: 7  # value 7 -> B5 bit[7..0]: ingress::meta.role
        shift: 12
        buf_req: 12
        next: end
      0b0111*******1*0000000000000110000:
        0..1: TH15  # ingress::hdr.tcp.ack_no[31:16].16-31
        2..3: TH14  # ingress::hdr.tcp.ack_no[15:0].0-15
        8..9: TH3  # ingress::hdr.tcp.checksum
        10..11: TH2  # ingress::hdr.tcp.urgent_ptr
        B5: 7  # value 7 -> B5 bit[7..0]: ingress::meta.role
        shift: 12
        buf_req: 12
        next: end
      0b1000*******1*0000000000000110100:
        0..1: TH15  # ingress::hdr.tcp.ack_no[31:16].16-31
        2..3: TH14  # ingress::hdr.tcp.ack_no[15:0].0-15
        8..9: TH3  # ingress::hdr.tcp.checksum
        10..11: TH2  # ingress::hdr.tcp.urgent_ptr
        B5: 7  # value 7 -> B5 bit[7..0]: ingress::meta.role
        shift: 12
        buf_req: 12
        next: end
      0b1001*******1*0000000000000111000:
        0..1: TH15  # ingress::hdr.tcp.ack_no[31:16].16-31
        2..3: TH14  # ingress::hdr.tcp.ack_no[15:0].0-15
        8..9: TH3  # ingress::hdr.tcp.checksum
        10..11: TH2  # ingress::hdr.tcp.urgent_ptr
        B5: 7  # value 7 -> B5 bit[7..0]: ingress::meta.role
        shift: 12
        buf_req: 12
        next: end
      0b1010*******1*0000000000000111100:
        0..1: TH15  # ingress::hdr.tcp.ack_no[31:16].16-31
        2..3: TH14  # ingress::hdr.tcp.ack_no[15:0].0-15
        8..9: TH3  # ingress::hdr.tcp.checksum
        10..11: TH2  # ingress::hdr.tcp.urgent_ptr
        B5: 7  # value 7 -> B5 bit[7..0]: ingress::meta.role
        shift: 12
