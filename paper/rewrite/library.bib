@inproceedings{jasimINTERPRETABLEMACHINELEARNING,
  title = {{{INTERPRETABLE MACHINE LEARNING}}: {{BRIDGING THE GAP BETWEEN AI AND HUMAN UNDERSTANDING}}},
  shorttitle = {{{INTERPRETABLE MACHINE LEARNING}}},
  author = {Jasim, Khan and Asif, Mohammed},
  urldate = {2025-04-27},
  abstract = {Machine learning algorithms have demonstrated remarkable performance in various domains, yet their inherent complexity often poses challenges in understanding and trusting their decision-making processes. Interpretable machine learning aims to address this critical issue by developing models and techniques that enable human comprehension of AI systems. This paper explores the concept of interpretability in machine learning and investigates its importance in building trust, explaining model predictions, and ensuring fairness and accountability. The study begins by examining the current landscape of black-box machine learning models, which exhibit high predictive accuracy but lack transparency. It then delves into the methodologies and approaches that promote interpretability, including rule-based models, feature importance analysis, and surrogate models. Moreover, various visualization techniques are explored to enhance the human interpretability of complex models, such as decision trees, saliency maps, and attention mechanisms. The implications and benefits of interpretable machine learning are discussed across different domains, including healthcare, finance, and autonomous systems. In healthcare, for instance, interpretable models can provide transparent explanations for medical diagnoses, allowing healthcare professionals to make informed decisions and understand the underlying factors influencing the predictions. Similarly, in finance, interpretable machine learning enables risk assessments and fraud detection, while providing interpretable explanations to regulators and stakeholders. Furthermore, this paper explores the challenges and trade-offs associated with interpretability, such as the potential loss in predictive accuracy and the need to balance simplicity with complexity. Ethical considerations in interpretability are also discussed, emphasizing the importance of avoiding bias, discrimination, and unintended consequences when developing interpretable models.},
  file = {/home/philip/Zotero/storage/FAE7TWPY/Jasim and Asif - INTERPRETABLE MACHINE LEARNING BRIDGING THE GAP BETWEEN AI AND HUMAN UNDERSTANDING.pdf}
}

@misc{jeonPassiveFingerprintingSCADA2016,
