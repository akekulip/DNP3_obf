  shorttitle = {An {{Investigation}} of the {{Impact}} of {{Data Breach Severity}} on the {{Readability}} of {{Mandatory Data Breach Notification Letters}}},
  author = {Jackson, Stephen and Vanteeva, Nadia and Fearon, Colm},
