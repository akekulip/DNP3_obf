+
+// ===================================================================================
+// DECISIVE SBO response-side decoy-padding acceptance tests (added for the SBO-size
+// obfuscation study). Master selects ONLY real index 1; the echo is padded with
+// inert decoy CROBs at valid indices 2,3 (status SUCCESS). Two encodings:
+//   A) decoys in a SEPARATE trailing G12V1 object header  -> expected ACCEPT
+//   B) decoys MERGED into the real header (count grown)   -> expected REJECT
+// The decisive observable is whether the master emits the OPERATE after the padded
+// SELECT echo. No networking (MasterTestFixture drives the response bytes directly).
+// ===================================================================================
+
+// one echoed CROB object body (2-byte index prefix + 11-byte CROB), status = SUCCESS
+static const std::string kDecoy2 = "02 00 01 01 64 00 00 00 64 00 00 00 00";
+static const std::string kDecoy3 = "03 00 01 01 64 00 00 00 64 00 00 00 00";
+
+TEST_CASE(SUITE("SBO decoy padding via SEPARATE trailing header (encoding A) is ACCEPTED"))
+{
+    MasterTestFixture t(NoStartupTasks());
+    t.context->OnLowerLayerUp();
+
+    ControlRelayOutputBlock command(OperationType::PULSE_ON);
+    CommandCallbackQueue queue;
+    t.context->SelectAndOperate(CommandSet({WithIndex(command, 1)}), queue.Callback(), TaskConfig::Default());
+    t.exe->run_many();
+
+    // decoys as their OWN G12V1 header (count = 2, indices 2 and 3), appended AFTER the real header
+    const std::string decoyHeader = "0C 01 28 02 00 " + kDecoy2 + " " + kDecoy3;
+
+    REQUIRE(t.lower->PopWriteAsHex() == "C0 03 " + crob); // SELECT carries ONLY real index 1
+    t.context->OnTxReady();
+    t.SendToMaster("C0 81 00 00 " + crob + " " + decoyHeader); // padded SELECT echo
+    t.exe->run_many();
+
+    // DECISIVE: master accepted the padded SELECT and proceeded to OPERATE (real only)
+    REQUIRE(t.lower->PopWriteAsHex() == "C1 04 " + crob);
+    t.context->OnTxReady();
+    t.SendToMaster("C1 81 00 00 " + crob + " " + decoyHeader); // padded OPERATE echo
+    t.exe->run_many();
+
+    REQUIRE(t.lower->PopWriteAsHex().empty());
+    // the real point operated with SUCCESS despite the extra decoys
+    REQUIRE(queue.PopOnlyEqualValue(TaskCompletion::SUCCESS,
+                                    CommandPointResult(0, 1, CommandPointState::SUCCESS, CommandStatus::SUCCESS)));
+    std::cout << "SBO-DECOY[A] ACCEPT: master emitted OPERATE after decoy-padded SELECT echo; "
+                 "real index 1 -> SUCCESS\n";
+}
+
+TEST_CASE(SUITE("SBO decoy padding MERGED into the real header (encoding B) is REJECTED"))
+{
+    MasterTestFixture t(NoStartupTasks());
+    t.context->OnLowerLayerUp();
+
+    ControlRelayOutputBlock command(OperationType::PULSE_ON);
+    CommandCallbackQueue queue;
+    t.context->SelectAndOperate(CommandSet({WithIndex(command, 1)}), queue.Callback(), TaskConfig::Default());
+    t.exe->run_many();
+
+    // ONE grown G12V1 header, count = 3, real index 1 + decoys 2,3 in the same header
+    const std::string mergedHeader =
+        "0C 01 28 03 00 01 00 01 01 64 00 00 00 64 00 00 00 00 " + kDecoy2 + " " + kDecoy3;
+
+    REQUIRE(t.lower->PopWriteAsHex() == "C0 03 " + crob); // SELECT carries ONLY real index 1
+    t.context->OnTxReady();
+    t.SendToMaster("C0 81 00 00 " + mergedHeader); // padded SELECT echo (count=3)
+    t.exe->run_many();
+
+    // DECISIVE: master did NOT proceed to OPERATE -> the SELECT echo was rejected
+    REQUIRE(t.lower->PopWriteAsHex().empty());
+
+    // report the exact reject semantics; the real point must NOT be in SUCCESS
+    REQUIRE(queue.values.size() == 1);
+    const auto& v = queue.values.front();
+    REQUIRE(v.results.size() == 1);
+    const auto st = v.results.front().state;
+    std::cout << "SBO-DECOY[B] REJECT: no OPERATE emitted; real index 1 state="
+              << CommandPointStateSpec::to_human_string(st)
+              << " summary=" << static_cast<int>(v.summary) << "\n";
+    REQUIRE(st != CommandPointState::SUCCESS);
+}
