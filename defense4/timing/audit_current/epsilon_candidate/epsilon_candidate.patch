--- a/defense4_rrc_bor_unified12.p4
+++ b/defense4_rrc_bor_unified12.p4
@@ -2000,6 +2000,40 @@
      *   RESOLVING CHECK: (reg_ts_ack_release - reg_ts_ack_arm) mod 2^32 must centre
      *   on D + 1.711 us, not on D, with a spread of order tens of ns. If the spread
      *   is microseconds, the reservoir is not the thing gating the release. */
+    /* ==================== EPSILON CANDIDATE, 2026-09-15 ==========================
+     * Per-lane instrumentation for the post-deadline blocking interval. Index 0 is the ACK
+     * lane (qid7 blockers over the held ACK) and index 1 the RESPONSE lane (qid5 over qid4).
+     * The two share dp8 and one priority scheduler, which is why a port counter cannot
+     * separate them and these must be indexed rather than single-slot.
+     *
+     * No new comparison is introduced: meta.expired and meta.expired_resp already mark the
+     * two lanes' expiry, so this is two stateful writes on predicates that exist.
+     *
+     *   reg_ep_expiry_first[slot]  write-if-zero: the FIRST token to see its deadline passed
+     *   reg_ep_block_last[slot]    write-always:  the LAST blocking action before it stops
+     *   reg_ep_valid[slot]         set when both were written inside one generation
+     *
+     * epsilon = reg_ep_block_last - deadline; detection = reg_ep_expiry_first - deadline.
+     * Subtraction is modular on bit<32> ns and a result above the half-range means the clock
+     * wrapped and the sample must be discarded, not reported as an elapsed time.
+     *
+     * UNCOMPILED. bf-p4c lives only on the switch. The program already fills all twelve
+     * ingress stages, so these three registers and their SALUs may not fit; that is the
+     * expected failure and it is a compile-time one.
+     * ============================================================================ */
+    Register<bit<32>, bit<1>>(2, 0) reg_ep_expiry_first;
+    RegisterAction<bit<32>, bit<1>, bit<32>>(reg_ep_expiry_first) ep_expiry_first_w = {
+        void apply(inout bit<32> v) { if (v == 32w0) { v = meta.ts32; } }
+    };
+    Register<bit<32>, bit<1>>(2, 0) reg_ep_block_last;
+    RegisterAction<bit<32>, bit<1>, bit<32>>(reg_ep_block_last) ep_block_last_w = {
+        void apply(inout bit<32> v) { v = meta.ts32; }
+    };
+    Register<bit<8>, bit<1>>(2, 0) reg_ep_valid;
+    RegisterAction<bit<8>, bit<1>, bit<8>>(reg_ep_valid) ep_valid_w = {
+        void apply(inout bit<8> v) { v = 8w1; }
+    };
+
     Register<bit<32>, bit<1>>(1, 0) reg_ts_first_block;
     RegisterAction<bit<32>, bit<1>, bit<32>>(reg_ts_first_block) ts_first_block_w = {
         void apply(inout bit<32> v) { if (v == 32w0) { v = meta.ts32; } }
@@ -2756,7 +2790,15 @@
      * never does (it takes deadline_arm_once, which returns dl_pre into a different
      * field and leaves meta.age at its parser value), and the RESPONSE ADMISSION path
      * never does — see the ACT block. */
-    action mark_expired()     { meta.expired = 8w1; }
+    /* EPSILON CANDIDATE: the ACK lane's three writes ride the existing expiry action, so no
+     * new predicate is introduced. The index is the constant 1w0 because this action IS the
+     * ACK lane, which also avoids narrowing hdr.ibspg.slot at runtime. */
+    action mark_expired() {
+        meta.expired = 8w1;
+        ep_expiry_first_w.execute(1w0);
+        ep_block_last_w.execute(1w0);
+        ep_valid_w.execute(1w0);
+    }
     action mark_not_expired() { meta.expired = 8w0; }
     table tbl_deadline_expiry {
         key = { meta.age : ternary; }
@@ -2768,7 +2810,14 @@
         size = 2;
     }
     /* Defense 4: RESPONSE-deadline expiry, symmetric (age_resp sign-bit, same mask). */
-    action mark_expired_resp()     { meta.expired_resp = 8w1; }
+    /* EPSILON CANDIDATE: the RESPONSE lane, index 1w1. Separate from the ACK lane above
+     * because the two share dp8 and one scheduler and must not be summed. */
+    action mark_expired_resp() {
+        meta.expired_resp = 8w1;
+        ep_expiry_first_w.execute(1w1);
+        ep_block_last_w.execute(1w1);
+        ep_valid_w.execute(1w1);
+    }
     action mark_not_expired_resp() { meta.expired_resp = 8w0; }
     table tbl_tresp_expiry {
         key = { meta.age_resp : ternary; }
