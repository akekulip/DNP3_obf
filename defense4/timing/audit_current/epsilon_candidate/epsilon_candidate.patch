--- a/defense4_rrc_bor_unified12.p4
+++ b/defense4_rrc_bor_unified12.p4
@@ -2000,6 +2000,45 @@
      *   RESOLVING CHECK: (reg_ts_ack_release - reg_ts_ack_arm) mod 2^32 must centre
      *   on D + 1.711 us, not on D, with a spread of order tens of ns. If the spread
      *   is microseconds, the reservoir is not the thing gating the release. */
+    /* ============ EPSILON CANDIDATE v2, 2026-09-15 ==============================
+     * Post-deadline blocking interval, per lane. Index 0 is the ACK lane (qid7 blockers over
+     * the held ACK) and index 1 the RESPONSE lane (qid5 over qid4). The two share dp8 and one
+     * priority scheduler, so a port counter sums them and they must be indexed.
+     *
+     * v1 drove these from meta.expired / meta.expired_resp and both lanes were wrong. The
+     * run of 2026-09-15 showed why, and v2 is built from that:
+     *
+     *   - the RESPONSE lane's first-expiry fired about 24 ms BEFORE its own deadline, that is
+     *     D_A + CLRT_new early, because blockers circulating before reg_tresp is armed
+     *     evaluate age_resp against a stale value, mark themselves expired and take the
+     *     write-if-zero slot;
+     *   - the ACK lane's last write landed within 26 ns of reg_tresp rather than at the end of
+     *     blocking, because the expired FLAG stays set for the whole life of the transaction.
+     *
+     * v2 keys on the OUTCOME instead of on the flag. OUT_AB_DL and OUT_RB_DL are
+     * CD_BLOCK_TERM_DL, a blocker token terminating BECAUSE its deadline passed, which is
+     * exactly the event of interest. Stale tokens take OUT_AB_STALE / OUT_RB_STALE and timed
+     * out ones OUT_AB_TMO / OUT_RB_TMO, so both are excluded by construction rather than by a
+     * generation test written here.
+     *
+     *   reg_ep_expiry_first[slot]  write-if-zero -> the FIRST blocker terminated by deadline
+     *   reg_ep_block_last[slot]    write-always  -> the LAST blocker terminated by deadline
+     *
+     * detection = expiry_first - deadline; epsilon = block_last - deadline, both modular on
+     * bit<32> ns, a result above the half-range meaning the clock wrapped.
+     *
+     * One register per table: bf-p4c rejects two on one table because both need the meter
+     * address hardware. Validity is derived from both words being non-zero.
+     * ============================================================================ */
+    Register<bit<32>, bit<1>>(2, 0) reg_ep_expiry_first;
+    RegisterAction<bit<32>, bit<1>, bit<32>>(reg_ep_expiry_first) ep_expiry_first_w = {
+        void apply(inout bit<32> v) { if (v == 32w0) { v = meta.ts32; } }
+    };
+    Register<bit<32>, bit<1>>(2, 0) reg_ep_block_last;
+    RegisterAction<bit<32>, bit<1>, bit<32>>(reg_ep_block_last) ep_block_last_w = {
+        void apply(inout bit<32> v) { v = meta.ts32; }
+    };
+
     Register<bit<32>, bit<1>>(1, 0) reg_ts_first_block;
     RegisterAction<bit<32>, bit<1>, bit<32>>(reg_ts_first_block) ts_first_block_w = {
         void apply(inout bit<32> v) { if (v == 32w0) { v = meta.ts32; } }
@@ -2286,6 +2325,36 @@
      * belt-and-suspenders that keeps the control channel up rather than blackholing a
      * hypothetical unclassified frame. The unified setup READS THESE BACK and asserts the
      * mapping (it installs nothing here — const entries need no install). */
+    /* EPSILON CANDIDATE v2: two tables, one register each, both keyed on the outcome the
+     * decide stage has already chosen. AB_DL and RB_DL are the deadline-driven blocker
+     * terminations; STALE and TMO terminations are deliberately absent. */
+    action ep_first_ack()  { ep_expiry_first_w.execute(1w0); }
+    action ep_first_resp() { ep_expiry_first_w.execute(1w1); }
+    action ep_first_noop() { }
+    table tbl_ep_expiry_first {
+        key = { meta.outcome : exact; }
+        actions = { ep_first_ack; ep_first_resp; ep_first_noop; }
+        const default_action = ep_first_noop();
+        const entries = {
+            (OUT_AB_DL) : ep_first_ack();
+            (OUT_RB_DL) : ep_first_resp();
+        }
+        size = 4;
+    }
+    action ep_last_ack()  { ep_block_last_w.execute(1w0); }
+    action ep_last_resp() { ep_block_last_w.execute(1w1); }
+    action ep_last_noop() { }
+    table tbl_ep_block_last {
+        key = { meta.outcome : exact; }
+        actions = { ep_last_ack; ep_last_resp; ep_last_noop; }
+        const default_action = ep_last_noop();
+        const entries = {
+            (OUT_AB_DL) : ep_last_ack();
+            (OUT_RB_DL) : ep_last_resp();
+        }
+        size = 4;
+    }
+
     table tbl_commit {
         key     = { meta.outcome : exact; }
         actions = { cmt_drop; cmt_fwd; cmt_fwd_clone; cmt_shape;
@@ -3287,6 +3356,10 @@
         /* ►► UNIFIED12 change 2: the ONE terminal commit. Both the port_ok==0 drop and
          * every ACT-block leaf reach here having set meta.outcome and nothing else; this
          * single table performs the TM write and the (DirectCounter) count for all of them. */
+        /* EPSILON CANDIDATE v2: both writes take the outcome the decide stage chose, so they
+         * see the same classification tbl_commit acts on. */
+        tbl_ep_expiry_first.apply();
+        tbl_ep_block_last.apply();
         tbl_commit.apply();
     }
 }
