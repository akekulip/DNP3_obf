header byte_h{bit<8> data;}
header fragment_h{bit<32> offset;bit<16> length;bit<32> arrival;bit<8> hops;bit<8> phase;bit<16> reserved;}
header words_h{bit<8> mask0;bit<8> data0_0;bit<8> data0_1;bit<8> data0_2;bit<8> mask1;bit<8> data1_0;bit<8> data1_1;bit<8> data1_2;bit<8> mask2;bit<8> data2_0;bit<8> data2_1;bit<8> data2_2;bit<8> mask3;bit<8> data3_0;bit<8> data3_1;bit<8> data3_2;bit<8> mask4;bit<8> data4_0;bit<8> data4_1;bit<8> data4_2;bit<8> mask5;bit<8> data5_0;bit<8> data5_1;bit<8> data5_2;bit<8> mask6;bit<8> data6_0;bit<8> data6_1;bit<8> data6_2;bit<8> mask7;bit<8> data7_0;bit<8> data7_1;bit<8> data7_2;bit<8> mask8;bit<8> data8_0;bit<8> data8_1;bit<8> data8_2;bit<8> mask9;bit<8> data9_0;bit<8> data9_1;bit<8> data9_2;bit<8> mask10;bit<8> data10_0;bit<8> data10_1;bit<8> data10_2;bit<8> mask11;bit<8> data11_0;bit<8> data11_1;bit<8> data11_2;}
struct bucket_t{bit<32> generation;bit<32> encoded;}
header frame_h{bit<8> b0;bit<8> b1;bit<8> b2;bit<8> b3;bit<8> b4;bit<8> b5;bit<8> b6;bit<8> b7;bit<8> b8;bit<8> b9;bit<8> b10;bit<8> b11;bit<8> b12;bit<8> b13;bit<8> b14;bit<8> b15;bit<8> b16;bit<8> b17;bit<8> b18;bit<8> b19;bit<8> b20;bit<8> b21;bit<8> b22;bit<8> b23;bit<8> b24;bit<8> b25;bit<8> b26;bit<8> b27;bit<8> b28;bit<8> b29;bit<8> b30;bit<8> b31;bit<8> b32;bit<8> b33;bit<8> b34;}
struct origin_t{bit<32> generation;bit<32> observation;}
struct headers_t{eth_h eth;ip_h ip;tcp_h tcp;frame_h frame;ref_h ref;words_h expected;words_h candidate;fragment_h fragment;byte_h b0;byte_h b1;byte_h b2;byte_h b3;byte_h b4;byte_h b5;byte_h b6;byte_h b7;byte_h b8;byte_h b9;byte_h b10;byte_h b11;byte_h b12;byte_h b13;byte_h b14;byte_h b15;byte_h b16;byte_h b17;byte_h b18;byte_h b19;byte_h b20;byte_h b21;byte_h b22;byte_h b23;byte_h b24;byte_h b25;byte_h b26;byte_h b27;byte_h b28;byte_h b29;byte_h b30;byte_h b31;byte_h b32;byte_h b33;byte_h b34;}
struct meta_t{bit<8> byte_diff0_0;bit<8> byte_diff0_1;bit<8> byte_diff0_2;bit<8> byte_diff1_0;bit<8> byte_diff1_1;bit<8> byte_diff1_2;bit<8> byte_diff2_0;bit<8> byte_diff2_1;bit<8> byte_diff2_2;bit<8> byte_diff3_0;bit<8> byte_diff3_1;bit<8> byte_diff3_2;bit<8> byte_diff4_0;bit<8> byte_diff4_1;bit<8> byte_diff4_2;bit<8> byte_diff5_0;bit<8> byte_diff5_1;bit<8> byte_diff5_2;bit<8> byte_diff6_0;bit<8> byte_diff6_1;bit<8> byte_diff6_2;bit<8> byte_diff7_0;bit<8> byte_diff7_1;bit<8> byte_diff7_2;bit<8> byte_diff8_0;bit<8> byte_diff8_1;bit<8> byte_diff8_2;bit<8> byte_diff9_0;bit<8> byte_diff9_1;bit<8> byte_diff9_2;bit<8> byte_diff10_0;bit<8> byte_diff10_1;bit<8> byte_diff10_2;bit<8> byte_diff11_0;bit<8> byte_diff11_1;bit<8> byte_diff11_2;bit<32> full_length;bit<1> foreign;bit<32> sticky_fault;bit<16> tcp_length;bit<1> parsed;bit<1> private;bit<1> enabled;bool ip_error;bit<16> tcp_sum;bit<32> epoch;bit<32> native_start;bit<32> now;bit<32> observation;bit<32> age;bit<32> end;bit<1> bad_offset;bit<1> bad_end;bit<1> complete;bit<1> profile;bit<1> selected_match;bit<1> publish;bit<16> hcrc;bit<16> bcrc;bit<16> tcrc;bit<1> badh;bit<1> badb;bit<1> badt;bit<32> offset;bit<16> length;bit<1> fault;bit<32> incoming0;bit<32> present0;bit<32> oldmask0;bit<32> overlap0;bit<32> keep0;bit<32> newmask0;bit<32> diff0;bit<32> incoming1;bit<32> present1;bit<32> oldmask1;bit<32> overlap1;bit<32> keep1;bit<32> newmask1;bit<32> diff1;bit<32> incoming2;bit<32> present2;bit<32> oldmask2;bit<32> overlap2;bit<32> keep2;bit<32> newmask2;bit<32> diff2;bit<32> incoming3;bit<32> present3;bit<32> oldmask3;bit<32> overlap3;bit<32> keep3;bit<32> newmask3;bit<32> diff3;bit<32> incoming4;bit<32> present4;bit<32> oldmask4;bit<32> overlap4;bit<32> keep4;bit<32> newmask4;bit<32> diff4;bit<32> incoming5;bit<32> present5;bit<32> oldmask5;bit<32> overlap5;bit<32> keep5;bit<32> newmask5;bit<32> diff5;bit<32> incoming6;bit<32> present6;bit<32> oldmask6;bit<32> overlap6;bit<32> keep6;bit<32> newmask6;bit<32> diff6;bit