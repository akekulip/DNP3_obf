table response_profile{key={hdr.dl.magic:exact;hdr.dl.len:exact;hdr.dl.ctrl:exact;hdr.first.w0[31:24]:ternary;hdr.first.w0[23:16]:ternary;hdr.first.w0[15:0]:ternary;hdr.first.w1:exact;hdr.first.w2[31:16]:exact;hdr.rtail.status:exact;}
 actions={eligible;NoAction;}size=1;const default_action=NoAction();const entries={(16w0x0564,8w28,8w0x44,8w0xc0&&&8w0xc0,8w0xc0&&&8w0xf0,16w0x8100&&&16w0xff6f,32w0x000c0128,16w0x0100,8w0):eligible();}}
Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_first;
/* response-only: one table computes the link-header n_CRC (every DNP3 kind) and the first-block n_CRC (every
   kind that carries hdr.first). It replaces input_head_t, rd_head_t, input_body_t, response_crc0_t and
   rd_first_crc_t, which computed the same two CRCs over the same bits (input_body's byte slices
   concatenate to {w0,w1,w2,w3}). Fewer hash tables and crossbar bytes in N's stage 1, which pipe 0's
   egress response path also needs (evidence/route_ab_01/response_only_04). */
action crc_head(){m.hcrc=hash_head.get({hdr.dl.magic,hdr.dl.len,hdr.dl.ctrl,hdr.dl.dst,hdr.dl.src,hdr.dl.crc});}
action crc_head_first(){crc_head();m.bcrc=hash_first.get({hdr.first.w0,hdr.first.w1,hdr.first.w2,hdr.first.w3,hdr.first.crc});}
