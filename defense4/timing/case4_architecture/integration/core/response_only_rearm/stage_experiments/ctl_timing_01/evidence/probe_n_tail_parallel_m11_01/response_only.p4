            (32w0xffffffe5, 16w27 .. 16w65535) : rev_withhold_open();
            (32w0xffffffe4, 16w0 .. 16w27) : rev_withhold_zero();
            (32w0xffffffe4, 16w28 .. 16w65535) : rev_withhold_open();
            (32w0xffffffe3, 16w0 .. 16w28) : rev_withhold_zero();
            (32w0xffffffe3, 16w29 .. 16w65535) : rev_withhold_open();
            (32w0xffffffe2, 16w0 .. 16w29) : rev_withhold_zero();
            (32w0xffffffe2, 16w30 .. 16w65535) : rev_withhold_open();
            (32w0xffffffe1, 16w0 .. 16w30) : rev_withhold_zero();
            (32w0xffffffe1, 16w31 .. 16w65535) : rev_withhold_open();
            (32w0xffffffe0, 16w0 .. 16w31) : rev_withhold_zero();
            (32w0xffffffe0, 16w32 .. 16w65535) : rev_withhold_open();
            (32w0xffffffdf, 16w0 .. 16w32) : rev_withhold_zero();
            (32w0xffffffdf, 16w33 .. 16w65535) : rev_withhold_open();
            (32w0xffffffde, 16w0 .. 16w33) : rev_withhold_zero();
            (32w0xffffffde, 16w34 .. 16w65535) : rev_withhold_open();
            (32w0xffffffdd, 16w0 .. 16w34) : rev_withhold_zero();
            (32w0xffffffdd, 16w35 .. 16w65535) : rev_withhold_open();
            (32w0xffffffdc, 16w0 .. 16w35) : rev_withhold_zero();
            (32w0xffffffdc, 16w36 .. 16w65535) : rev_withhold_open();
            (32w0xffffffdb, 16w0 .. 16w36) : rev_withhold_zero();
            (32w0xffffffdb, 16w37 .. 16w65535) : rev_withhold_open();
            (32w0xffffffda, 16w0 .. 16w37) : rev_withhold_zero();
            (32w0xffffffda, 16w38 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd9, 16w0 .. 16w38) : rev_withhold_zero();
            (32w0xffffffd9, 16w39 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd8, 16w0 .. 16w39) : rev_withhold_zero();
            (32w0xffffffd8, 16w40 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd7, 16w0 .. 16w40) : rev_withhold_zero();
            (32w0xffffffd7, 16w41 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd6, 16w0 .. 16w41) : rev_withhold_zero();
            (32w0xffffffd6, 16w42 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd5, 16w0 .. 16w42) : rev_withhold_zero();
            (32w0xffffffd5, 16w43 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd4, 16w0 .. 16w43) : rev_withhold_zero();
            (32w0xffffffd4, 16w44 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd3, 16w0 .. 16w44) : rev_withhold_zero();
            (32w0xffffffd3, 16w45 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd2, 16w0 .. 16w45) : rev_withhold_zero();
            (32w0xffffffd2, 16w46 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd1, 16w0 .. 16w46) : rev_withhold_zero();
            (32w0xffffffd1, 16w47 .. 16w65535) : rev_withhold_open();
            (32w0xffffffd0, 16w0 .. 16w47) : rev_withhold_zero();
            (32w0xffffffd0, 16w48 .. 16w65535) : rev_withhold_open();
            (32w0xffffffcf, 16w0 .. 16w48) : rev_withhold_zero();
            (32w0xffffffcf, 16w49 .. 16w65535) : rev_withhold_open();
            (32w0xffffffce, 16w0 .. 16w49) : rev_withhold_zero();
            (32w0xffffffce, 16w50 .. 16w65535) : rev_withhold_open();
            (32w0xffffffcd, 16w0 .. 16w50) : rev_withhold_zero();
            (32w0xffffffcd, 16w51 .. 16w65535) : rev_withhold_open();
            (32w0xffffffcc, 16w0 .. 16w51) : rev_withhold_zero();
            (32w0xffffffcc, 16w52 .. 16w65535) : rev_withhold_open();
            (32w0xffffffcb, 16w0 .. 16w52) : rev_withhold_zero();
            (32w0xffffffcb, 16w53 .. 16w65535) : rev_withhold_open();
            (32w0xffffffca, 16w0 .. 16w53) : rev_withhold_zero();
            (32w0xffffffca, 16w54 .. 16w65535) : rev_withhold_open();
            (32w0xffffffc9, 16w0 .. 16w54) : rev_withhold_zero();
            (32w0xffffffc9, 16w55 .. 16w65535) : rev_withhold_open();
            (32w0xffffffc8, 16w0 .. 16w55) : rev_withhold_zero();
            (32w0xffffffc8, 16w56 .. 16w65535) : rev_withhold_open();
            (32w0xffffffc7, 16w0 .. 16w56) : rev_withhold_zero();
            (32w0xffffffc7, 16w57 .. 16w65535) : rev_withhold_open();
            (32w0xffffffc6, 16w0 .. 16w57) : rev_withhold_zero();
            (32w0xffffffc6, 16w58 .. 16w65535) : rev_withhold_open();
            (32w0xffffffc5, 16w0 .. 16w58) : rev_withhold_zero();
            (32w0xffffffc5, 16w59 .. 16w65535) : rev_withhold_open();
            (32w0xffffffc4, 16w0 .. 16w59) : rev_withhold_zero();
            (32w0xffffffc4, 16w60 .. 16w65535) : rev_withhold_open();
            (32w0xffffffc3, 16w0 .. 16w60) : rev_withhold_zero();
            (32w0xffffffc3, 16w61 .. 16w65535) : rev_withhold_open();
        }
    }

    Hash<bit<16>>(HashAlgorithm_t.IDENTITY) narrow_win;
    action window_exact() { hdr.tcp.window = narrow_win.get({m.s_end[15:0]}); }
    action window_clamp() { hdr.tcp.window = 0xffff; }
    table window_t {
        key = { m.s_end : ternary; }
        actions = { window_exact; window_clamp; } size = 2; const default_action = window_clamp();
        const entries = { 32w0 &&& 32w0xFFFF0000 : window_exact(); 32w0 &&& 32w0 : window_clamp(); }
    }

    /* ============ outcome bookkeeping ============
       count_t r_is observability only. settle_t r_is NOT: it drops untranslatable shapes on mapped connections
       (drop_odd) and gives m.result its value on paths no classifier writes. */
    Counter<bit<32>, bit<8>>(32, CounterType_t.PACKETS) outcome;
    action count() { outcome.count(m.result); }
    table count_t { actions = { count; } size = 1; const default_action = count(); }
    action drop_odd() { m.result = r_OUT_DROP_ODD; md.drop_ctl = 3w1; }
    action native() { m.result = r_OUT_NATIVE; }
    action armed_map() { m.result = r_OUT_ARM_MAP; }
    action armed_nat() { m.result = r_OUT_ARM_NAT; }
    table settle_t {
        key = { m.dir : ternary; m.shape : ternary; m.mode : ternary; }
        actions = { drop_odd; native; armed_map; armed_nat; NoAction; } size = 8; const default_action = NoAction();
        const entries = {(0, _, _): NoAction();(1, (bit<3>)r_SH_SYNACK_OK, _): armed_map();(1, (bit<3>)r_SH_SYN, _): armed_nat();(_, (bit<3>)r_SH_ODD, 1): drop_odd();(_, _, 0): native();}
    }

    apply {
        /* stage 0 */
        conn.apply();
        normalization_ack_t.apply(); prepare_open_t.apply();
        shape_t.apply();
        lifecycle_access.apply();
        leff_t.apply(); prep_t.apply();
        if (hdr.dl.isValid()) { in_dl_t.apply(); }
        if (hdr.rh.isValid()) { read_profile.apply(); in_rb0_t.apply(); in_rb1_t.apply(); in_rt_t.apply(); crc_read_tail_t.apply(); crc_read_b_t.apply(); }
        if (hdr.cb0.isValid()) { ctl_profile.apply(); in_cb0_t.apply(); in_ct_t.apply(); ctl_sequences_t.apply(); crc_ctl_tail2_t.apply(); crc_ctl_tail3_t.apply(); }
        if ((bit<8>)m.dir != 0 && hdr.tcp.isValid()) {
            if (m.life_bad == 0 || (hdr.prov.kind != 8w0xe7 && m.life_bad == 32w0x80000000)) {
                isn_access.apply();
                if (m.normalize == 1) { normalization_result.apply(); }
                mode_t.apply();
        /* mapper state */
        settle_t.apply();      // outcomes no classifier produces; the classifiers overwrite m.result later
        front_t.apply();
        derive_t.apply();
        /* padder native-CRC verdict */
        if (hdr.dl.crc != (m.in_dl[7:0] ++ m.in_dl[15:8])) { m.badh = 1; }
        if (hdr.c0.crc != (m.in_rb0[7:0] ++ m.in_rb0[15:8])) { m.rbad0 = 1; }
        if (hdr.c1.crc != (m.in_rb1[7:0] ++ m.in_rb1[15:8])) { m.rbad1 = 1; }
        if (hdr.c2.crc != (m.in_rt[7:0] ++ m.in_rt[15:8])) { m.rbadt = 1; }
        if (hdr.cb0.crc0 != (m.in_cb0[7:0] ++ m.in_cb0[15:8])) { m.cbad0 = 1; }
        if (hdr.ctn.crc1 != (m.in_ct[7:0] ++ m.in_ct[15:8])) { m.cbadt = 1; }
        acct_t.apply();
        img_end_t.apply();
        img_start_t.apply();
        envelope_result.apply();
        if ((bit<8>)m.dir == 2 && (bit<8>)m.shape == r_SH_ACK && (bit<8>)m.mode == 1 && m.normalize == 1) {
            reverse_gap_t.apply(); reverse_window_base_t.apply();
        }
        if ((bit<8>)m.dir == 1 && ((bit<8>)m.shape == r_SH_ACK || (bit<8>)m.shape == r_SH_NOACK)) {
            fwd_prep_t.apply();
            if ((bit<8>)m.mode == 1) { classify_fwd.apply(); }
        }
        if (((bit<8>)m.dir == 1 && (bit<8>)m.shape == r_SH_SYNACK_OK) || (bit<8>)m.mode == 1) { img_wend_t.apply(); }
        /* pad only on commit or replay; the verdict r_that allowed either also fixes the profile */
        if (m.pad == 1) {
            if (m.read_shape == 1) { read_pad_t.apply(); } else { ctl_pad_t.apply(); }
        } else if ((bit<8>)m.dir == 2 && (bit<8>)m.shape == r_SH_ACK && (bit<8>)m.mode == 1 && m.normalize == 1) {   // exclusive with padding
            classify_rev.apply();
            if ((bit<8>)m.wide == 1) { window_t.apply(); }
        }

            } else { drop_lifetime(); }
        } else {
            if ((bit<8>)m.ip_odd == 1) { odd_ip_t.apply(); drop_lifetime(); }
            else if ((bit<8>)m.dir != 0) { drop_lifetime(); }
            else if (hdr.prov.kind == 8w0xe0) { unbound_normalization(); }
            else { strip_provenance(); }
        }
        count_t.apply();
    }
}

control r_EgDeparser(packet_out pkt, inout r_headers_t hdr, in r_meta_t m, in egress_intrinsic_metadata_for_deparser_t md) {
    Checksum() ip_new; Checksum() tcp_plain; Checksum() tcp_read; Checksum() tcp_ctl;
    apply {
        if (m.pad == 1w1) {
            hdr.ip.checksum = ip_new.update({hdr.ip.version, hdr.ip.ihl, hdr.ip.tos, hdr.ip.len, hdr.ip.id, hdr.ip.flags,
                                             hdr.ip.frag, hdr.ip.ttl, hdr.ip.proto, hdr.ip.src, hdr.ip.dst});
        }
        /* response-only (make_e.py edit 3): an absent padding header's r_containers may hold live metadata
           under pipe-0 PHV pressure, so each case sums only the padding header r_that r_is present. */
        if (m.changed == 1w1) {
            /* Incremental: r_residual + current values of every word the parser r_subtracted. Field order keeps
               each header's byte parity equal to its parity in the segment; 8w0 pads the odd-length ones. */
            hdr.tcp.checksum = tcp_plain.update({hdr.tcp.seq, hdr.tcp.ack, m.ack_inv, hdr.tcp.window, m.len_delta,
                hdr.dl.start, hdr.dl.len, hdr.dl.ctrl, hdr.dl.dst, hdr.dl.src, hdr.dl.crc,
                hdr.rh.tpctrl, hdr.rh.appctrl, hdr.rh.func, hdr.rh.iin, hdr.robj.g_group, hdr.robj.g_var, hdr.robj.g_qual,
                hdr.robj.g_start, hdr.robj.g_stop, hdr.p03.d, hdr.p45.d, hdr.c0.crc,
                hdr.p69.d, hdr.p1012.d, hdr.p1321.d, hdr.c1.crc,
                hdr.p22.d, hdr.c2.crc, 8w0,
                hdr.cb0.tpctrl, hdr.cb0.appctrl, hdr.cb0.func, hdr.cb0.iin, hdr.cb0.g_group, hdr.cb0.g_var, hdr.cb0.g_qual,
                hdr.cb0.g_count, hdr.cb0.index, hdr.cb0.crob_code, hdr.cb0.crob_count, hdr.cb0.on_hi, hdr.cb0.crc0,
                hdr.ctn.on_lo, hdr.ctn.off, hdr.ctn.status, hdr.ctn.crc1, 8w0,
                m.r_residual});
        }
        if (hdr.ra.isValid()) {
            /* Incremental: r_residual + current values of every word the parser r_subtracted. Field order keeps
               each header's byte parity equal to its parity in the segment; 8w0 pads the odd-length ones. */
            hdr.tcp.checksum = tcp_read.update({hdr.tcp.seq, hdr.tcp.ack, m.ack_inv, hdr.tcp.window, m.len_delta,
                hdr.dl.start, hdr.dl.len, hdr.dl.ctrl, hdr.dl.dst, hdr.dl.src, hdr.dl.crc,
                hdr.rh.tpctrl, hdr.rh.appctrl, hdr.rh.func, hdr.rh.iin, hdr.ra.v, hdr.p03.d, hdr.p45.d, hdr.ca.crc,
                hdr.rbh.v, hdr.p69.d, hdr.rc.v, hdr.cb.crc,
                hdr.p1012.d, hdr.p1321.d, hdr.p22.d, hdr.c2.crc, 8w0,
                hdr.cb0.tpctrl, hdr.cb0.appctrl, hdr.cb0.func, hdr.cb0.iin, hdr.cb0.g_group, hdr.cb0.g_var, hdr.cb0.g_qual,
                hdr.cb0.g_count, hdr.cb0.index, hdr.cb0.crob_code, hdr.cb0.crob_count, hdr.cb0.on_hi, hdr.cb0.crc0,
                hdr.ctn.on_lo, hdr.ctn.off, hdr.ctn.status, hdr.ctn.crc1, 8w0,
                m.r_residual});
        }
        if (hdr.cd2.isValid()) {
            /* Incremental: r_residual + current values of every word the parser r_subtracted. Field order keeps
               each header's byte parity equal to its parity in the segment; 8w0 pads the odd-length ones. */
            hdr.tcp.checksum = tcp_ctl.update({hdr.tcp.seq, hdr.tcp.ack, m.ack_inv, hdr.tcp.window, m.len_delta,
                hdr.dl.start, hdr.dl.len, hdr.dl.ctrl, hdr.dl.dst, hdr.dl.src, hdr.dl.crc,
                hdr.rh.tpctrl, hdr.rh.appctrl, hdr.rh.func, hdr.rh.iin, hdr.robj.g_group, hdr.robj.g_var, hdr.robj.g_qual,
                hdr.robj.g_start, hdr.robj.g_stop, hdr.p03.d, hdr.p45.d, hdr.c0.crc,
                hdr.p69.d, hdr.p1012.d, hdr.p1321.d, hdr.c1.crc,
                hdr.p22.d, hdr.c2.crc, 8w0,
                hdr.cb0.tpctrl, hdr.cb0.appctrl, hdr.cb0.func, hdr.cb0.iin, hdr.cb0.g_group, hdr.cb0.g_var, hdr.cb0.g_qual,
                hdr.cb0.g_count, hdr.cb0.index, hdr.cb0.crob_code, hdr.cb0.crob_count, hdr.cb0.on_hi, hdr.cb0.crc0,
                hdr.cd2.start, hdr.cd2.len, hdr.cd2.ctrl, hdr.cd2.dst, hdr.cd2.src, hdr.cd2.crc,
                hdr.cs2.tpctrl, hdr.cs2.on_lo, hdr.cs2.off, hdr.cs2.crc,
                hdr.cd3.start, hdr.cd3.len, hdr.cd3.ctrl, hdr.cd3.dst, hdr.cd3.src, hdr.cd3.crc,
                hdr.cs3.tpctrl, hdr.cs3.status, hdr.cs3.crc, 8w0,
                m.r_residual});
        }
        pkt.emit(hdr.prov); pkt.emit(hdr.eth); pkt.emit(hdr.ip); pkt.emit(hdr.tcp); pkt.emit(hdr.mss); pkt.emit(hdr.dl);
        pkt.emit(hdr.rh); pkt.emit(hdr.robj); pkt.emit(hdr.ra); pkt.emit(hdr.p03); pkt.emit(hdr.p45); pkt.emit(hdr.c0); pkt.emit(hdr.ca);
        pkt.emit(hdr.rbh); pkt.emit(hdr.p69); pkt.emit(hdr.rc); pkt.emit(hdr.cb);
        pkt.emit(hdr.p1012); pkt.emit(hdr.p1321); pkt.emit(hdr.c1); pkt.emit(hdr.p22); pkt.emit(hdr.c2);
        pkt.emit(hdr.cb0); pkt.emit(hdr.ctn); pkt.emit(hdr.cd2); pkt.emit(hdr.cs2); pkt.emit(hdr.cd3); pkt.emit(hdr.cs3);
    }
}


/* Generated isolated T reconnect candidate. */
// T's READ timing role, queue-resident design (not the heartbeat/recirculation design in
// read_timing.p4). Real ACK/response/OPERATE originals stay resident in their hold queues
// (LADDER qid6/qid4, OP_LADDER qid2); only blocker tokens (qid7/qid5/qid3) repeat the timing
// circulation, matching defense4_rrc_bor_unified12.p4's qid7/6/5/4/3/2 ladder
// (integration/INTEGRATION_CONTRACT.md section 1; the heartbeat design is a correctness
// reference only, never the base). Invariants (a)-(g): see
// integration/read/tests/test_t_queue_invariants.py and
// DNP3_Timing_Size_Integration_Prompt.md section 4, Phase C. The whole file compiles for Tofino-1
// (2026-10-09, after the per-port verdict-table consolidation); what has been compiled and model-run
// is listed in read/TIMING_QUEUE_MIGRATION_STATUS.md.
#ifndef CASE4_READ_PORTS_P4
#define CASE4_READ_PORTS_P4
// Single source of every private port and role of the READ timing program (T). Include after <tna.p4>.
// tests/test_read_ports.py parses this file.
// Device port = pipe * 128 + pipe-local port (9 bits).
//
// TWO-PIPE LAYOUT (2026-10-10). The switch has two physical pipes: loading Switch(p0,p1,p2,p3) failed with
// "Pipeline p2 cannot be assigned to device 0 pipe 2, only 2 pipe(s) available", and BFRT $PORT shows
// 68-71 and 196-199 present, 324-327 absent. So N + E are pipe 0 and T is pipe 1; M is retired. The
// earlier layout (N pipe 0, M pipe 1, T pipe 2: t_T_IN 325, M's N_TO_M 196 / T_TO_M 197) cannot load t_on this
// chip; its M constants are removed so no stale M route can land t_on T's input (197 is t_T_IN now).
// Pipe-local 68-71 are dedicated recirculation ports, each independent (confirmed t_on the switch).
// Tags: ingress = a frame enters a pipe t_on this port; egress = a forwarding target; peer = owned by another role.
//
// The packet generator is not a port role here: T recognises generated tokens by their timer header t_on the
// default parser t_path. UNVERIFIED ON SILICON and a pre-hardware blocker: with app_cfg.pipe_local_source_port
// = 68 (required t_on this switch, Defense 2), generated tokens may arrive t_on local 68 = t_PKTGEN_RETURN, where
// T's parser t_expects a mirror clone (it selects parse_clone by port). See TIMING_QUEUE_MIGRATION_STATUS.md.
const PortId_t t_PKTGEN_RETURN = 9w196; // ingress pipe 1 local 68: mirror-clone recirculation into T ($mirror.cfg)
const PortId_t t_T_IN          = 9w180; /* compose.py port override (was 197) */ // ingress pipe 1 local 69: N-to-T handoff (N's READ_HANDOFF_PORT must equal this)
const PortId_t t_HB_RETURN     = 9w181; /* compose.py port override (was 198) */ // ingress pipe 1 local 70: heartbeat / OPERATE-ladder service return
const PortId_t t_HELD_RETURN   = 9w182; /* compose.py port override (was 199) */ // ingress pipe 1 local 71: private held-original recirculation
const PortId_t t_FORWARD_PORT  = 9w9;   // egress pipe 0 local 9: master side (cross-pipe, egress pipe not bypassed)
const PortId_t t_RELAY_PORT    = 9w9; /* compose.py port override (was 64) */  // egress pipe 0 local 64: outstation relay (cross-pipe, egress pipe not bypassed)
const PortId_t t_N_RETURN      = 9w68;  // peer pipe 0 local 68: N's own recirculation
const PortId_t t_MODEL_PKTGEN_IN = 9w0; // peer pipe 0 local 0: ingress_port the tofino-model gives generator packets
                                      // (a pipe-0 port, so it never reaches T's pipe 1 t_on silicon)
const bit<2> t_PKTGEN_PIPE = 1;         // pipe whose packet generator drives T (T's pipe)
#endif

// t_PKTGEN_RETURN (ports.p4, two-pipe layout: pipe 1 local 68 = 196) is where the mirror clone of a request
// admission recirculates.
// The clone itself (F1): mirror_type 1 requests it; t_IngressDeparser emits it to the mirror session the
// control t_plane binds to t_PKTGEN_RETURN ($mirror.cfg). The session id travels in metadata because
// bf-p4c rejects a constant session selector (defense4_rrc_bor_unified12.p4, same pattern).
const bit<3> t_MIRROR_TYPE_CLONE = 1;
// Clone vs generator token t_on t_PKTGEN_RETURN, told apart by CONTENT (Defense 2's method), not by port: t_on this
// switch the generator's tokens arrive t_on the pipe's local 68 (app_cfg.pipe_local_source_port = 68), which is
// t_PKTGEN_RETURN. A Tofino-1 timer header's first byte is pad(3)=0 | pipe(2) | app(3) <= 0x1F; every clone tag
// starts with t_CLONE_MARKER, matched EXACTLY t_on all 8 bits (Defense 2: a 0x1F mask aliased 0xE1 to app 1).
const bit<8> t_CLONE_MARKER = 0xE1;
const MirrorId_t t_CLONE_SESSION_ID = 10w7;
// Every pass that does not clone still goes through the deparser's mirror table, selected by mirror_type. bf-p4c
// gives the mirror_type == 0 entry a session id from a compiler temporary that no action writes and that it may
// place in the container of live metadata: in every build up to close_reset_fix_01 it shared md.cur_gen, so each
// non-cloning pass was mirrored to session cur_gen[9:0], and while the live READ generation was 7 (the configured
// session) every T pass was copied to t_PKTGEN_RETURN, the READ-7 clone re-mirrored itself and fired the READ
// generator thousands of times (route_ab_01/token_stale_01). So entry 0 is never selected: every pass selects the
// clone entry, with t_NO_MIRROR_SESSION unless admit_request / hold_operate set t_CLONE_SESSION_ID. Session 0 is not a
// valid mirror session, so nothing is copied. The two fields are pinned to containers of their own: bf-p4c drops
// the initial writes as redundant, so their zero must come from the container itself.
// core/response_only/check_mirror_select.py verifies this in each compiled build.
const MirrorId_t t_NO_MIRROR_SESSION = 10w0;

// Ladder roles (queue_sim.py ROLE dict): 11 ACK blocker, 12 response blocker, 13 OPERATE
// blocker, 14 held ACK, 15 held response, 16 held OPERATE.
const bit<8> t_ROLE_ACK_BLK  = 11; const bit<8> t_ROLE_RESP_BLK = 12; const bit<8> t_ROLE_OP_BLK  = 13;
const bit<8> t_ROLE_ACK_HELD = 14; const bit<8> t_ROLE_RESP_HELD = 15; const bit<8> t_ROLE_OP_HELD = 16;

// tev.kind wire values. The event's kind and stage are wire bytes 12-13 of the frame t_on t_T_IN, which is a
// front-panel MAC-loopback port t_on the hardware map, so kind must be >= 6: the pair is then in the EtherType
// range and not a reserved type (0x0900..0x0d02). RESET was 4 (read_timing.p4's value), giving 0x0401/0x0402,
// an 802.3 length that the MAC counted as received-not-good t_on port 180 (silicon p2_production_01); it is 13
// now. N's emit_reset must send the same value (make_n.py edit 13; compose.py checks the two agree).
const bit<8> t_KIND_REQUEST = 9; const bit<8> t_KIND_ACK = 10; const bit<8> t_KIND_RESPONSE = 11;
const bit<8> t_KIND_OPERATE = 12; const bit<8> t_KIND_RESET = 13; const bit<8> t_KIND_OPEN = 14;
// An identical OPERATE copy (dup_hold_01): held-time drop, post-release forward. Never cloned or held.
const bit<8> t_KIND_OPERATE_DUP = 15;

// Outcome counters (outcomes register index), named to match test_t_queue_invariants.py's
// out(sim, 'OUT_*') lookups via sim.consts().
const bit<32> t_OUT_UNMATCHED = 0; const bit<32> t_OUT_HELD_REWAIT = 1; const bit<32> t_OUT_ACK_COMMIT = 2;
const bit<32> t_OUT_RESP_RELEASE = 3; const bit<32> t_OUT_RESP_DUP_DROP = 4; const bit<32> t_OUT_OP_RELEASE = 5;
const bit<32> t_OUT_TOKEN_STALE = 6; const bit<32> t_OUT_HELD_STALE_FLUSH = 7; const bit<32> t_OUT_ACK_FALLBACK = 8;
const bit<32> t_OUT_RESP_FALLBACK = 9; const bit<32> t_OUT_TOKEN_TMO = 10; const bit<32> t_OUT_HELD_OFF_FLUSH = 11;
const bit<32> t_OUT_TOKEN_OFF = 12; const bit<32> t_OUT_REQ_BYPASS = 13;
const bit<32> t_OUT_OLD_EPOCH_DROP = 14; const bit<32> t_OUT_GEN_EXHAUSTED = 15;
const bit<32> t_OUT_OP_DUP_DROP = 16;
// No outcome recorded t_on this pass (md.outcome_code's initial value; outcome_count has no entry for it).
const bit<8> t_OUT_NONE = 0xff;

header t_tev_t { bit<32> epoch; bit<32> wgen; bit<32> t0q; bit<8> kind; bit<8> stage; bit<16> reserved; }
header t_ladder_t { bit<8> role; bit<8> child; bit<16> generation; bit<32> budget; }
header t_clone_hdr_t { bit<32> tag; }
header t_ethernet_t { bit<48> dst; bit<48> src; bit<16> type; }
struct t_header_t { pktgen_timer_header_t timer; t_clone_hdr_t clone; t_tev_t tev; t_ladder_t ladder; t_ethernet_t eth; }

struct t_metadata_t {
    // 1 when the parser t_saw a generator token of the expected format (pipe t_PKTGEN_PIPE, app 0 or 1) t_on a
    // generator port; the only way into the token branch.
    bit<8> token_ok;
    // da/readiness/gap/op_j are config action-data (set_params); cap is accepted (the test always
    // passes it) but not stored -- nothing in this design uses it as a deadline.
    bit<32> da; bit<32> readiness; bit<32> gap; bit<32> op_j; bit<32> budget_cap; bit<32> enabled;
    bit<32> now;
    // hdr.tev.epoch XOR the quarantined epoch, from quarantine_read: 0 exactly when this event's epoch is
    // quarantined. One value, so register actions that need the condition take one input (see t0_admit).
    // e_bad: 0 exactly when the event's epoch is the current epoch and not quarantined (epoch_check).
    bit<32> e_bad;  bit<32> packet_epoch; bit<32> cur_epoch_val; bit<32> epoch_delta; bit<32> quarantined_epoch; bit<8> event_kind;
    bit<32> cur_gen; bit<32> new_gen; bit<32> t0_v;
    // done_diff: the role's done register XOR its live generation (ack/resp: cur_gen, OPERATE: op_gen),
    // before any write t_on this pass. 0 exactly when that domain already completed in this generation.
    bit<32> done_diff;
    // lgen_diff: the ladder record's 16-bit generation XOR the live generation's low 16 bits; 0 = current.
    bit<16> lgen_diff;
    // Narrow: these only ever hold a 3-bit child mask or a 0/1 flag -- bit<32> would occupy 4x the
    // PHV this design doesn't have to spare (see TIMING_QUEUE_MIGRATION_STATUS.md's PHV finding).
    // seen<k>_diff: child_seen<k>_reg XOR cur_gen, 0 = response child k admitted in this generation.
    // dup_diff: the same for the child being admitted t_on this t_T_IN pass, before it is recorded.
    bit<32> seen0_diff; bit<32> seen1_diff; bit<32> seen2_diff; bit<32> dup_diff;
    bit<32> commit_diff;   // ack_commit_gen_reg XOR cur_gen: 0 = genuine ACK commit in this generation
    // 1 when this held ACK / held response may commit t_on this pass; the input to ack_done_try /
    // resp_done_try, computed before the register so the register needs no later dependent write.
    bit<8> ack_go; bit<8> resp_go; bit<8> commit_ok; bit<8> op_go;
    // Tofino's conditional-execution gateway cannot evaluate a live comparison between two fully
    // dynamic values (bf-p4c: "condition too complex ... one operand must be constant"), so every
    // now-vs-deadline check here is precomputed as delta = now - deadline, and its sign bit is matched
    // as a ternary key (32w0 &&& 32w0x80000000 = "deadline passed") in the go and verdict tables --
    // read_timing.p4's own deadline_deltas/heartbeat_eligibility pattern.
    // now_m_X = now - X: delta = now - (t0 + X) is computed as now_m_X - t0, the same value mod 2^32
    // in one subtraction after the register read instead of two (stage budget).
    bit<32> now_m_da; bit<32> da_delta;
    bit<32> now_m_readiness; bit<32> readiness_delta;
    bit<32> pb_bound; bit<32> now_m_pb; bit<32> pb_delta; bit<32> ack_seen_diff;
    bit<32> now_m_gap; bit<32> gap_delta;
    bit<32> op_t0_masked; bit<32> now_m_opj; bit<32> op_delta;
    bit<32> op_gen; bit<32> op_t0_v;
    bit<32> clone_tag;
    // Generator token's batch_id XOR each domain's live generation (low 16 bits); 0 = current.
    bit<16> op_tok_diff; bit<16> rd_tok_diff;
    MirrorId_t clone_ses;
    // The one outcome this pass records; bumped by the single outcome_count table at the end of apply.
    bit<8> outcome_code;
}

parser t_IngressParser(packet_in pkt, out t_header_t hdr, out t_metadata_t md,
                     out ingress_intrinsic_metadata_t ig_intr_md) {
    state start {
        md.event_kind = 0; md.packet_epoch = 0; pkt.extract(ig_intr_md); pkt.advance(PORT_METADATA_SIZE);
        md.token_ok = 0;
        transition select(ig_intr_md.ingress_port) {
            t_T_IN : parse_tev;
            t_HELD_RETURN : parse_ladder;
            t_HB_RETURN : parse_ladder;
            t_PKTGEN_RETURN : clone_or_token;
            t_MODEL_PKTGEN_IN : parse_timer;   // the model's generator; t_on silicon tokens come in t_on t_PKTGEN_RETURN
            // Any other pipe-1 ingress (front-panel 164-191 included) parses nothing and is dropped explicitly
            // in the apply block: no frame from a front-panel port can enter the token or clone t_path.
            default : accept;
        }
    }
    state parse_tev {
        pkt.extract(hdr.tev); md.event_kind = hdr.tev.kind; md.packet_epoch = hdr.tev.epoch;
        md.epoch_delta = 1w1 ++ hdr.tev.epoch[30:0];
        transition select(hdr.tev.kind, hdr.tev.reserved) {
            (9, 0) : opaque_ethernet;
            (10, 0) : opaque_ethernet;
            (11, 0) : opaque_ethernet;
            (12, 0) : opaque_ethernet;
            (t_KIND_OPERATE_DUP, 0) : opaque_ethernet;
            (t_KIND_RESET, 0) : opaque_ethernet;
            (t_KIND_OPEN, 0) : opaque_ethernet;
            default : reject;
        }
    }
    state parse_ladder {
        pkt.extract(hdr.ladder); md.packet_epoch = hdr.ladder.budget;
        transition select(hdr.ladder.role) {
            11 : accept;
            12 : accept;
            13 : accept;
            14 : opaque_ethernet;
            15 : opaque_ethernet;
            16 : opaque_ethernet;
            default : reject;
        }
    }
    // The clone always carries this pass's pristine original bytes (tag + the t_T_IN wire format it
    // mirrored). Only an OPERATE-admission clone (tev.kind 12) is used for anything; a
    // request-admission clone (kind 9, READ's ACK/response blockers never need this) is parsed the
    // same way and then simply dropped in the apply block.
    state clone_or_token {
        transition select(pkt.lookahead<bit<8>>()) {
            t_CLONE_MARKER : parse_clone;
            default : parse_timer;
        }
    }
    state parse_clone {
        pkt.extract(hdr.clone); pkt.extract(hdr.tev); md.event_kind = hdr.tev.kind; md.packet_epoch = hdr.tev.epoch;
        md.epoch_delta = 1w1 ++ hdr.tev.epoch[30:0];
        transition select(hdr.tev.kind, hdr.tev.reserved) {
            (9, 0) : opaque_ethernet;
            (12, 0) : opaque_ethernet;
            default : accept;   // an unexpected kind is dropped by drop_clone in the apply block (no reliance t_on reject)
        }
    }
    state parse_timer {
        pkt.extract(hdr.timer);
        // Only the expected generator format is a token: T's pipe and its two apps (0 READ, 1 OPERATE).
        transition select(hdr.timer.pipe_id, hdr.timer.app_id) {
            (t_PKTGEN_PIPE, 0) : token_format_ok;
            (t_PKTGEN_PIPE, 1) : token_format_ok;
            default : accept;
        }
    }
    state token_format_ok { md.token_ok = 1; transition accept; }
    state opaque_ethernet { pkt.extract(hdr.eth); transition accept; }
}

@pa_no_overlay("ingress", "ig_intr_md_for_dprsr.mirror_type")
@pa_no_overlay("ingress", "md.clone_ses")
control t_Ingress(inout t_header_t hdr, inout t_metadata_t md,
                in ingress_intrinsic_metadata_t ig_intr_md,
                in ingress_intrinsic_metadata_from_parser_t ig_prsr_md,
                inout ingress_intrinsic_metadata_for_deparser_t ig_dprsr_md,
                inout ingress_intrinsic_metadata_for_tm_t ig_tm_md) {
    // ---- configuration (per-pass action data, not registers) --------------------------------
    action set_params(bit<32> da, bit<32> readiness, bit<32> cap, bit<32> gap, bit<32> op_j,
                      bit<32> budget, bit<32> enabled, bit<32> pb) {
        md.da = da; md.readiness = readiness; md.gap = gap; md.op_j = op_j;
        md.budget_cap = budget; md.enabled = enabled; md.pb_bound = pb;
    }
    table params {
        actions = { set_params; }
        default_action = set_params(2000000, 12000000, 16000000, 800000, 2400000, 240000, 1, 12000000); size = 1;
    }
    action clock_sample() { md.now = ig_prsr_md.global_tstamp[39:8] & 32w0xfffffffe; }
    table clock { actions = { clock_sample; } default_action = clock_sample(); size = 1; }

    // ---- epoch / generation state -------------------------------------------------------------
    // bit31 seals the current lifetime; bits30:0 retain its bounded epoch.
    Register<bit<32>, bit<1>>(1, 0) cur_epoch_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(cur_epoch_reg) epoch_open = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            // A live epoch is positive; a sealed epoch is negative as int32.
            // Exactly one comparison can accept each encoding. Bounds are
            // rejected by lifetime_access before this action can write.
            if (value < md.packet_epoch || (int<32>)value < (int<32>)md.epoch_delta) {
                value = md.packet_epoch; out_value = 0;
            } else { out_value = 1; }
        }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(cur_epoch_reg) epoch_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(cur_epoch_reg) epoch_match = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.packet_epoch; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(cur_epoch_reg) epoch_close = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            out_value = value ^ md.packet_epoch;
            if (value == md.packet_epoch && md.packet_epoch != 0) { value = value | 32w0x80000000; }
        }
    };
    action open_epoch() { md.epoch_delta = epoch_open.execute(0); }
    action read_epoch() { md.packet_epoch = epoch_read.execute(0); md.epoch_delta = 0; }
    action match_epoch() { md.epoch_delta = epoch_match.execute(0); }
    action close_epoch() { md.epoch_delta = epoch_close.execute(0); }
    action reject_open() { md.epoch_delta = 1; }
    table lifetime_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary;
                hdr.ladder.role : ternary; md.packet_epoch : ternary; }
        actions = { open_epoch; read_epoch; match_epoch; close_epoch; reject_open; }
        const entries = {
            (t_T_IN, t_KIND_OPEN, _, 0) : reject_open();
            (t_T_IN, t_KIND_OPEN, _, 32w0x7fffffff) : reject_open();
            (t_T_IN, t_KIND_OPEN, _, 32w0x80000000 &&& 32w0x80000000) : reject_open();
            (t_T_IN, t_KIND_OPEN, _, _) : open_epoch();
            (t_T_IN, t_KIND_RESET, _, _) : close_epoch();
            (t_T_IN, _, _, _) : match_epoch();
            (t_PKTGEN_RETURN, t_KIND_OPERATE, _, _) : match_epoch();
            (t_HELD_RETURN, _, t_ROLE_ACK_HELD, _) : match_epoch();
            (t_HELD_RETURN, _, t_ROLE_RESP_HELD, _) : match_epoch();
            (t_HB_RETURN, _, t_ROLE_OP_HELD, _) : match_epoch();
        }
        default_action = read_epoch(); size = 10;
    }
    Register<bit<32>, bit<1>>(1, 0) gen_alloc_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(gen_alloc_reg) gen_peek = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(gen_alloc_reg) gen_bump = {
        void apply(inout bit<32> value, out bit<32> out_value) { if (value < 32w0xffff) { value = value + 1; } out_value = value; }
    };
    // An enabled REQUEST pass: opens a new generation unless the request's epoch is quarantined.
    RegisterAction<bit<32>, bit<1>, bit<32>>(gen_alloc_reg) gen_admit = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            if (value < 32w0xfffe) { value = value + 1; }
            else { value = 32w0xffff; }
            out_value = value;
        }
    };
    // Request-anchored t0 (NOTATION_MAPPING.md convention): the quantized arrival time of the
    // request that opened the current generation. da/readiness/cap are offsets from THIS, not
    // from the epoch. Written once per generation at admission (admit_request never fires twice
    // for the same generation, so no lazy-arm guard is needed here).
    Register<bit<32>, bit<1>>(1, 0) t0_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(t0_reg) t0_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value; }
    };
    // An enabled REQUEST pass records its arrival time unless its epoch is quarantined; the condition is
    // decided here (q_diff) so t0_reg is accessed by one table, t0_access, in the prologue stage with the
    // generation and epoch registers. Behind the request arm's quarantine gateway the write landed a stage
    // later and pushed the whole ACK->response chain past stage 11 (route_ab_01/b24_pin_probe).
    RegisterAction<bit<32>, bit<1>, bit<32>>(t0_reg) t0_admit = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            if (md.e_bad == 0) { value = md.now; }
            out_value = value;
        }
    };
    // Tofino requires every table (and every bare action call becomes one) to address at most one
    // indirect extern, so reads/writes spanning multiple registers are always split into separate
    // single-register actions called as separate statements, never bundled into one action body.
    action peek_gen() { md.cur_gen = gen_peek.execute(0); }
    action admit_gen() { md.new_gen = gen_admit.execute(0); }
    action reset_bump_gen() { md.new_gen = gen_bump.execute(0); }
    // gen_alloc_reg and cur_epoch_reg are each accessed by ONE table, applied once after quarantine_reg:
    // an enabled REQUEST t_on t_T_IN admits (bump / record, unless its epoch is quarantined, decided inside
    // the register action), an enabled RESET bumps the generation, every other pass reads. Entries are
    // matched in order, so the `enabled == 0` rows make the rest mean `enabled != 0` exactly. Separate
    // reads at the top of the pass plus writes behind the quarantine gateway did not place
    // (route_ab_01/b14..b16: cur_epoch_reg and gen_alloc_reg "not able to allocate ... in the same
    // stage", then "no more tables are placeable").
    action live_gen() { md.cur_gen = gen_peek.execute(0); md.e_bad = 0; }
    action bad_gen() { md.cur_gen = gen_peek.execute(0); md.e_bad = 1; }
    action duplicate_close_gen() { md.cur_gen = gen_peek.execute(0); md.e_bad = 2; }
    action live_admit_gen() { md.new_gen = gen_admit.execute(0); md.e_bad = 0; }
    action live_reset_gen() { md.new_gen = gen_bump.execute(0); md.e_bad = 0; }
    table gen_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary;
                md.enabled : ternary; md.packet_epoch : ternary; md.epoch_delta : ternary; }
        actions = { live_gen; bad_gen; duplicate_close_gen; live_admit_gen; live_reset_gen; }
        const entries = {
            (_, _, _, 0, _) : bad_gen();
            (_, _, _, 32w0x7fffffff, _) : bad_gen();
            (_, _, _, 32w0x80000000 &&& 32w0x80000000, _) : bad_gen();
            (t_T_IN, t_KIND_OPEN, _, _, 0) : live_reset_gen();
            (t_T_IN, t_KIND_RESET, _, _, 32w0x80000000) : duplicate_close_gen();
            (t_T_IN, t_KIND_RESET, _, _, 0) : live_reset_gen();
            (t_T_IN, t_KIND_REQUEST, 0, _, 0) : live_gen();
            (t_T_IN, t_KIND_REQUEST, _, _, 0) : live_admit_gen();
            (t_T_IN, t_KIND_OPERATE, 0, _, 0) : live_gen();
            (t_T_IN, t_KIND_OPERATE, _, _, 0) : live_admit_gen();
            (_, _, _, _, 0) : live_gen();
        }
        default_action = bad_gen(); size = 11;
    }
    action read_t0() { md.t0_v = t0_read.execute(0); }
    action admit_t0() { md.t0_v = t0_admit.execute(0); }
    table t0_access {
        key = { ig_intr_md.ingress_port : exact; md.event_kind : ternary; md.enabled : ternary; md.new_gen : ternary; }
        actions = { read_t0; admit_t0; }
        const entries = {
            (t_T_IN, t_KIND_REQUEST, _, 32w0xffff) : read_t0();
            (t_T_IN, t_KIND_REQUEST, 0, _) : read_t0();
            (t_T_IN, t_KIND_REQUEST, _, _) : admit_t0();
            (t_T_IN, t_KIND_OPERATE, _, 32w0xffff) : read_t0();
            (t_T_IN, t_KIND_OPERATE, 0, _) : read_t0();
            (t_T_IN, t_KIND_OPERATE, _, _) : admit_t0();
        }
        default_action = read_t0(); size = 6;
    }
    // ---- ACK domain -----------------------------------------------------------------------
    Register<bit<32>, bit<1>>(1, 0) ack_done_reg;
    // Pure read, returned as value XOR cur_gen: zero exactly when value == cur_gen. A table can match
    // "equals 0" t_on one field but cannot match two runtime fields for equality, so this lets the
    // response's go flag be one ternary table (resp_go_check) instead of a sign table, a gateway and an
    // assignment (stage budget, route_ab_01/b23).
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_done_reg) ack_done_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; }
    };
    // Same atomic compare-and-commit shape as op_done_try: returns the old value, records cur_gen
    // when md.ack_go is set (rewriting an equal cur_gen is a no-op).
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_done_reg) ack_done_try = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            out_value = value ^ md.cur_gen;
            if (md.ack_go == 1) { value = md.cur_gen; }
        }
    };
    // Generation-scoped a_commit (2026-10-09, route_ab_01/b30). Both registers are written only by a
    // genuine ACK commit (da passed with a response child seen): ack_commit_at_reg the time, and
    // ack_commit_gen_reg the READ generation it belongs to. A response may use a_commit only when
    // ack_commit_gen_reg is the current generation (commit_diff == 0, gating every use of the gap delta). A RESET
    // (which bumps the generation) or an ACK that finished by readiness fallback (which records no
    // a_commit) leaves a non-matching generation, so a zero or stale time is never taken as a_commit in
    // the signed gap comparison; no RESET-time clear is needed. Two single-word registers rather than one
    // {gen, at} pair: a two-field stateful ALU may not return a computed value (bf-p4c "subtraction can
    // only be used when the result is written to the register", route_ab_01/b29).
    Register<bit<32>, bit<1>>(1, 0) ack_commit_at_reg;
    // Returns the response gap delta directly: (now - gap) - a_commit = now - (a_commit + gap).
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_commit_at_reg) commit_at_gap = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = md.now_m_gap - value; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_commit_at_reg) commit_at_write = {
        void apply(inout bit<32> value, out bit<32> out_value) { value = md.now; out_value = value; }
    };
    // Initial value 0xffffffff, not 0: generation 0 is the live READ generation before the first request,
    // so a register holding 0 would read as "a genuine commit in generation 0" (commit_diff == 0). Any
    // control-t_plane or hardware clear of this register must restore 0xffffffff, not 0.
    Register<bit<32>, bit<1>>(1, 0xffffffff) ack_commit_gen_reg;
    // value XOR cur_gen: 0 exactly when a genuine ACK commit happened in the current generation.
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_commit_gen_reg) commit_gen_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_commit_gen_reg) commit_gen_write = {
        void apply(inout bit<32> value, out bit<32> out_value) { value = md.cur_gen; out_value = value; }
    };

    // ---- response domain --------------------------------------------------------------------
    Register<bit<32>, bit<1>>(1, 0) resp_done_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(resp_done_reg) resp_done_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(resp_done_reg) resp_done_try = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            out_value = value ^ md.cur_gen;
            if (md.resp_go == 1) { value = md.cur_gen; }
        }
    };
    // No resp_deadline register (removed 2026-10-09, route_ab_01/b28). It was armed (once per RESET, only
    // while 0) and cleared, but no decision ever read it: response release is decided from
    // ack_commit_at_reg (commit_at_gap) and the configured gap. Its value, a_commit + gap, is derivable
    // from ack_commit_at_reg + gap; the tests now check ack_commit_at_reg directly.
    // Response children (route_ab_01/b40): one single-word register per child k (tev.stage 0, 1, 2+),
    // holding the READ generation in which child k was last admitted; initial 0xffffffff so that no
    // child reads as seen in generation 0 (restore that value, not 0, t_on any clear). Replaces a {gen,
    // mask} pair whose `(value.mask & BIT) != 0` condition bfas rejects ("expecting register slice").
    Register<bit<32>, bit<1>>(1, 0xffffffff) child_seen0_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(child_seen0_reg) child_try0 = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; value = md.cur_gen; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(child_seen0_reg) child_read0 = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; }
    };
    Register<bit<32>, bit<1>>(1, 0xffffffff) child_seen1_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(child_seen1_reg) child_try1 = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; value = md.cur_gen; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(child_seen1_reg) child_read1 = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; }
    };
    Register<bit<32>, bit<1>>(1, 0xffffffff) child_seen2_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(child_seen2_reg) child_try2 = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; value = md.cur_gen; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(child_seen2_reg) child_read2 = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; }
    };
    action read_seen0() { md.seen0_diff = child_read0.execute(0); }
    action read_seen1() { md.seen1_diff = child_read1.execute(0); }
    action read_seen2() { md.seen2_diff = child_read2.execute(0); }

    action try_seen0() { md.seen0_diff = child_try0.execute(0); }
    // Piggyback detection: the last lane generation a standalone ACK was seen in. A response held in a
    // generation with no ACK (TCP piggybacked the ACK on it) reads a non-zero diff.
    Register<bit<32>, bit<1>>(1, 0xffffffff) ack_seen_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_seen_reg) ack_seen_mark = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = 0; value = md.cur_gen; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(ack_seen_reg) ack_seen_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.cur_gen; }
    };
    action mark_ack_seen() { md.ack_seen_diff = ack_seen_mark.execute(0); }
    action read_ack_seen() { md.ack_seen_diff = ack_seen_read.execute(0); }
    table ack_seen_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary; hdr.ladder.role : ternary;
                md.e_bad : ternary; }
        actions = { mark_ack_seen; read_ack_seen; NoAction; }
        const entries = {
            (t_T_IN, t_KIND_ACK, _, 0) : mark_ack_seen();
            (t_HELD_RETURN, _, t_ROLE_RESP_HELD, _) : read_ack_seen();
        }
        default_action = NoAction(); size = 2;
    }
    table child_seen0_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary;
                hdr.tev.stage : ternary; md.e_bad : ternary; md.enabled : ternary; }
        actions = { read_seen0; try_seen0; NoAction; }
        const entries = {
            (t_HELD_RETURN, _, _, _, _) : read_seen0();
            (t_T_IN, t_KIND_RESPONSE, 0, _, 0) : NoAction();
            (t_T_IN, t_KIND_RESPONSE, 0, 0, _) : try_seen0();
        }
        default_action = NoAction(); size = 3;
    }
    action try_seen1() { md.seen1_diff = child_try1.execute(0); }
    table child_seen1_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary;
                hdr.tev.stage : ternary; md.e_bad : ternary; md.enabled : ternary; }
        actions = { read_seen1; try_seen1; NoAction; }
        const entries = {
            (t_HELD_RETURN, _, _, _, _) : read_seen1();
            (t_T_IN, t_KIND_RESPONSE, 1, _, 0) : NoAction();
            (t_T_IN, t_KIND_RESPONSE, 1, 0, _) : try_seen1();
        }
        default_action = NoAction(); size = 3;
    }
    action try_seen2() { md.seen2_diff = child_try2.execute(0); }
    table child_seen2_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary;
                hdr.tev.stage : ternary; md.e_bad : ternary; md.enabled : ternary; }
        actions = { read_seen2; try_seen2; NoAction; }
        const entries = {
            (t_HELD_RETURN, _, _, _, _) : read_seen2();
            (t_T_IN, t_KIND_RESPONSE, 0, _, _) : NoAction();
            (t_T_IN, t_KIND_RESPONSE, 1, _, _) : NoAction();
(t_T_IN, t_KIND_RESPONSE, _, _, 0) : NoAction();
            (t_T_IN, t_KIND_RESPONSE, _, 0, _) : try_seen2();
        }
        default_action = NoAction(); size = 5;
    }
    // ---- OPERATE domain ---------------------------------------------------------------------
    Register<bit<32>, bit<1>>(1, 0) op_gen_alloc_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(op_gen_alloc_reg) op_gen_peek = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(op_gen_alloc_reg) op_gen_bump = {
        void apply(inout bit<32> value, out bit<32> out_value) { if (value < 32w0xffff) { value = value + 1; } out_value = value; }
    };
    Register<bit<32>, bit<1>>(1, 0) op_done_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(op_done_reg) op_done_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value ^ md.op_gen; }
    };
    // Atomic compare-and-commit for a held OPERATE: returns the generation recorded BEFORE this pass
    // and records md.op_gen when the deadline has passed. A Tofino register lives in one stage, so the
    // old read-then-compare-then-dependent-write (op_done_read, gateway, op_done_write in a later
    // table) could not place; the caller now decides release from the returned old value instead.
    // Writing op_gen over an equal op_gen is a no-op, so the result t_matches the old three-step t_path.
    RegisterAction<bit<32>, bit<1>, bit<32>>(op_done_reg) op_done_try = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            out_value = value ^ md.op_gen;
            if (md.op_go == 1) { value = md.op_gen; }
        }
    };
    Register<bit<32>, bit<1>>(1, 0) op_t0_reg;
    RegisterAction<bit<32>, bit<1>, bit<32>>(op_t0_reg) op_t0_read = {
        void apply(inout bit<32> value, out bit<32> out_value) { out_value = value; }
    };
    RegisterAction<bit<32>, bit<1>, bit<32>>(op_t0_reg) op_t0_arm = {
        void apply(inout bit<32> value, out bit<32> out_value) {
            if (md.op_gen < 32w0xffff) { value = md.now | 32w1; }
            out_value = value;
        }
    };
    // No RESET-time clear (2026-10-09, route_ab_01/b32). RESET invalidates OPERATE by bumping its
    // generation (reset_bump_op_gen): a held OPERATE and its blockers then fail the generation check and
    // are flushed / dropped as stale, without op_t0_reg's zero being read as "overdue" in the signed
    // deadline comparison (which was late by up to ~2.1 s in the upper half of the clock).

    // ---- outcomes -----------------------------------------------------------------------------
    Register<bit<32>, bit<5>>(25, 0) outcomes;
    RegisterAction<bit<32>, bit<5>, bit<32>>(outcomes) bump_outcome = {
        void apply(inout bit<32> value, out bit<32> out_value) { value = value + 1; out_value = value; }
    };
    // Every t_path records at most one outcome. A Tofino register lives in one stage, and the ~dozen
    // tables that used to bump `outcomes` directly sat at different dependency depths, so they could
    // not share its stage (bf-p4c: "Table placement was not able to allocate ... in the same stage
    // along with Register t_Ingress.outcomes"). count() now only names the outcome; outcome_count, the
    // register's single call site, bumps it once at the end of the pass. Same index, same +1.
    action count(bit<32> code) { md.outcome_code = (bit<8>)code; }
    action bump(bit<5> idx) { bump_outcome.execute(idx); }
    table outcome_count {
        key = { md.outcome_code : exact; }
        actions = { bump; NoAction; }
        const entries = {
            0 : bump(0); 1 : bump(1); 2 : bump(2); 3 : bump(3); 4 : bump(4); 5 : bump(5); 6 : bump(6);
            7 : bump(7); 8 : bump(8); 9 : bump(9); 10 : bump(10); 11 : bump(11); 12 : bump(12); 13 : bump(13); 14 : bump(14); 15 : bump(15); 16 : bump(16); 23 : bump(23); 24 : bump(24);
        }
        default_action = NoAction(); size = 25;
    }

    // ---- request admission ---------------------------------------------------------------------
    // new_gen is gen_access's output from an earlier stage, so masking it here is an ordinary ALU op
    // (masking a stateful ALU's output in the action that receives it was IMPOSSIBLE_ALIGNMENT, b7).
    action admit_request() {
        
        ig_tm_md.ucast_egress_port = t_RELAY_PORT;
        ig_dprsr_md.mirror_type = 1;
        md.clone_ses = t_CLONE_SESSION_ID;
        md.clone_tag = 16w0xE100 ++ md.new_gen[15:0];   // t_CLONE_MARKER in the top byte
    }
    action bypass_request() {
        
        ig_tm_md.ucast_egress_port = t_RELAY_PORT;
        count(t_OUT_REQ_BYPASS);
    }
    // The RESET pass never reads md.op_gen, so the bump's output is not written: writing it here and in
    // the OPERATE arm made a write-after-write order between two call sites of one register (b35).
    action reset_bump_op_gen() { op_gen_bump.execute(0); }

    // ---- hold admission (ACK / response) --------------------------------------------------------
    action hold_ack() {
        hdr.tev.setInvalid();
        hdr.ladder.setValid();
        hdr.ladder.role = t_ROLE_ACK_HELD; hdr.ladder.child = 0;
        hdr.ladder.generation = (bit<16>)md.cur_gen; hdr.ladder.budget = md.packet_epoch;
        ig_tm_md.ucast_egress_port = t_HELD_RETURN; ig_tm_md.qid = 6;
    }
    action admit_response() {
        hdr.ladder.setValid();
        hdr.ladder.role = t_ROLE_RESP_HELD; hdr.ladder.child = (bit<8>)hdr.tev.stage;
        hdr.ladder.generation = (bit<16>)md.cur_gen; hdr.ladder.budget = md.packet_epoch;
        hdr.tev.setInvalid();
        ig_tm_md.ucast_egress_port = t_HELD_RETURN; ig_tm_md.qid = 4;
    }
    action drop_duplicate_response() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_RESP_DUP_DROP); }
    action passthrough_tev_forward() {  ig_tm_md.ucast_egress_port = t_FORWARD_PORT; }
    // The admitting t_T_IN pass becomes OP_LADDER's first blocker directly (qid3, immediate) instead
    // of the real admission: a generated blocker token cannot carry the original (it has no
    // payload), so the only way to admit the real original without racing the generator's delay is
    // to admit it from the mirror CLONE instead (see parse_clone_tev / admit_operate_held below) --
    // the clone always carries the pass's pristine original bytes, and by construction the direct
    // blocker here is already in qid3 before the clone (pktgen_ns/2) or any generated token
    // (pktgen_ns) can arrive, so qid3 is never empty when the real original's first item shows up.
    action hold_operate() {
        // Keep the Ethernet header. This direct blocker laps t_on t_HB_RETURN, a front-panel port in MAC
        // loopback t_on the switch (hardware port map). With eth stripped, offset 12-13 fell t_on the IP
        // identification field, an arbitrary value the MAC read as an 802.3 length (or 0x8808 control) and
        // dropped, so the OPERATE ladder never established and the OPERATE was lost (combined_silicon_01).
        // With eth kept, offset 12-13 is the original's ethertype octets, as t_on every held frame, which lap.
        // The blocker only holds qid3; parse_ladder accepts role 13 and ignores what follows, and the real
        // OPERATE is released from the mirror clone (admit_operate_held), not from this frame.
        hdr.tev.setInvalid();
        hdr.ladder.setValid();
        hdr.ladder.role = t_ROLE_OP_BLK; hdr.ladder.child = 0;
        hdr.ladder.generation = (bit<16>)md.op_gen; hdr.ladder.budget = md.budget_cap;
        ig_tm_md.ucast_egress_port = t_HB_RETURN; ig_tm_md.qid = 3;
        // The tag is a constant top half 0xE101 (t_CLONE_MARKER 0xE1, then 0x01) and op_gen's low 16 bits; only
        // the low 16 are read back (admit_operate_held's ladder generation). Bits 31:16 must be exactly 0xE101
        // whatever op_gen is: the parser t_matches the marker byte exactly, and the packet generator's OPERATE
        // trigger pattern is 0xE101xxxx with mask 0xFFFF0000 (unified12 / Defense 2 pktgen config). The old
        // `op_gen | 0xE1010000` corrupted bits 31:16 from op_gen = 0x20000 (pattern) and the marker byte from
        // 0x2000000. op_gen keeps its 32-bit lifetime. Same form as admit_request's read-clone tag.
        ig_dprsr_md.mirror_type = 1; md.clone_tag = 16w0xE101 ++ md.op_gen[15:0];   // t_CLONE_MARKER in the top byte
        md.clone_ses = t_CLONE_SESSION_ID;
    }
    // The held original carries the generation of the OPERATE that was admitted: the clone's own tag
    // (hold_operate wrote 0xE101 ++ op_gen[15:0], so its low 16 bits are that generation's ladder value), not a
    // fresh read of op_gen_alloc_reg. Since RESET bumps the OPERATE generation, a fresh read could pick up
    // a RESET that landed between the admission and the clone's return, and the superseded OPERATE was
    // then released t_on its old deadline instead of flushed as stale (code review, 2026-10-09: RESET 1..5
    // us after the OPERATE; route_ab_01/b34_clone_tag_generation).
    action admit_operate_held() {
        hdr.ladder.setValid();
        hdr.ladder.role = t_ROLE_OP_HELD; hdr.ladder.child = 0;
        hdr.ladder.generation = (bit<16>)hdr.clone.tag; hdr.ladder.budget = md.packet_epoch;
        hdr.clone.setInvalid(); hdr.tev.setInvalid();
        ig_tm_md.ucast_egress_port = t_HB_RETURN; ig_tm_md.qid = 2;
    }
    action drop_clone() { ig_dprsr_md.drop_ctl = 1; }
    action passthrough_tev_relay() {  ig_tm_md.ucast_egress_port = t_RELAY_PORT; }

    // ---- generator token -> blocker (ports 0, generator app) -----------------------------------
    action seed_ack_blocker() {
        hdr.ladder.setValid();
        hdr.ladder.role = t_ROLE_ACK_BLK; hdr.ladder.child = 0;
        hdr.ladder.generation = hdr.timer.batch_id; hdr.ladder.budget = md.budget_cap;
        hdr.timer.setInvalid();   // after reading batch_id
        ig_tm_md.ucast_egress_port = t_HELD_RETURN; ig_tm_md.qid = 7;
    }
    action seed_resp_blocker() {
        hdr.ladder.setValid();
        hdr.ladder.role = t_ROLE_RESP_BLK; hdr.ladder.child = 0;
        hdr.ladder.generation = hdr.timer.batch_id; hdr.ladder.budget = md.budget_cap;
        hdr.timer.setInvalid();   // after reading batch_id
        ig_tm_md.ucast_egress_port = t_HELD_RETURN; ig_tm_md.qid = 5;
    }
    action seed_op_blocker() {
        hdr.ladder.setValid();
        hdr.ladder.role = t_ROLE_OP_BLK; hdr.ladder.child = 0;
        hdr.ladder.generation = hdr.timer.batch_id; hdr.ladder.budget = md.budget_cap;
        hdr.timer.setInvalid();   // after reading batch_id
        ig_tm_md.ucast_egress_port = t_HB_RETURN; ig_tm_md.qid = 3;
    }
    // Token staleness without a gateway comparing two runtime fields: `token_gen != (gen & 0xffff)` in a
    // gateway (token_gen is the zero-extended 16-bit batch_id) was what turned this program's placement
    // errors into bf-p4c's bare "Internal compiler error" (route_ab_01/b19_port0_bisect: removing both such
    // comparisons, p3, gives readable errors; removing either alone, p1/p2, still crashes). The XOR is
    // zero exactly when batch_id equals the generation's low 16 bits, so `tok_diff != 0` is the same test.
    action token_diffs() {
        md.op_tok_diff = hdr.timer.batch_id ^ (bit<16>)md.op_gen;
        md.rd_tok_diff = hdr.timer.batch_id ^ (bit<16>)md.cur_gen;
    }
    action drop_timer_stale(bit<5> index) { hdr.timer.setInvalid(); ig_dprsr_md.drop_ctl = 1; count((bit<32>)index); }

    // ---- ladder dispatch: blockers re-circulate or die ------------------------------------------
    action keep_blocking(PortId_t port, bit<5> qid) {
        hdr.ladder.budget = hdr.ladder.budget - 1;
        ig_tm_md.ucast_egress_port = port; ig_tm_md.qid = qid;
    }
    action stop_blocking() { ig_dprsr_md.drop_ctl = 1; }
    action stop_blocking_stale() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_TOKEN_STALE); }
    action stop_blocking_tmo() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_TOKEN_TMO); }
    action stop_blocking_off() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_TOKEN_OFF); }

    // ---- deadline readiness: delta-then-sign-bit, read_timing.p4's own proven pattern -----------
    // A live "now >= deadline" comparison is a gateway/conditional operation Tofino caps tightly
    // (bf-p4c: "condition too complex ... one operand must be constant"). Computing delta = now -
    // deadline and then testing its sign bit is still the fix. The sign bit is matched as a ternary key
    // (go and verdict tables), not read by a `delta[31:31]` slice: the slice forced every field in the
    // now/t0/deadline/delta add chain, and global_tstamp itself, to split at bit 31, which no 32-bit
    // container can hold across an add ("PHV allocation was not successful", 40 slices [30:0]/[31:31],
    // evidence/route_ab_01/b6_branch_probes/v5_stub_port0.log). A TCAM key needs no such split.
    action held_offsets() {
        md.now_m_da = md.now - md.da; md.now_m_readiness = md.now - md.readiness; md.now_m_gap = md.now - md.gap;
        md.now_m_pb = md.now - md.pb_bound;
    }
    action compute_pb_delta() { md.pb_delta = md.now_m_pb - md.t0_v; }
    action compute_da_delta() { md.da_delta = md.now_m_da - md.t0_v; }
    action compute_readiness_delta() { md.readiness_delta = md.now_m_readiness - md.t0_v; }
    action read_gap_delta() { md.gap_delta = commit_at_gap.execute(0); }
    action read_lgen_diff() { md.lgen_diff = hdr.ladder.generation ^ (bit<16>)md.cur_gen; }
    action op_lgen_diff() { md.lgen_diff = hdr.ladder.generation ^ (bit<16>)md.op_gen; }
    action read_ack_done() { md.done_diff = ack_done_read.execute(0); }
    action try_ack_done() { md.done_diff = ack_done_try.execute(0); }
    action read_resp_done() { md.done_diff = resp_done_read.execute(0); }
    action try_resp_done() { md.done_diff = resp_done_try.execute(0); }
    action read_op_done() { md.done_diff = op_done_read.execute(0); }
    action try_op_done() { md.done_diff = op_done_try.execute(0); }
    action compute_op_t0_masked() { md.op_t0_masked = md.op_t0_v & 32w0xfffffffe; }
    action op_offset() { md.now_m_opj = md.now - md.op_j; }
    action compute_op_delta() { md.op_delta = md.now_m_opj - md.op_t0_masked; }

    action peek_operate_generation() { md.op_gen = op_gen_peek.execute(0); }
    action bump_operate_generation() { md.op_gen = op_gen_bump.execute(0); }
    table operate_generation_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary;
                md.enabled : ternary; md.e_bad : ternary; }
        actions = { peek_operate_generation; bump_operate_generation; }
        const entries = {
            (t_T_IN, t_KIND_OPEN, _, 0) : bump_operate_generation();
            (t_T_IN, t_KIND_RESET, _, 0) : bump_operate_generation();
            (t_T_IN, t_KIND_OPERATE, 0, _) : peek_operate_generation();
            (t_T_IN, t_KIND_OPERATE, _, 0) : bump_operate_generation();
        }
        default_action = peek_operate_generation(); size = 4;
    }
    action read_operate_anchor() { md.op_t0_v = op_t0_read.execute(0); }
    action arm_operate_anchor() { md.op_t0_v = op_t0_arm.execute(0); }
    table operate_anchor_access {
        key = { ig_intr_md.ingress_port : ternary; md.event_kind : ternary;
                md.enabled : ternary; md.e_bad : ternary; }
        actions = { read_operate_anchor; arm_operate_anchor; }
        const entries = {
            (t_T_IN, t_KIND_OPERATE, 0, _) : read_operate_anchor();
            (t_T_IN, t_KIND_OPERATE, _, 0) : arm_operate_anchor();
        }
        default_action = read_operate_anchor(); size = 2;
    }
    // ---- ladder dispatch: held originals release or rewait --------------------------------------
    // release_ack touches no register (ack_done_try commits); recording a_commit and outcomes are
    // separate single-register actions called as separate statements at each call site (Tofino:
    // one table/action may address at most one indirect extern).
    // Release only; ack_done_reg was already committed by ack_done_try t_on this same pass.
    // ack_go is read straight from the deltas' sign bits and the three child registers by one ternary
    // table (route_ab_01/b17, b40): "a response child seen in this generation" is one row per child with
    // that child's seen<k>_diff == 0. Rows match in order; no row -> 0.
    // ack_go: this pass may commit the ACK domain (live, and da passed with a child seen, or readiness
    // passed). commit_ok: the genuine-commit case (live, da passed, child seen), which alone records
    // a_commit. Liveness is in the rows, so ack_done_try may run t_on every held-ACK pass and still writes
    // only t_on a live one. Rows match in order; the first row makes "_" mean enabled != 0 below it.
    action set_ack_go(bit<8> go, bit<8> ok) { md.ack_go = go; md.commit_ok = ok; }
    table ack_go_check {
        key = { md.e_bad : ternary; md.enabled : ternary; md.lgen_diff : ternary; md.readiness_delta : ternary;
                md.da_delta : ternary; md.seen0_diff : ternary; md.seen1_diff : ternary;
                md.seen2_diff : ternary; }
        actions = { set_ack_go; }
        const entries = {
            (0, 0, _, _, _, _, _, _) : set_ack_go(0, 0);
            (0, _, 0, _, 32w0 &&& 32w0x80000000, 0, _, _) : set_ack_go(1, 1);
            (0, _, 0, _, 32w0 &&& 32w0x80000000, _, 0, _) : set_ack_go(1, 1);
            (0, _, 0, _, 32w0 &&& 32w0x80000000, _, _, 0) : set_ack_go(1, 1);
            (0, _, 0, 32w0 &&& 32w0x80000000, _, _, _, _) : set_ack_go(1, 0);
        }
        default_action = set_ack_go(0, 0); size = 5;
    }
    action export_held() {
        hdr.tev.setValid(); hdr.tev.epoch = hdr.ladder.budget;
        hdr.tev.wgen = 0; hdr.tev.t0q = 0; hdr.tev.kind = 8w0xe3;
        hdr.tev.stage = 0; hdr.tev.reserved = 0; hdr.ladder.setInvalid();
    }
    action release_ack() {
        export_held();
        ig_tm_md.ucast_egress_port = t_FORWARD_PORT;
    }
    action mark_ack_commit_at() { commit_at_write.execute(0); }
    action mark_ack_commit_gen() { commit_gen_write.execute(0); }
    action read_commit_gen() { md.commit_diff = commit_gen_read.execute(0); }
    table commit_at_access {
        key = { hdr.ladder.role : ternary; md.done_diff : ternary; md.commit_ok : ternary; }
        actions = { mark_ack_commit_at; read_gap_delta; NoAction; }
        const entries = {
            (t_ROLE_ACK_HELD, 0, _) : NoAction();
            (t_ROLE_ACK_HELD, _, 1) : mark_ack_commit_at();
            (t_ROLE_RESP_HELD, _, _) : read_gap_delta();
            (t_ROLE_RESP_BLK, _, _) : read_gap_delta();
        }
        default_action = NoAction(); size = 4;
    }
    table commit_generation_access {
        key = { hdr.ladder.role : ternary; md.done_diff : ternary; md.commit_ok : ternary; }
        actions = { mark_ack_commit_gen; read_commit_gen; NoAction; }
        const entries = {
            (t_ROLE_ACK_HELD, 0, _) : NoAction();
            (t_ROLE_ACK_HELD, _, 1) : mark_ack_commit_gen();
            (t_ROLE_RESP_HELD, _, _) : read_commit_gen();
            (t_ROLE_RESP_BLK, _, _) : read_commit_gen();
        }
        default_action = NoAction(); size = 4;
    }
    action rewait_ack() {
        ig_tm_md.ucast_egress_port = t_HELD_RETURN; ig_tm_md.qid = 6;
        count(t_OUT_HELD_REWAIT);
    }
    action flush_ack_stale() {
        export_held(); ig_tm_md.ucast_egress_port = t_FORWARD_PORT;
        count(t_OUT_HELD_STALE_FLUSH);
    }
    action flush_ack_off() {
        export_held(); ig_tm_md.ucast_egress_port = t_FORWARD_PORT;
        count(t_OUT_HELD_OFF_FLUSH);
    }

    // resp_go = (genuine ACK commit in cur_gen AND a_commit + gap passed) OR readiness passed, as one ternary
    // table (rows match in order; no row -> 0). commit_diff == 0 is "a_commit belongs to this generation"
    // (see ack_commit_gen_reg); the deltas' sign bits stand for "gap / readiness passed". An ACK that
    // finished by readiness fallback has no a_commit, so its response opens by readiness (t_OUT_RESP_FALLBACK).
    action set_resp_go(bit<8> v) { md.resp_go = v; }
    table resp_go_check {
        key = { md.e_bad : ternary; md.enabled : ternary; md.lgen_diff : ternary; md.readiness_delta : ternary;
                md.gap_delta : ternary; md.commit_diff : ternary; md.ack_seen_diff : ternary; md.pb_delta : ternary; }
        actions = { set_resp_go; }
        const entries = {
            (0, 0, _, _, _, _, _, _) : set_resp_go(0);
            (0, _, 0, 32w0 &&& 32w0x80000000, _, _, _, _) : set_resp_go(1);
            (0, _, 0, _, 32w0 &&& 32w0x80000000, 0, _, _) : set_resp_go(1);
            (0, _, 0, _, _, _, 0, _) : set_resp_go(0);                          // a standalone ACK was seen
            (0, _, 0, _, _, _, _, 32w0 &&& 32w0x80000000) : set_resp_go(1);     // piggybacked: t0 + pb passed
        }
        default_action = set_resp_go(0); size = 5;
    }
    // Release only; resp_done_reg was already committed by resp_done_try t_on this same pass.
    action release_response() {
        export_held();
        ig_tm_md.ucast_egress_port = t_FORWARD_PORT;
    }
    action rewait_response() {
        ig_tm_md.ucast_egress_port = t_HELD_RETURN; ig_tm_md.qid = 4;
        count(t_OUT_HELD_REWAIT);
    }
    action flush_response_stale() {
        export_held(); ig_tm_md.ucast_egress_port = t_FORWARD_PORT;
        count(t_OUT_HELD_STALE_FLUSH);
    }
    action flush_response_off() {
        export_held(); ig_tm_md.ucast_egress_port = t_FORWARD_PORT;
        count(t_OUT_HELD_OFF_FLUSH);
    }

    // Release only; op_done_reg was already committed by op_done_try t_on this same pass.
    action release_operate() {
        export_held();
        ig_tm_md.ucast_egress_port = t_RELAY_PORT;
    }
    action rewait_operate() {
        ig_tm_md.ucast_egress_port = t_HB_RETURN; ig_tm_md.qid = 2;
        count(t_OUT_HELD_REWAIT);
    }
    action flush_operate_stale() {
        export_held(); ig_tm_md.ucast_egress_port = t_RELAY_PORT;
        count(t_OUT_HELD_STALE_FLUSH);
    }
    action flush_operate_off() {
        export_held(); ig_tm_md.ucast_egress_port = t_RELAY_PORT;
        count(t_OUT_HELD_OFF_FLUSH);
    }

    action release_ack_commit() { release_ack(); count(t_OUT_ACK_COMMIT); }
    action release_ack_fallback() { release_ack(); count(t_OUT_ACK_FALLBACK); }
    action release_response_counted() { release_response(); count(t_OUT_RESP_RELEASE); }
    action release_response_fallback() { release_response(); count(t_OUT_RESP_FALLBACK); }
    action release_operate_counted() { release_operate(); count(t_OUT_OP_RELEASE); }
    action drop_tin() { ig_dprsr_md.drop_ctl = 1; }
    action drop_old_epoch() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_OLD_EPOCH_DROP); }
    // The duplicate leaves as an OPERATE passthrough: E accepts only provenance kinds it knows.
    action passthrough_operate_dup() { hdr.tev.kind = t_KIND_OPERATE; ig_tm_md.ucast_egress_port = t_RELAY_PORT; }
    action drop_operate_dup() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_OP_DUP_DROP); }
    // op_go: a held OPERATE may commit (live and its deadline passed); op_done_try writes only then.
    action set_op_go(bit<8> v) { md.op_go = v; }
    table op_go_check {
        key = { md.e_bad : ternary; md.enabled : ternary; md.lgen_diff : ternary; md.op_delta : ternary; }
        actions = { set_op_go; }
        const entries = {
            (0, 0, _, _) : set_op_go(0);
            (0, _, 0, 32w0 &&& 32w0x80000000) : set_op_go(1);
        }
        default_action = set_op_go(0); size = 2;
    }
    action drop_exhausted() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_GEN_EXHAUSTED); }
    action unmatched() { ig_dprsr_md.drop_ctl = 1; count(t_OUT_UNMATCHED); }
    // Not T's traffic (front-panel ingress, or a generator-port frame of the wrong format): dropped explicitly,
    // nothing counted, no register touched (every prologue default above only reads).
    action drop_foreign() { ig_dprsr_md.drop_ctl = 1; }

    // ---- verdict tables (route_ab_01/b35) ---------------------------------------------------------
    // Each port's terminal decision is one const-entries ternary table instead of a chain of gateways and
    // one-action tables: bf-p4c ran out of logical tables per stage ("too many tables total", b30..b33).
    // Rows are in the original if/else priority order and the first matching row wins. A row matching
    // 0 t_on a key makes "_" t_on that key mean "!= 0" in every later row of the same role/kind. Keys:
    // lgen_diff == 0 (ladder generation is current), done_diff == 0 (domain already completed in this
    // generation), 32w0 &&& 32w0x80000000 t_on a delta (that deadline has passed), commit_diff == 0
    // (genuine a_commit in this generation), seen<k>_diff == 0 (response child k seen in this generation;
    // one row per child), budget == 0 (blocker budget exhausted).
    table tin_verdict {
        key = { md.event_kind : ternary; md.enabled : ternary; md.e_bad : ternary;
                md.done_diff : ternary; md.dup_diff : ternary;
                hdr.tev.stage : ternary; md.new_gen : ternary; md.op_gen : ternary; }
        actions = { passthrough_tev_relay; passthrough_tev_forward; drop_tin; bypass_request; admit_request;
                    hold_ack; drop_duplicate_response; admit_response; hold_operate; unmatched; drop_old_epoch; drop_exhausted;
                    passthrough_operate_dup; drop_operate_dup; }
        const entries = {
            (t_KIND_OPEN, _, 0, _, _, _, _, _) : passthrough_tev_relay();
            (t_KIND_RESET, _, 32w2, _, _, 1, _, _) : passthrough_tev_relay();
            (t_KIND_RESET, _, 32w2, _, _, 2, _, _) : passthrough_tev_forward();
            (t_KIND_REQUEST, _, 0, _, _, _, 32w0xffff, _) : drop_exhausted();
            (t_KIND_OPERATE, _, 0, _, _, _, _, 32w0xffff) : drop_exhausted();
            (t_KIND_OPERATE, _, 0, _, _, _, 32w0xffff, _) : drop_exhausted();
            (t_KIND_REQUEST, 0, 0, _, _, _, _, _) : passthrough_tev_relay();
            (t_KIND_OPERATE, 0, 0, _, _, _, _, _) : passthrough_tev_relay();
            (t_KIND_OPERATE_DUP, 0, 0, _, _, _, _, _) : passthrough_operate_dup();
            // N's qualified close carries the original close behind the tev (stage = direction, as
            // read_timing.p4 parsed it): forward it once, client close to the relay, server close to the
            // master, whatever md.enabled is. Stage 0 is a synthetic reset with no original: dropped. The
            // generation bump and quarantine are separate tables keyed t_on the kind and still run.
            (t_KIND_RESET, _, 0, _, _, 1, _, _) : passthrough_tev_relay();
            (t_KIND_RESET, _, 0, _, _, 2, _, _) : passthrough_tev_forward();
            (t_KIND_RESET, _, 0, _, _, _, _, _) : drop_tin();
            (_, 0, 0, _, _, _, _, _) : passthrough_tev_forward();

            (t_KIND_REQUEST, _, 0, _, _, _, _, _) : admit_request();
            (t_KIND_ACK, _, 0, _, _, _, _, _) : hold_ack();
            (t_KIND_ACK, _, 0, _, _, _, _, _) : passthrough_tev_forward();
            (t_KIND_RESPONSE, _, 0, 0, _, _, _, _) : passthrough_tev_forward();
            (t_KIND_RESPONSE, _, 0, _, 0, _, _, _) : drop_duplicate_response();
            (t_KIND_RESPONSE, _, 0, _, _, _, _, _) : admit_response();
            (t_KIND_RESPONSE, _, 0, _, _, _, _, _) : passthrough_tev_forward();
            (t_KIND_OPERATE, _, 0, _, _, _, _, _) : hold_operate();
            // done_diff = op_done ^ op_gen (read_op_done): 0 = the current OPERATE was already released.
            (t_KIND_OPERATE_DUP, _, 0, 0, _, _, _, _) : passthrough_operate_dup();
            (t_KIND_OPERATE_DUP, _, 0, _, _, _, _, _) : drop_operate_dup();
        }
        // size = the number of const entries: bf-p4c 9.13 compiles more entries than `size` silently and the
        // driver then fails at device add (route_ab_01/response_only_16/model_01, "Not enough space").
        default_action = drop_old_epoch(); size = 23;
    }
    table token_verdict {
        key = { md.e_bad : ternary; hdr.timer.app_id : ternary; hdr.timer.packet_id : ternary; md.op_tok_diff : ternary;
                md.rd_tok_diff : ternary; hdr.timer.batch_id : ternary; }
        actions = { seed_op_blocker; seed_ack_blocker; seed_resp_blocker; drop_timer_stale; }
        const entries = {
            (_, 1, _, _, _, 16w0xffff) : drop_timer_stale(5w23);
            (_, _, _, _, _, 16w0xffff) : drop_timer_stale(5w24);
            (0, 1, _, 0, _, _) : seed_op_blocker();
            (_, 1, _, _, _, _) : drop_timer_stale(5w23);
            (0, _, 16w0 &&& 16w1, _, 0, _) : seed_ack_blocker();
            (0, _, 16w0 &&& 16w1, _, _, _) : drop_timer_stale(5w24);
            (0, _, _, _, 0, _) : seed_resp_blocker();
        }
        default_action = drop_timer_stale(5w24); size = 7;
    }
    table held_verdict {
        key = { md.e_bad : ternary; hdr.ladder.role : ternary; md.lgen_diff : ternary; md.enabled : ternary; md.done_diff : ternary;
                md.da_delta : ternary; md.readiness_delta : ternary; md.gap_delta : ternary;
                md.commit_diff : ternary; md.seen0_diff : ternary; md.seen1_diff : ternary;
                md.seen2_diff : ternary; hdr.ladder.budget : ternary; }
        actions = { stop_blocking; stop_blocking_stale; stop_blocking_tmo; stop_blocking_off; keep_blocking;
                    release_ack_commit; release_ack_fallback; rewait_ack; flush_ack_stale; flush_ack_off;
                    release_response_counted; release_response_fallback; rewait_response;
                    flush_response_stale; flush_response_off; unmatched; drop_old_epoch; }
        const entries = {
            (0, t_ROLE_ACK_BLK, 0, 0, _, _, _, _, _, _, _, _, _) : stop_blocking_off();
            (0, t_ROLE_ACK_BLK, 0, _, 0, _, _, _, _, _, _, _, _) : stop_blocking();
            (0, t_ROLE_ACK_BLK, 0, _, _, 32w0 &&& 32w0x80000000, _, _, _, 0, _, _, _) : stop_blocking();
            (0, t_ROLE_ACK_BLK, 0, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, 0, _, _) : stop_blocking();
            (0, t_ROLE_ACK_BLK, 0, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, _, 0, _) : stop_blocking();
            (0, t_ROLE_ACK_BLK, 0, _, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, _, _) : stop_blocking();
            (0, t_ROLE_ACK_BLK, 0, _, _, _, _, _, _, _, _, _, 0) : stop_blocking_tmo();
            (0, t_ROLE_ACK_BLK, 0, _, _, _, _, _, _, _, _, _, _) : keep_blocking(t_HELD_RETURN, 7);
            (0, t_ROLE_ACK_BLK, _, _, _, _, _, _, _, _, _, _, _) : stop_blocking_stale();
            (0, t_ROLE_RESP_BLK, 0, 0, _, _, _, _, _, _, _, _, _) : stop_blocking_off();
            (0, t_ROLE_RESP_BLK, 0, _, 0, _, _, _, _, _, _, _, _) : stop_blocking();
            (0, t_ROLE_RESP_BLK, 0, _, _, _, _, 32w0 &&& 32w0x80000000, 0, _, _, _, _) : stop_blocking();
            (0, t_ROLE_RESP_BLK, 0, _, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, _, _) : stop_blocking();
            (0, t_ROLE_RESP_BLK, 0, _, _, _, _, _, _, _, _, _, 0) : stop_blocking_tmo();
            (0, t_ROLE_RESP_BLK, 0, _, _, _, _, _, _, _, _, _, _) : keep_blocking(t_HELD_RETURN, 5);
            (0, t_ROLE_RESP_BLK, _, _, _, _, _, _, _, _, _, _, _) : stop_blocking_stale();
            (0, t_ROLE_ACK_HELD, 0, 0, _, _, _, _, _, _, _, _, _) : flush_ack_off();
            (0, t_ROLE_ACK_HELD, 0, _, 0, _, _, _, _, _, _, _, _) : release_ack_commit();
            (0, t_ROLE_ACK_HELD, 0, _, _, 32w0 &&& 32w0x80000000, _, _, _, 0, _, _, _) : release_ack_commit();
            (0, t_ROLE_ACK_HELD, 0, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, 0, _, _) : release_ack_commit();
            (0, t_ROLE_ACK_HELD, 0, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, _, 0, _) : release_ack_commit();
            (0, t_ROLE_ACK_HELD, 0, _, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, _, _) : release_ack_fallback();
            (0, t_ROLE_ACK_HELD, 0, _, _, _, _, _, _, _, _, _, _) : rewait_ack();
            (0, t_ROLE_ACK_HELD, _, _, _, _, _, _, _, _, _, _, _) : flush_ack_stale();
            (0, t_ROLE_RESP_HELD, 0, 0, _, _, _, _, _, _, _, _, _) : flush_response_off();
            (0, t_ROLE_RESP_HELD, 0, _, 0, _, _, _, _, _, _, _, _) : release_response_counted();
            (0, t_ROLE_RESP_HELD, 0, _, _, _, _, 32w0 &&& 32w0x80000000, 0, _, _, _, _) : release_response_counted();
            (0, t_ROLE_RESP_HELD, 0, _, _, _, 32w0 &&& 32w0x80000000, _, _, _, _, _, _) : release_response_fallback();
            (0, t_ROLE_RESP_HELD, 0, _, _, _, _, _, _, _, _, _, _) : rewait_response();
            (0, t_ROLE_RESP_HELD, _, _, _, _, _, _, _, _, _, _, _) : flush_response_stale();
            (_, _, _, _, _, _, _, _, _, _, _, _, _) : drop_old_epoch();
        }
        default_action = unmatched(); size = 31;
    }
    table hb_verdict {
        key = { md.e_bad : ternary; hdr.ladder.role : ternary; md.lgen_diff : ternary; md.enabled : ternary; md.done_diff : ternary;
                md.op_delta : ternary; hdr.ladder.budget : ternary; }
        actions = { stop_blocking; stop_blocking_stale; stop_blocking_tmo; stop_blocking_off; keep_blocking;
                    release_operate_counted; rewait_operate; flush_operate_stale; flush_operate_off; unmatched; drop_old_epoch; }
        const entries = {
            (0, t_ROLE_OP_BLK, 0, 0, _, _, _) : stop_blocking_off();
            (0, t_ROLE_OP_BLK, 0, _, 0, _, _) : stop_blocking();
            (0, t_ROLE_OP_BLK, 0, _, _, 32w0 &&& 32w0x80000000, _) : stop_blocking();
            (0, t_ROLE_OP_BLK, 0, _, _, _, 0) : stop_blocking_tmo();
            (0, t_ROLE_OP_BLK, 0, _, _, _, _) : keep_blocking(t_HB_RETURN, 3);
            (0, t_ROLE_OP_BLK, _, _, _, _, _) : stop_blocking_stale();
            (0, t_ROLE_OP_HELD, 0, 0, _, _, _) : flush_operate_off();
            (0, t_ROLE_OP_HELD, 0, _, 0, _, _) : rewait_operate();
            (0, t_ROLE_OP_HELD, 0, _, _, 32w0 &&& 32w0x80000000, _) : release_operate_counted();
            (0, t_ROLE_OP_HELD, 0, _, _, _, _) : rewait_operate();
            (0, t_ROLE_OP_HELD, _, _, _, _, _) : flush_operate_stale();
            (_, _, _, _, _, _, _) : drop_old_epoch();
        }
        default_action = unmatched(); size = 12;
    }

    apply {
        ig_tm_md.bypass_egress = 0;
        ig_dprsr_md.mirror_type = t_MIRROR_TYPE_CLONE; md.clone_ses = t_NO_MIRROR_SESSION;   // see t_NO_MIRROR_SESSION
        md.outcome_code = t_OUT_NONE;
        params.apply(); clock.apply(); held_offsets(); op_offset();
        lifetime_access.apply(); gen_access.apply();
        operate_generation_access.apply(); operate_anchor_access.apply();
        t0_access.apply();
        child_seen0_access.apply(); child_seen1_access.apply(); child_seen2_access.apply();
        ack_seen_access.apply();

        if (hdr.clone.isValid()) {   // a clone by content, not by arrival port (a token t_on 196 is not one)
            if (md.event_kind == t_KIND_OPERATE && md.enabled != 0 && md.e_bad == 0) { admit_operate_held(); }
            else { drop_clone(); }
        } else if (ig_intr_md.ingress_port == t_T_IN) {
            // Read only: no op_done write, no op_gen bump, no op_t0 arm, no clone (dup_hold_01).
            if (md.event_kind == t_KIND_OPERATE_DUP && md.e_bad == 0 && md.enabled != 0) { read_op_done(); }
            // Register work first, each under a gateway of at most 40 bits; then one verdict. e_bad is
            // nonzero whenever the policy is off (epoch_access), so no child register is touched then.
            // The child is recorded before resp_done_reg is read (stage-ordering loop, b11): the child
            // registers' only other consumer is the ACK gate (read_seen<k> -> ack_go_check and the ACK
            // roles' verdict rows), which tests only "some child seen in this generation", already true
            // once a response has been released in this generation.
            if (md.event_kind == t_KIND_RESPONSE && md.e_bad == 0 && md.enabled != 0) {
                if (hdr.tev.stage == 0) { md.dup_diff = md.seen0_diff; }
                else if (hdr.tev.stage == 1) { md.dup_diff = md.seen1_diff; }
                else { md.dup_diff = md.seen2_diff; }
            }
            // Its own gateway: resp_done_reg sits in a late stage (resp_done_try t_on the held response), and
            // bf-p4c places a gateway with the first table it guards, so sharing the mask's gateway held
            // everything after it back to that late stage (b36).
            if (md.event_kind == t_KIND_RESPONSE && md.e_bad == 0 && md.enabled != 0) { read_resp_done(); }
            tin_verdict.apply();
        } else if (md.token_ok == 1) {   // a generator token: right port (196 / model 0) AND expected format
            token_diffs();
            token_verdict.apply();
        } else if (ig_intr_md.ingress_port == t_HELD_RETURN) {

            compute_da_delta(); compute_readiness_delta(); compute_pb_delta(); read_lgen_diff();
            // An else-if chain (the roles are exclusive, so the done_diff writes do not order each other),
            // ordered by the stage its first table needs: bf-p4c places each gateway with the first table
            // it guards, and a later gateway in the chain cannot precede an earlier one, so a late branch
            // first (read_resp_done) held every branch after it back to that stage (b36).
            if (hdr.ladder.role == t_ROLE_ACK_HELD) {
                ack_go_check.apply();
                try_ack_done();
                // Genuine commit: live, not already committed in this generation, da passed, child seen.
            } else if (hdr.ladder.role == t_ROLE_ACK_BLK) { read_ack_done(); }
            // Only the response roles read the gap delta and the genuine-commit tag (a held ACK's commit pass
            // must not access ack_commit_at_reg twice, b25). Inside the chain, after the ACK-commit branch,
            // these reads land in the stage of the commit writes they share registers with (b37).
            commit_at_access.apply(); commit_generation_access.apply();
            if (hdr.ladder.role == t_ROLE_RESP_HELD) {
                resp_go_check.apply();
                try_resp_done();
            } else if (hdr.ladder.role == t_ROLE_RESP_BLK) { read_resp_done(); }
            held_verdict.apply();
        } else if (ig_intr_md.ingress_port == t_HB_RETURN) {
            compute_op_t0_masked(); compute_op_delta(); op_lgen_diff();
            if (hdr.ladder.role == t_ROLE_OP_HELD) { op_go_check.apply(); try_op_done(); }
            else if (hdr.ladder.role == t_ROLE_OP_BLK) { read_op_done(); }
            hb_verdict.apply();
        } else { drop_foreign(); }
        outcome_count.apply();
    }
}

control t_IngressDeparser(packet_out pkt, inout t_header_t hdr, in t_metadata_t md,
                       in ingress_intrinsic_metadata_for_deparser_t ig_dprsr_md) {
    // No-arg Mirror(): the typed Mirror(mirror_type) constructor errors "Inconsistent mirror
    // selectors" t_on Tofino-1 (defense4_rrc_bor_unified12.p4, IgDeparser).
    Mirror() clone_mirror;
    apply {
        if (ig_dprsr_md.mirror_type == t_MIRROR_TYPE_CLONE) {
            clone_mirror.emit<t_clone_hdr_t>(md.clone_ses, { md.clone_tag });
        }
        pkt.emit(hdr);
    }
}
#ifndef CASE4_PROBE_SHELL_P4
#define CASE4_PROBE_SHELL_P4
// No target side effects: the shell forwards diagnostic events to ingress port.
parser t_EmptyEgressParser(packet_in pkt, out t_header_t hdr, out t_metadata_t md,
                        out egress_intrinsic_metadata_t eg_intr_md) {
    state start { pkt.extract(eg_intr_md); transition accept; }
}
control t_EmptyEgress(inout t_header_t hdr, inout t_metadata_t md,
                   in egress_intrinsic_metadata_t eg_intr_md,
