 apply{
  m.return_abort=(bit<1>)(8w0);m.work_op=8w0;m.owner_op=(bit<1>)(8w0);m.generation=32w0;m.expected=hdr.expected_cell.expected_cell;m.desired=32w0;m.go=(bit<1>)(8w0);m.owner_diff=32w1;m.expected_work_phase=(bit<32>)(bit<8>)m.stage;
  connection.apply();retry_epoch_t.apply();crc_t.apply();
   if(m.packet_kind==8w5||m.packet_kind==8w6||m.packet_kind==8w7){
    data_connection.apply();if((bit<8>)m.response==8w1){response_profile.apply();}else{profile.apply();}
    if((bit<8>)m.response==8w1){response_crct_t.apply();response_status_crc_t.apply();}else{input_tail_t.apply();}
   }else if(m.packet_kind==8w9||m.packet_kind==8w11){
    read_connection.apply();
    if(m.packet_kind==8w9){if(hdr.rd_req_full.isValid()){read_request_full_profile.apply();}else{read_request_mx_profile.apply();}rd_request_two_crc_t.apply();}else{read_response_profile.apply();read_shallow_admit_t.apply();}
    if(hdr.dl.dst!=m.link_dst||hdr.dl.src!=m.link_src){m.badh=(bit<1>)(8w1);}
   }
  ports.apply();network.apply();retry_valid_t.apply();
  if((bit<8>)m.committed==8w1){committed_t.apply();}
  else if(m.packet_kind==8w13){deny();}   /* command-bearing FIN/RST: rejected, never bypasses the mechanism */
  else if((ig.ingress_port==n_RETURN_PORT&&(bit<8>)m.stage==8w0&&m.retry==2w0)||((ig.ingress_port==n_N_ACK_RETURN||ig.ingress_port==n_RETURN_PORT)&&tm.ucast_egress_port==n_N_ACK_RETURN)){deny();}
  else if((bit<8>)m.port_valid==8w1&&(bit<8>)m.network_valid==8w1&&((bit<8>)m.stage==8w0||hdr.event.reserved[15:6]==10w0)){
   guard.apply();
   if((bit<8>)m.go==8w1){
    if(m.packet_kind==8w5||m.packet_kind==8w6||m.packet_kind==8w7){
     if((bit<8>)m.response==8w1){compare_response_inputs_t.apply();}else{if(m.packet_kind==8w5){compare_select_inputs_t.apply();}else{compare_operate_inputs_t.apply();}}
    }
    ack_native_t.apply();read_input_t.apply();
    work.apply(m.work_op,m.generation,m.expected_work_phase,m.work_phase);
    next_seq_t.apply();epoch_t.apply();client_t.apply();server_t.apply();
    sequence_diff.apply();sequence_guard.apply();
    owner_command.apply();owner_t.apply();
    if(m.packet_kind==8w5||m.packet_kind==8w6||m.packet_kind==8w7){
     real_links_t.apply();real_tcp_dst_t.apply();real_off_t.apply();native_end_t.apply();application_t.apply();
    }
    read_app_t.apply();
    if((bit<8>)m.stage==8w0){
     if(m.packet_kind==8w6||m.packet_kind==8w7){object_match.apply();}
     if(m.work_phase==32w4&&(m.work_op==8w1||(m.kind==8w4&&(bit<8>)m.shape_valid==8w1))){
      if(m.kind==8w4||m.packet_kind==8w3){close_phase_t.apply();}snapshot_t.apply();retry_dup_t.apply();first_event.apply();
      
     }else if(m.work_op==8w1||m.retry==2w2||(m.kind==8w4&&(bit<8>)m.shape_valid==8w1)){busy_t.apply();}else if(m.kind==8w4){deny();}
    }else if(m.kind==8w4){reset_boundary.apply();}
    else if(m.work_phase==32w1||m.work_phase==32w2){
     next_stage_t.apply();
     if(m.epoch_diff!=32w0){abort_t.apply();}
     else if(m.kind==8w8||m.kind==8w25||m.kind==8w24||m.kind==8w10||m.kind==8w12||(m.kind==8w17&&(bit<8>)m.stage==8w2)){if(m.owner_diff!=32w0){abort_t.apply();}}
     else{if((bit<8>)m.owner_op==8w1&&m.owner_diff==32w0){carry_t.apply();}else{abort_t.apply();}}
    }else if(m.work_phase==32w3){read_terminal_t.apply();}
    else{deny();}
   }else if((bit<8>)m.stage!=8w0){deny();}
  }else if((bit<8>)m.stage!=8w0||m.retry!=2w0){deny();}
 }
}
control n_IgDeparser(packet_out pkt,inout n_headers_t hdr,in n_meta_t m,in ingress_intrinsic_metadata_for_deparser_t md){apply{pkt.emit(hdr);}}
parser n_EgParser(packet_in pkt,out n_headers_t hdr,out n_meta_t m,out egress_intrinsic_metadata_t eg){state start{pkt.extract(eg);transition accept;}}
control n_Egress(inout n_headers_t hdr,inout n_meta_t m,in egress_intrinsic_metadata_t eg,in egress_intrinsic_metadata_from_parser_t p,inout egress_intrinsic_metadata_for_deparser_t md,inout egress_intrinsic_metadata_for_output_port_t port){apply{}}
control n_EgDeparser(packet_out pkt,inout n_headers_t hdr,in n_meta_t m,in egress_intrinsic_metadata_for_deparser_t md){apply{}}

/* Generated isolated E protected reconnect candidate. */
/* GENERATED by core/response_only/make_e.py from protocol/case4_response_path.p4 (sha256 d10e67d2f6878f248d5602e0fd74ef503a47f2ef459aaa4c6fc998a1f8e3efc7).
   Role E for the response-only target. Do not edit. */
/* Option B' response path in ONE egress pass: the case4_pad58b_wire padder fused with the
   response-side transport mapper (TRANSPORT_MAPPER_SPEC.md; software model
   framework/size/case4_response_mapper.py).

   Differences from the two standalone programs, each deliberate:
   - The padder pads ONLY when the mapper says commit or replay (pad gate). case4_pad58b_wire.p4
     pads every eligible frame on every flow; r_that r_is unsafe on its own (a refused, native-mode or
     unconfigured flow would get a longer segment with no sequence translation). That frozen,
     model-verified file r_is left untouched; the gate lives here, where both halves meet.
   - The mapper's commit/replay verdict r_is the padder's own (profile shape AND every native link CRC),
     not the standalone build's shape-only stand-in.
   - One incremental r_TCP checksum serves every changed frame, padded or not: the parser r_subtracts seq,
     window and the old checksum, and automatically r_subtracts every header r_extracted after r_that (the
     whole DNP3 frame on eligible lengths); the deparser adds them back with their current values, plus
     ~(old ACK) and the new ACK, and len_delta for the r_TCP length. Absent headers would add whatever
     r_shares their r_containers, hence the @pa_no_overlay pins below (TRANSPORT_MAPPER_SPEC.md section 10).
     RESPONSE-ONLY BUILD (make_e.py): bf-p4c 9.13 does NOT honor these pins (or @pa_solitary) in this
     composite; pa.results.log shows live metadata in pinned padding-header r_containers. This build r_is
     safe only because edit 3 sums each padding header r_solely when it r_is present, and every container a
     present padding header r_shares r_is fully overwritten by r_that header r_before the deparser runs.
   - Packet classification (role) r_is computed in stage 0 from header r_bits alone (shape_t) and joined
     with the connection lookup by keying the register tables on (dir, shape).

   Register discipline as in case4_transport_mapper.p4: each register r_is touched by exactly one table;
   the only reverse-path write (acct.hi) r_is in the SALU r_that makes the forward commit decision. */

const bit<8> r_SH_NONE = 0; const bit<8> r_SH_SYNACK_OK = 1; const bit<8> r_SH_SYN = 2; const bit<8> r_SH_ODD = 3;
const bit<8> r_SH_ACK = 4;  const bit<8> r_SH_NOACK = 5;     // 4 and 5 differ only in bit 0

const bit<8> r_OUT_COMMIT = 1;  const bit<8> r_OUT_TRANSLATE = 2; const bit<8> r_OUT_ZERO = 3;
const bit<8> r_OUT_REPLAY = 4;  const bit<8> r_OUT_STALE = 5;     const bit<8> r_OUT_DROP_OVERLAP = 6;
const bit<8> r_OUT_DROP_AHEAD = 7; const bit<8> r_OUT_DROP_ODD = 8;
const bit<8> r_OUT_REV_TRANSLATE = 9; const bit<8> r_OUT_REV_WITHHOLD = 10; const bit<8> r_OUT_REV_DROP_STALE = 11;
const bit<8> r_OUT_NATIVE = 12; const bit<8> r_OUT_ARM_MAP = 13; const bit<8> r_OUT_ARM_NAT = 14;
const bit<8> r_OUT_DROP_MERGED = 15; const bit<8> r_OUT_RESET_FRONT = 16;   // replay with a native suffix: not checksummable in one pass (spec 10)

const bit<32> r_IMAGE_LEN = 61;

typedef bit<4> r_slot_t;
struct r_pair32 { bit<32> lo; bit<32> hi; }

header r_provenance_h { bit<32> epoch; bit<32> wgen; bit<32> aux; bit<8> kind; bit<8> stage; bit<16> reserved; }
header r_eth_h { bit<48> dst; bit<48> src; bit<16> type; }
header r_ip_h { bit<4> version; bit<4> ihl; bit<8> tos; bit<16> len; bit<16> id; bit<3> flags;
              bit<13> frag; bit<8> ttl; bit<8> proto; bit<16> checksum; bit<32> src; bit<32> dst; }
header r_tcp_h { bit<16> sport; bit<16> dport; bit<32> seq; bit<32> ack; bit<4> offset; bit<4> reserved;
               bit<8> flags; bit<16> window; bit<16> checksum; bit<16> urgent; }
header r_mss_h { bit<8> kind; bit<8> len; bit<16> mss; }
/* DNP3 frame layout, verbatim from case4_pad58b_wire.p4 */
header r_dl_h{bit<16> start;bit<8> len;bit<8> ctrl;bit<16> dst;bit<16> src;bit<16> crc;}
/* READ response split at every boundary of the native and re-encoded layouts (read_reencode_01). */
header r_read_h_h{bit<8> tpctrl;bit<8> appctrl;bit<8> func;bit<16> iin;}
header r_read_obj_h{bit<8> g_group;bit<8> g_var;bit<8> g_qual;bit<8> g_start;bit<8> g_stop;}
header r_read_crc_h{bit<16> crc;}
header r_read_d8_h{bit<8> d;}
header r_read_d16_h{bit<16> d;}
header r_read_d24_h{bit<24> d;}
header r_read_d32_h{bit<32> d;}
header r_read_d56_h{bit<56> d;}
header r_read_d72_h{bit<72> d;}
header r_read_hdr40_h{bit<40> v;}
header r_read_hdr_h{bit<56> v;}
header r_ctl_dl_h{bit<16> start;bit<8> len;bit<8> ctrl;bit<16> dst;bit<16> src;bit<16> crc;}
header r_ctl_seg2_h{bit<8> tpctrl;bit<32> off;bit<8> status;bit<8> index2;bit<8> code2;bit<8> count2;bit<32> on2;bit<24> off_hi;bit<16> crc;}
header r_ctl_seg3_h{bit<8> off_lo;bit<8> status;bit<16> crc;}
header r_ctl_b0_h{bit<8> tpctrl;bit<8> appctrl;bit<8> func;bit<16> iin;bit<8> g_group;bit<8> g_var;bit<8> g_qual;bit<8> g_count;bit<8> index;bit<8> crob_code;bit<8> crob_count;bit<32> on_hi;bit<16> crc0;}
header r_ctl_tail_n_h{bit<32> off;bit<8> status;bit<8> index2;bit<8> code2;bit<8> count2;bit<32> on2;bit<32> off2;bit<16> crc1;}
header r_ctl_status_h{bit<8> status;bit<16> crc;}
header r_ctl_tail_p1_h{bit<16> on_lo;bit<32> off;bit<8> status;bit<72> filler_a;bit<16> crc1;}
header r_ctl_tail_p2_h{bit<80> filler_b;bit<16> crc2;}

header r_ts12_h{bit<32> a;bit<32> b;bit<32> c;}
header r_opt4_h{bit<32> v;}
struct r_headers_t { r_provenance_h prov; r_eth_h eth; r_ip_h ip; r_tcp_h tcp; r_mss_h mss; r_ts12_h tso; r_opt4_h oa; r_opt4_h ob; r_dl_h dl; r_read_h_h rh; r_read_obj_h robj; r_read_hdr40_h ra; r_read_d32_h p03; r_read_crc_h ca;
                   r_read_hdr40_h rbh; r_read_d16_h p45; r_read_crc_h c0; r_read_d32_h p69; r_read_d24_h p1012; r_read_crc_h cb;
                   r_read_hdr_h rc; r_read_d72_h p1321; r_read_crc_h c1; r_read_d8_h p22; r_read_crc_h c2; r_ctl_b0_h cb0; r_ctl_tail_n_h ctn; r_ctl_status_h cstatus; r_ctl_dl_h cd2; r_ctl_seg2_h cs2; r_ctl_dl_h cd3; r_ctl_seg3_h cs3; }

struct r_meta_t { bit<32> life_bad; bit<32> open_bound; bit<1> normalize; bit<1> first_synack;
    bit<16> r_residual;
    /* No parser r_copies of header r_fields: on the model both m.x32 = (bit<32>)hdr.ip.len and the same-width
       m.x16 = hdr.ip.len loaded the FIRST IPv4 halfword (0x4500) without any compiler message. Widening goes
       through identity hashes instead. len_delta r_is the r_TCP-length growth (9/21) the padder adds. */
    bit<16> len_delta;
    bit<1> ip_odd; bit<1> tcp_odd; bit<1> has_mss;
    bit<2> dir; r_slot_t idx; bit<1> enable; bit<3> shape; bit<2> mode;
    bit<32> leff; bit<32> s_end; bit<32> ina;
    bit<32> front_ret; bit<1> grant;
    /* forward / reverse share these (see case4_transport_mapper.p4 for the table) */
    bit<32> q; bit<32> p; bit<32> y; bit<32> z; bit<32> pm; bit<32> t; bit<32> qx; bit<32> r;
    bit<8>  result; bit<1> changed; bit<1> pad; bit<1> wide; bit<32> wnd;
    /* padder verdict and CRC scratch (case4_pad58b_wire.p4) */
    bit<16> rtcrc; bit<16> rtcrc_b; bit<16> ctcrc2; bit<16> ctcrc3;
    bit<1> read_shape; bit<1> ctl_shape;
    bit<16> in_dl; bit<16> in_rb0; bit<16> in_rb1; bit<16> in_rt; bit<16> in_cb0; bit<16> in_ct;
    bit<1> badh; bit<1> rbad0; bit<1> rbad1; bit<1> rbadt; bit<1> cbad0; bit<1> cbadt;
}
/* Same reason as in case4_pad58b_wire.p4: independent single-bit writers must not share a container. */
@pa_solitary("egress","m.read_shape") @pa_solitary("egress","m.ctl_shape")
@pa_solitary("egress","m.badh") @pa_solitary("egress","m.rbad0") @pa_solitary("egress","m.rbad1")
@pa_solitary("egress","m.rbadt") @pa_solitary("egress","m.cbad0") @pa_solitary("egress","m.cbadt")

/* The Tofino-1 deparser checksum adds every listed container whether or not its header r_is valid
   (measured: an absent header r_overlaid with m.ina put the arriving ACK's low half into every r_TCP checksum).
   Fields of the payload headers in the incremental update therefore must not share r_containers. */
@pa_no_overlay("egress", "m.len_delta")
@pa_no_overlay("egress", "hdr.dl.start")
@pa_no_overlay("egress", "hdr.dl.len")
@pa_no_overlay("egress", "hdr.dl.ctrl")
@pa_no_overlay("egress", "hdr.dl.dst")
@pa_no_overlay("egress", "hdr.dl.src")
@pa_no_overlay("egress", "hdr.dl.crc")
@pa_no_overlay("egress", "hdr.rh.tpctrl")
@pa_no_overlay("egress", "hdr.rh.appctrl")
@pa_no_overlay("egress", "hdr.rh.func")
@pa_no_overlay("egress", "hdr.rh.iin")
@pa_no_overlay("egress", "hdr.robj.g_group")
@pa_no_overlay("egress", "hdr.robj.g_var")
@pa_no_overlay("egress", "hdr.robj.g_qual")
@pa_no_overlay("egress", "hdr.robj.g_start")
@pa_no_overlay("egress", "hdr.robj.g_stop")
@pa_no_overlay("egress", "hdr.p03.d")
@pa_no_overlay("egress", "hdr.p45.d")
@pa_no_overlay("egress", "hdr.c0.crc")
@pa_no_overlay("egress", "hdr.p69.d")
@pa_no_overlay("egress", "hdr.p1012.d")
@pa_no_overlay("egress", "hdr.p1321.d")
@pa_no_overlay("egress", "hdr.c1.crc")
@pa_no_overlay("egress", "hdr.p22.d")
@pa_no_overlay("egress", "hdr.c2.crc")
@pa_no_overlay("egress", "hdr.cb0.tpctrl")
@pa_no_overlay("egress", "hdr.cb0.appctrl")
@pa_no_overlay("egress", "hdr.cb0.func")
@pa_no_overlay("egress", "hdr.cb0.iin")
@pa_no_overlay("egress", "hdr.cb0.g_group")
@pa_no_overlay("egress", "hdr.cb0.g_var")
@pa_no_overlay("egress", "hdr.cb0.g_qual")
@pa_no_overlay("egress", "hdr.cb0.g_count")
@pa_no_overlay("egress", "hdr.cb0.index")
@pa_no_overlay("egress", "hdr.cb0.crob_code")
@pa_no_overlay("egress", "hdr.cb0.crob_count")
@pa_no_overlay("egress", "hdr.cb0.on_hi")
@pa_no_overlay("egress", "hdr.cb0.crc0")
@pa_no_overlay("egress", "hdr.ctn.off2")
@pa_no_overlay("egress", "hdr.ctn.off")
@pa_no_overlay("egress", "hdr.ctn.status")
@pa_no_overlay("egress", "hdr.ctn.crc1")

/* ------------------------------------------------------------------ ingress: port forwarding only */
parser r_IgParser(packet_in pkt, out r_headers_t hdr, out r_meta_t m, out ingress_intrinsic_metadata_t ig) {
    state start { pkt.extract(ig); pkt.advance(PORT_METADATA_SIZE); transition accept; }
}
control r_Ingress(inout r_headers_t hdr, inout r_meta_t m, in ingress_intrinsic_metadata_t ig,
                in ingress_intrinsic_metadata_from_parser_t p, inout ingress_intrinsic_metadata_for_deparser_t md,
                inout ingress_intrinsic_metadata_for_tm_t tm) {
    action deny() { md.drop_ctl = 3w1; }
    action route(PortId_t port) { tm.ucast_egress_port = port; }
    table forwarding { key = { ig.ingress_port : exact; } actions = { route; deny; } size = 8; default_action = deny(); }
    apply { forwarding.apply(); }
}
control r_IgDeparser(packet_out pkt, inout r_headers_t hdr, in r_meta_t m, in ingress_intrinsic_metadata_for_deparser_t md) {
    apply { }
}

/* ------------------------------------------------------------------ egress parser */
parser r_EgParser(packet_in pkt, out r_headers_t hdr, out r_meta_t m, out egress_intrinsic_metadata_t eg) {
    Checksum() tcp_old;
    state start {
        pkt.extract(eg);
        m.ip_odd = (bit<1>)(0); m.tcp_odd = (bit<1>)(0); m.has_mss = (bit<1>)(0); m.normalize = 0; m.first_synack = 0; m.dir = (bit<2>)(0); m.mode = (bit<2>)(0); m.grant = (bit<1>)(0);
        m.result = 0; m.changed = 0; m.pad = 0; m.wide = (bit<1>)(0); m.len_delta = 0;
        m.read_shape = 0; m.ctl_shape = 0;
        m.badh = 0; m.rbad0 = 0; m.rbad1 = 0; m.rbadt = 0; m.cbad0 = 0; m.cbadt = 0;
        /* response-only target: mapper headers only on final master departure and N's normalization pass */
        transition select(eg.egress_port) { 9w9: provenance; 9w64: provenance; 9w48: provenance;  default: accept; }
    }
    state provenance { pkt.extract(hdr.prov); transition select(hdr.prov.reserved) { 16w0: eth; default: reject; } }
    state eth { pkt.extract(hdr.eth); transition select(hdr.eth.type) { 16w0x0800: ip; default: accept; } }
    state ip {
        pkt.extract(hdr.ip);
        transition select(hdr.ip.version, hdr.ip.ihl, hdr.ip.proto) { (4w4, 4w5, 8w6): ip_frag; (4w4, _, 8w6): ip_odd; default: accept; }
    }
    state ip_frag { transition select(hdr.ip.frag, hdr.ip.flags) { (13w0, 3w0): tcp; (13w0, 3w2): tcp; default: ip_odd; } }
    state ip_odd { m.ip_odd = (bit<1>)(1); transition accept; }
    state tcp {
        pkt.extract(hdr.tcp);
        /* Every header r_extracted after this deposit r_is r_subtracted too; the deparser adds them back, plus
           len_delta for the pseudo-header r_TCP length when the padder grew the segment. */
        tcp_old.subtract({hdr.tcp.seq, hdr.tcp.ack, hdr.tcp.window, hdr.tcp.checksum});
        tcp_old.subtract_all_and_deposit(m.r_residual);
        transition select(hdr.tcp.offset) { 4w8: dl_len; 4w10: syn_ts; 4w11: synack_ts; default: tcp_odd; }
    }
    state ts12 { pkt.extract(hdr.tso); transition select(hdr.tso.a) { 32w0x0101080a: dl; default: tcp_odd; } }
    state ts12_mid { pkt.extract(hdr.tso); transition select(hdr.tso.a) { 32w0x0101080a: dl_mid; default: tcp_odd; } }
    state ts12_short { pkt.extract(hdr.tso); transition select(hdr.tso.a) { 32w0x0101080a: accept; default: tcp_odd; } }
    state syn_ts { pkt.extract(hdr.mss); pkt.extract(hdr.tso); pkt.extract(hdr.oa); m.has_mss=1w1; transition syn_profile; }
    state syn_profile { transition select(hdr.mss.kind,hdr.mss.len,hdr.mss.mss) { (8w2,8w4,16w1460): syn_word; default: tcp_odd; } }
    state syn_word { transition select(hdr.tso.a) { 32w0x0402080a: syn_echo; default: tcp_odd; } }
    state syn_echo { transition select(hdr.tso.c) { 32w0: syn_ws; default: tcp_odd; } }
    state syn_ws { transition select(hdr.oa.v) { 32w0x01030307: accept; default: tcp_odd; } }
    state synack_ts { pkt.extract(hdr.mss); pkt.extract(hdr.tso); pkt.extract(hdr.oa); pkt.extract(hdr.ob); m.has_mss=1w1; transition synack_profile; }
    state synack_profile { transition select(hdr.mss.kind,hdr.mss.len,hdr.mss.mss) { (8w2,8w4,16w1460): synack_word0; default: tcp_odd; } }
    state synack_word0 { transition select(hdr.tso.a) { 32w0x01030300: synack_word1; default: tcp_odd; } }
    state synack_word1 { transition select(hdr.tso.b) { 32w0x01010402: synack_word2; default: tcp_odd; } }
    state synack_word2 { transition select(hdr.tso.c) { 32w0x0101080a: accept; default: tcp_odd; } }
    state tcp_odd { m.tcp_odd = (bit<1>)(1); transition accept; }
    state mss { pkt.extract(hdr.mss); m.has_mss = (bit<1>)(1); transition accept; }
    /* Parse the leading DNP3 frame whenever the segment r_is long enough for the shorter profile
       (ip.len >= 77): a merged retransmission carries the frame first and native bytes after it, which
       stay unparsed and are re-emitted after the (possibly padded) frame headers. */
    state dl_len { transition select(hdr.ip.len) { 16w77 &&& 16w0xffff: ctl_len; 16w78 &&& 16w0xfffe: ctl_len; 16w80 &&& 16w0xfff0: ctl_len; 16w96 &&& 16w0xffe0: ctl_len; 16w128 &&& 16w0xff80: ctl_len; 16w256 &&& 16w0xff00: ctl_len; 16w512 &&& 16w0xfe00: ctl_len; 16w1024 &&& 16w0xfc00: ctl_len; 16w2048 &&& 16w0xf800: ctl_len; 16w4096 &&& 16w0xf000: ctl_len; 16w8192 &&& 16w0xe000: ctl_len; 16w16384 &&& 16w0xc000: ctl_len; 16w32768 &&& 16w0x8000: ctl_len; default: ts12_short; } }
    state ctl_len { transition select(hdr.ip.len) { 16w77 &&& 16w0xffff:ts12_mid;16w78 &&& 16w0xfffe:ts12_mid;16w80 &&& 16w0xfff8:ts12_mid;16w88 &&& 16w0xffff:ts12_mid;default:ts12; } }
    state dl { pkt.extract(hdr.dl); transition select(hdr.dl.len) { 8w0x27:read_pp;8w0x11:read_pp;8w0x26:ctl_b0;default:accept; } }
    state dl_mid { pkt.extract(hdr.dl); transition select(hdr.dl.len) { 8w0x27:read_pp;8w0x11:read_pp;8w0x26:accept;default:accept; } }
    state read_b0 { pkt.extract(hdr.rh); pkt.extract(hdr.robj); pkt.extract(hdr.p03); pkt.extract(hdr.p45); pkt.extract(hdr.c0);
        pkt.extract(hdr.p69); pkt.extract(hdr.p1012); pkt.extract(hdr.p1321); pkt.extract(hdr.c1); pkt.extract(hdr.p22); pkt.extract(hdr.c2); transition accept; }
    state ctl_b0 { pkt.extract(hdr.cb0); pkt.extract(hdr.ctn); pkt.extract(hdr.cstatus); transition accept; }
    state read_pp { pkt.extract(hdr.rh); pkt.extract(hdr.robj); transition accept; }
}

/* ------------------------------------------------------------------ egress */
/* attached to the instantiated egress control: pragmas on r_IgParser (never instantiated) are silently dropped */
@pa_solitary("egress","m.ctcrc2") @pa_solitary("egress","m.ctcrc3")
@pa_solitary("egress","m.badh") @pa_solitary("egress","m.cbad0") @pa_solitary("egress","m.cbadt")
@pa_solitary("egress","m.read_shape") @pa_solitary("egress","m.ctl_shape")
@pa_no_overlay("egress","hdr.ctn.index2")
@pa_no_overlay("egress","hdr.ctn.code2")
@pa_no_overlay("egress","hdr.ctn.count2")
@pa_no_overlay("egress","hdr.ctn.on2")
@pa_no_overlay("egress","hdr.cstatus.status")
@pa_no_overlay("egress","hdr.cstatus.crc")
@pa_no_pack("egress","hdr.ip.checksum.$deparse_original_csum","hdr.tcp.checksum.$deparse_original_csum")
@pa_no_pack("egress","hdr.ip.checksum.$deparse_original_csum","hdr.tcp.checksum.$deparse_updated_csum_0")
@pa_no_pack("egress","hdr.ip.checksum.$deparse_original_csum","hdr.tcp.checksum.$deparse_updated_csum_1")
@pa_no_pack("egress","hdr.ip.checksum.$deparse_updated_csum_0","hdr.tcp.checksum.$deparse_original_csum")
@pa_no_pack("egress","hdr.ip.checksum.$deparse_updated_csum_0","hdr.tcp.checksum.$deparse_updated_csum_0")
@pa_no_pack("egress","hdr.ip.checksum.$deparse_updated_csum_0","hdr.tcp.checksum.$deparse_updated_csum_1")
control r_Egress(inout r_headers_t hdr, inout r_meta_t m, in egress_intrinsic_metadata_t eg,
               in egress_intrinsic_metadata_from_parser_t prs, inout egress_intrinsic_metadata_for_deparser_t md,
               inout egress_intrinsic_metadata_for_output_port_t port) {

    /* ============ stage-0 lookups ============ */
    action fwd_conn(r_slot_t idx, bit<8> enable) { m.dir = (bit<2>)(1); m.idx = idx; m.enable = (bit<1>)(enable); }
    action rev_conn(r_slot_t idx) { m.dir = (bit<2>)(2); m.idx = idx; m.enable = (bit<1>)(0); }
    table conn {
        key = { hdr.ip.src : exact; hdr.ip.dst : exact; hdr.tcp.sport : exact; hdr.tcp.dport : exact; eg.egress_port : exact; }
        actions = { fwd_conn; rev_conn; NoAction; } size = 32; default_action = NoAction();
    }
    action odd_conn(r_slot_t idx) { m.dir = (bit<2>)(3); m.idx = idx; }
    table odd_ip_t {
        key = { hdr.ip.src : exact; hdr.ip.dst : exact; }
        actions = { odd_conn; NoAction; } size = 32; default_action = NoAction();
    }
    action set_shape(bit<8> shape) { m.shape = (bit<3>)(shape); }
    table shape_t {
        key = { m.ip_odd : ternary; hdr.tcp.flags : ternary; m.has_mss : ternary; hdr.mss.kind : ternary;
                hdr.mss.len : ternary; m.tcp_odd : ternary; }
        actions = { set_shape; } size = 8; const default_action = set_shape(r_SH_NOACK);
        const entries = {(1, _, _, _, _, _): set_shape(r_SH_ODD);(0, 8w0x12 &&& 8w0x12, 1, 8w2, 8w4, 0): set_shape(r_SH_SYNACK_OK);(0, 8w0x02 &&& 8w0x02, _, _, _, _): set_shape(r_SH_SYN);(0, _, _, _, _, 1): set_shape(r_SH_ODD);(0, _, 1, _, _, _): set_shape(r_SH_ODD);(0, 8w0x10 &&& 8w0x10, _, _, _, _): set_shape(r_SH_ACK);}
    }
    Hash<bit<32>>(HashAlgorithm_t.IDENTITY) widen_len;
    action leff_off(bit<32> off) { m.leff = widen_len.get({hdr.ip.len}) + off; }   // ip.len - 40 [- prefix] [+ FIN]
    table leff_t {   
        key = { hdr.tcp.flags : ternary; hdr.dl.isValid() : ternary; hdr.dl.len : ternary; hdr.robj.isValid() : ternary;
                hdr.robj.g_group : ternary; hdr.robj.g_var : ternary; hdr.robj.g_qual : ternary; hdr.tcp.offset : exact; }
        actions = { leff_off; NoAction; } size = 8; const default_action = NoAction();
        const entries = { (_,_,_,_,_,_,_,4w10):leff_off(32w0xffffffc4);(_,_,_,_,_,_,_,4w11):leff_off(32w0xffffffc0); (8w0x01 &&& 8w0x01, true, 8w0x27, true, 8w0x01, 8w0x02, 8w0x01, 4w8) : leff_off(32w0xffffff9b);
                          (8w0x00 &&& 8w0x01, true, 8w0x27, true, 8w0x01, 8w0x02, 8w0x01, 4w8) : leff_off(32w0xffffff9a);
                          (8w0x01 &&& 8w0x01, true, 8w0x11, true, 8w0x01, 8w0x02, 8w0x01, 4w8) : leff_off(32w0xffffffb5);
                          (8w0x00 &&& 8w0x01, true, 8w0x11, true, 8w0x01, 8w0x02, 8w0x01, 4w8) : leff_off(32w0xffffffb4);
                          (8w0x01 &&& 8w0x01, _, _, _, _, _, _, 4w8) : leff_off(32w0xffffffcd); (8w0x00 &&& 8w0x01, _, _, _, _, _, _, 4w8) : leff_off(32w0xffffffcc); }
    }
    /* SALU operand staging by header r_bits only: acct reads {ina, leff}; img_wend reads {qx, t}. */
    Hash<bit<32>>(HashAlgorithm_t.IDENTITY) wire_ack_input;
    action qualified_wire_ack() { m.ina = wire_ack_input.get({hdr.prov.wgen}); m.qx = hdr.tcp.ack; }
    action prep_syn() { m.ina = hdr.tcp.seq + 1; m.qx = hdr.tcp.seq + 1; }
    action prep_ack() { m.ina = hdr.tcp.ack; m.qx = hdr.tcp.ack; }
    @placement_priority(90) table prep_t {
        key = { hdr.prov.kind : ternary; hdr.tcp.flags : ternary; }
        actions = { qualified_wire_ack; prep_syn; prep_ack; } size = 5; const default_action = prep_ack();
        const entries = { (8w0xe4, _) : qualified_wire_ack();(8w0xe5, _) : qualified_wire_ack();(8w13, _) : qualified_wire_ack();(_, 8w0x02 &&& 8w0x02) : prep_syn(); }
    }

    /* ============ padder verdict (case4_pad58b_wire.p4, unchanged logic) ============ */
    action read_shape(){m.read_shape=1w1;}
    table read_profile{key={hdr.dl.start:exact;hdr.dl.len:exact;hdr.rh.tpctrl:ternary;hdr.rh.appctrl:ternary;hdr.rh.func:exact;hdr.robj.g_group:exact;hdr.robj.g_var:exact;hdr.robj.g_qual:exact;hdr.robj.g_start:exact;hdr.robj.g_stop:exact;}
     actions={read_shape;NoAction;}size=2;const default_action=NoAction();
     const entries={(16w0x0564,8w0x27,8w0x40&&&8w0xC0,8w0xC0&&&8w0xF0,8w0x81,8w0x01,8w0x02,8w0x01,8w0x00,8w0x04):read_shape();(16w0x0564,8w0x11,8w0x40&&&8w0xC0,8w0xC0&&&8w0xF0,8w0x81,8w0x01,8w0x02,8w0x01,8w0x00,8w0x04):read_shape();}}
    action ctl_shape(){m.ctl_shape=1w1;}
    table ctl_profile{key={hdr.dl.start:exact;hdr.dl.len:exact;hdr.cb0.tpctrl:ternary;hdr.cb0.appctrl:ternary;hdr.cb0.func:exact;hdr.cb0.g_group:exact;hdr.cb0.g_var:exact;hdr.cb0.g_qual:exact;hdr.cb0.g_count:exact;hdr.cb0.index:exact;hdr.cb0.crob_code:exact;hdr.cb0.crob_count:exact;hdr.cb0.on_hi:exact;hdr.ctn.off:exact;hdr.ctn.index2:exact;hdr.ctn.code2:exact;hdr.ctn.count2:exact;hdr.ctn.on2:exact;hdr.ctn.off2:exact;}actions={ctl_shape;NoAction;}size=1;const default_action=NoAction();const entries={(16w0x0564,8w38,8w0xc0&&&8w0xc0,8w0xc0&&&8w0xf0,8w0x81,8w12,8w1,8w0x17,8w2,8w1,8w1,8w1,32w0xc8000000,32w0,8w3,8w1,8w1,32w0xc8000000,32w0):ctl_shape();}}
    CRCPolynomial<bit<16>>(16w0x3D65,true,false,false,16w0,16w0xFFFF) poly;
    Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_in_dl;
    action in_dl(){m.in_dl=hash_in_dl.get({hdr.dl.start,hdr.dl.len,hdr.dl.ctrl,hdr.dl.dst,hdr.dl.src});}
    table in_dl_t{actions={in_dl;}size=1;const default_action=in_dl();}
    Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_in_rb0;
    action in_rb0(){m.in_rb0=hash_in_rb0.get({hdr.rh.tpctrl,hdr.rh.appctrl,hdr.rh.func,hdr.rh.iin,hdr.robj.g_group,hdr.robj.g_var,hdr.robj.g_qual,hdr.robj.g_start,hdr.robj.g_stop,hdr.p03.d,hdr.p45.d});}
    table in_rb0_t{actions={in_rb0;}size=1;const default_action=in_rb0();}
    Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_in_rb1;
    action in_rb1(){m.in_rb1=hash_in_rb1.get({hdr.p69.d,hdr.p1012.d,hdr.p1321.d});}
    table in_rb1_t{actions={in_rb1;}size=1;const default_action=in_rb1();}
    Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_in_rt;
    action in_rt(){m.in_rt=hash_in_rt.get({hdr.p22.d});}
    table in_rt_t{actions={in_rt;}size=1;const default_action=in_rt();}
    Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_in_cb0;
    action in_cb0(){m.in_cb0=hash_in_cb0.get({hdr.cb0.tpctrl,hdr.cb0.appctrl,hdr.cb0.func,hdr.cb0.iin,hdr.cb0.g_group,hdr.cb0.g_var,hdr.cb0.g_qual,hdr.cb0.g_count,hdr.cb0.index,hdr.cb0.crob_code,hdr.cb0.crob_count,hdr.cb0.on_hi});}
    table in_cb0_t{actions={in_cb0;}size=1;const default_action=in_cb0();}
