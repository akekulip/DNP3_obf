 action available(){m.work_op=8w1;}
 table available_t{key={m.generation:exact;}actions={available;NoAction;}size=1;const entries={32w0:NoAction();}const default_action=available();}
 Register<bit<32>,bit<1>>(1,0) epoch;
 RegisterAction<bit<32>,bit<1>,bit<32>>(epoch) read_epoch={void apply(inout bit<32> v,out bit<32> r){r=v;}};
 RegisterAction<bit<32>,bit<1>,bit<32>>(epoch) read_epoch_diff={void apply(inout bit<32> v,out bit<32> r){r=v-hdr.envelope.epoch;}};
 RegisterAction<bit<32>,bit<1>,bit<32>>(epoch) write_epoch={void apply(inout bit<32> v,out bit<32> r){if(v==hdr.origin.normalized_epoch){v=hdr.envelope.epoch;r=32w0;}else{r=32w1;}}};
 action load_epoch(){m.epoch=read_epoch.execute(1w0);}
 action diff_epoch(){m.epoch_diff=read_epoch_diff.execute(1w0);}
 action store_epoch(){m.epoch_diff=write_epoch.execute(1w0);}
 Register<bit<32>,bit<1>>(1,0) retry_epoch;
 RegisterAction<bit<32>,bit<1>,bit<2>>(retry_epoch) check_retry_epoch={void apply(inout bit<32> v,out bit<2> r){if(v==hdr.envelope.epoch){r=2w1;}else{r=2w2;}}};
 RegisterAction<bit<32>,bit<1>,bit<2>>(retry_epoch) note_retry_epoch={void apply(inout bit<32> v,out bit<2> r){v=hdr.envelope.epoch;r=2w0;}};
 RegisterAction<bit<32>,bit<1>,bit<2>>(retry_epoch) clear_retry_epoch={void apply(inout bit<32> v,out bit<2> r){if(v==hdr.envelope.epoch){v=32w0;}r=2w0;}};
 action retry_epoch_check(){m.retry=check_retry_epoch.execute(1w0);}
 action retry_epoch_note(){note_retry_epoch.execute(1w0);}
 action retry_epoch_clear(){clear_retry_epoch.execute(1w0);}
 table retry_epoch_t{key={m.stage:exact;m.kind:exact;m.retry:exact;hdr.origin.normalized_epoch[15:0]:ternary;}actions={retry_epoch_check;retry_epoch_note;retry_epoch_clear;NoAction;}size=5;const default_action=NoAction();const entries={(2w0,8w0,2w1,_):retry_epoch_check();(2w2,8w1,2w0,_):retry_epoch_note();(2w2,8w4,2w0,16w0x200):retry_epoch_clear();(2w2,8w4,2w0,16w0x10f):retry_epoch_clear();(2w2,8w17,2w0,16w0x10f):retry_epoch_clear();}}
 action retry_mark_stale(){m.retry=2w2;}
 table retry_valid_t{key={m.retry:exact;m.direction:ternary;hdr.expected_cell.expected_cell:ternary;}actions={retry_mark_stale;NoAction;}size=7;const default_action=retry_mark_stale();
 const entries={(2w0,_,_):NoAction();(2w2,_,_):NoAction();(2w1,_,32w0):retry_mark_stale();(2w1,2w2,32w0&&&32w0xffffffe0):NoAction();(2w1,2w2,32w32):NoAction();(2w1,2w1,32w0&&&32w0xffffffe0):NoAction();(2w1,2w1,32w32):NoAction();}}
 table epoch_t{key={m.stage:ternary;m.kind:ternary;m.work_phase:ternary;m.work_op:ternary;}actions={load_epoch;diff_epoch;store_epoch;}size=3;
 const entries={(2w1,8w1,32w1,8w2):store_epoch();(2w0,_,_,_):load_epoch();}const default_action=diff_epoch();}
 Register<bit<32>,bit<1>>(1,0) client;
 RegisterAction<bit<32>,bit<1>,bit<32>>(client) read_client={void apply(inout bit<32> v,out bit<32> r){r=v;}};
 RegisterAction<bit<32>,bit<1>,bit<32>>(client) write_client={void apply(inout bit<32> v,out bit<32> r){r=v;v=m.new_seq;}};
 action load_client(){m.client=read_client.execute(1w0);}
 action store_client(){m.client=write_client.execute(1w0);}
 table client_t{key={m.stage:exact;m.kind:exact;m.work_phase:exact;m.work_op:exact;m.epoch_diff:exact;}actions={load_client;store_client;}size=4;
 const entries={(2w1,8w1,32w1,8w2,32w0):store_client();(2w1,8w5,32w1,8w2,32w0):store_client();(2w1,8w7,32w1,8w2,32w0):store_client();(2w1,8w9,32w1,8w2,32w0):store_client();}const default_action=load_client();}
 Register<bit<32>,bit<1>>(1,0) server;
 RegisterAction<bit<32>,bit<1>,bit<32>>(server) read_server={void apply(inout bit<32> v,out bit<32> r){r=v;}};
 RegisterAction<bit<32>,bit<1>,bit<32>>(server) write_server={void apply(inout bit<32> v,out bit<32> r){r=v;v=m.new_seq;}};
 action load_server(){m.server=read_server.execute(1w0);}
 action store_server(){m.server=write_server.execute(1w0);}
 table server_t{key={m.stage:exact;m.kind:exact;m.work_phase:exact;m.work_op:exact;m.epoch_diff:exact;}actions={load_server;store_server;}size=4;
 const entries={(2w1,8w2,32w1,8w2,32w0):store_server();(2w1,8w6,32w1,8w2,32w0):store_server();(2w1,8w11,32w1,8w2,32w0):store_server();(2w1,8w16,32w1,8w2,32w0):store_server();}const default_action=load_server();}
 action next_seq(){m.new_seq=hdr.tcp.seq+32w1;m.next_owner_gen=hdr.expected_cell.expected_cell+32w1;}
 action next_control(){m.new_seq=hdr.tcp.seq+32w45;}
 action next_response(){m.new_seq=hdr.tcp.seq+32w49;}
 action next_read_request(){m.new_seq=hdr.tcp.seq+32w20;}
 action next_read_response(){m.new_seq=hdr.tcp.seq+32w49;}
 action next_read_len(bit<32> n){m.new_seq=hdr.tcp.seq+n;}
 table next_seq_t{key={m.packet_kind:exact;hdr.dl.len:ternary;}actions={next_seq;next_control;next_response;next_read_request;next_read_response;next_read_len;}size=10;const entries={(8w5,_):next_control();(8w7,_):next_control();(8w6,_):next_response();(8w9,8w0x14):next_read_len(27);(8w9,8w0x12):next_read_len(25);(8w11,8w0x4c):next_read_len(91);(8w11,8w0x73):next_read_len(134);(8w9,_):next_read_request();(8w11,_):next_read_response();}const default_action=next_seq();}
 action diff_syn(){m.client_diff=hdr.tcp.ack;m.server_diff=m.new_seq-m.client;}
 action diff_synack(){m.client_diff=hdr.tcp.ack-m.client;m.server_diff=m.new_seq-m.server;}
 action diff_forward(){m.client_diff=hdr.tcp.seq-m.client;m.server_diff=hdr.tcp.ack-m.server;}
 action diff_reverse(){m.client_diff=hdr.tcp.seq-m.server;m.server_diff=hdr.tcp.ack-m.client;}
 action diff_reset_forward(){m.client_diff=hdr.tcp.seq-m.client;m.server_diff=32w0;}
 action diff_reset_reverse(){m.client_diff=hdr.tcp.seq-m.server;m.server_diff=32w0;}
 action ack_native(){m.ack_native=hdr.tcp.ack;}
 table ack_native_t{actions={ack_native;}size=1;const default_action=ack_native();}
 action diff_response(){m.client_diff=m.ack_native-m.client;m.server_diff=hdr.tcp.seq-m.server;}
 action diff_read_response(){m.client_diff=hdr.tcp.ack-m.client;m.server_diff=hdr.tcp.seq-m.server;}
 table sequence_diff{key={m.packet_kind:ternary;m.direction:ternary;hdr.tcp.flags:ternary;}
 actions={diff_syn;diff_synack;diff_forward;diff_reverse;diff_reset_forward;diff_reset_reverse;diff_response;diff_read_response;NoAction;}size=20;const default_action=NoAction();
 const entries={(8w5,_,_):diff_forward();(8w6,_,_):diff_response();(8w7,_,_):diff_forward();(8w9,_,_):diff_forward();(8w11,_,_):diff_read_response();(_,2w1,8w2):diff_syn();(_,2w2,8w18):diff_synack();(_,2w1,8w16):diff_forward();(_,2w1,8w17&&&8w0xf7):diff_forward();(_,2w2,8w17&&&8w0xf7):diff_reverse();(_,2w1,8w20):diff_forward();(_,2w2,8w20):diff_reverse();(_,2w1,8w4):diff_reset_forward();(_,2w2,8w4):diff_reset_reverse();(8w3,2w2,8w16):diff_reverse();}}
 action seq_ok(){m.sequence_valid=(bit<3>)(8w1);}
 action seq_fresh(){m.sequence_valid=(bit<3>)(8w6);}
 action seq_forward_fresh(){m.sequence_valid=(bit<3>)(8w7);}
 action seq_retx(){m.sequence_valid=(bit<3>)(8w2);}
 action seq_resent(){m.sequence_valid=(bit<3>)(8w3);}
 action seq_replay(){m.sequence_valid=(bit<3>)(8w4);}
action seq_fin(){m.sequence_valid=(bit<3>)(8w5);}   /* a FIN's sequence byte, phase 7 only */
 table sequence_guard{key={m.client_diff:ternary;m.server_diff:ternary;}actions={seq_ok;seq_fresh;seq_forward_fresh;seq_retx;seq_resent;seq_replay;seq_fin;NoAction;}size=21;const entries={(32w0,32w0):seq_ok();(32w1,32w0):seq_fin();(32w1,32w1):seq_fin();(32w0,32w1):seq_fin();(32w0xffffffd3,32w0):seq_resent();(32w0xffffffff,32w0):seq_replay();(32w0,32w0&&&32w0x80000000):seq_forward_fresh();(32w0,32w0xffffffcf):seq_retx();(32w0x80000000&&&32w0x80000000,32w0xffffffcf):seq_retx();(32w0,32w0xffffffcf):seq_retx();(32w0,32w0xffffff7a):seq_retx();(32w0,32w0xffffffa5):seq_retx();(32w0x80000000&&&32w0x80000000,32w0xffffffcf):seq_retx();(32w0x80000000&&&32w0x80000000,32w0xffffff7a):seq_retx();(32w0x80000000&&&32w0x80000000,32w0xffffffa5):seq_retx();(32w0xffffffec,32w0):seq_retx();(32w0xffffffe5,32w0):seq_retx();(32w0xffffffe7,32w0):seq_retx();(32w0xffffffec,32w0x80000000&&&32w0x80000000):seq_retx();(32w0xffffffe5,32w0x80000000&&&32w0x80000000):seq_retx();(32w0xffffffe7,32w0x80000000&&&32w0x80000000):seq_retx();}const default_action=seq_fresh();}
 action epoch_ok(){m.epoch_valid=(bit<1>)(8w1);}
 table epoch_guard{key={m.epoch_diff:exact;}actions={epoch_ok;NoAction;}size=1;const entries={32w0:epoch_ok();}const default_action=NoAction();}
 action claim_syn(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w1++m.next_owner_gen[15:0];m.owner_op=(bit<1>)(8w1);}
 action claim_synack(){m.expected=hdr.expected_cell.expected_cell;m.desired=hdr.expected_cell.expected_cell+32w0x10000;m.owner_op=(bit<1>)(8w1);}
 action claim_ack(){m.expected=hdr.expected_cell.expected_cell;m.desired=hdr.expected_cell.expected_cell+32w0x10000;m.owner_op=(bit<1>)(8w1);}
 action publish_syn(){m.expected=hdr.expected_cell.expected_cell;m.desired=hdr.expected_cell.expected_cell+32w0x10000;m.owner_op=(bit<1>)(8w1);}
 action publish_synack(){m.expected=hdr.expected_cell.expected_cell;m.desired=hdr.expected_cell.expected_cell+32w0x10000;m.owner_op=(bit<1>)(8w1);}
 action publish_ack(){m.expected=hdr.expected_cell.expected_cell;m.desired=hdr.expected_cell.expected_cell;m.owner_op=(bit<1>)(8w1);}
 action close_owner(){m.expected=hdr.expected_cell.expected_cell;m.desired=hdr.origin.normalized_epoch[15:0]++hdr.expected_cell.expected_cell[15:0];m.owner_op=(bit<1>)(8w1);}
 action close_pending(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w6++hdr.expected_cell.expected_cell[15:0];m.owner_op=(bit<1>)(8w1);}
 action close_free(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w7++hdr.expected_cell.expected_cell[15:0];m.owner_op=(bit<1>)(8w1);}
action quarantine_abort(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w6++hdr.expected_cell.expected_cell[15:0];m.owner_op=(bit<1>)(8w1);}
action claim_select(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w8++hdr.expected_cell.expected_cell[15:0];m.owner_op=(bit<1>)(8w1);}
action publish_select(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w9++hdr.expected_cell.expected_cell[15:0];m.owner_op=(bit<1>)(8w1);}
action claim_response(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w10++hdr.expected_cell.expected_cell[15:0];m.owner_op=(bit<1>)(8w1);}
action publish_response_failure(){m.expected=hdr.expected_cell.expected_cell;m.desired=16w5++hdr.expected_cell.expected_cell[15:0];m.owner_op=1w1;}
