    Register<bit<32>, r_slot_t>(16, 0) epoch;
    RegisterAction<bit<32>, r_slot_t, bit<32>>(epoch) epoch_normalize = {
        void apply(inout bit<32> v, out bit<32> rv) { rv = v & 32w0x7fffffff; }
    };
    RegisterAction<bit<32>, r_slot_t, bit<32>>(epoch) epoch_check = {
        void apply(inout bit<32> v, out bit<32> rv) { rv = v ^ hdr.prov.epoch; }
    };
    RegisterAction<bit<32>, r_slot_t, bit<32>>(epoch) epoch_open = {
        void apply(inout bit<32> v, out bit<32> rv) {
            // Bounded incoming epochs have MSB zero. The unsigned comparison
            // handles unlatched v; the signed, MSB-set input handles latched v.
            // The irrelevant comparison r_is false in each case, using two CUs.
            if (hdr.prov.epoch > v || (int<32>)m.open_bound > (int<32>)v) { v = hdr.prov.epoch; rv = 0; }
            else { rv = 1; }
        }
    };
    RegisterAction<bit<32>, r_slot_t, bit<32>>(epoch) epoch_first = {
        void apply(inout bit<32> v, out bit<32> rv) {
            rv = v ^ hdr.prov.epoch;
            if (v == hdr.prov.epoch && v != 0) { v = v | 32w0x80000000; }
        }
    };
    action normalize_epoch() { hdr.prov.epoch = epoch_normalize.execute(m.idx); m.life_bad = 0; m.normalize = 1; }
    action capture_normalization_ack() { hdr.prov.wgen = hdr.tcp.ack; }
    table normalization_ack_t {
        key = { hdr.prov.kind : exact; }
        actions = { capture_normalization_ack; NoAction; }
        const entries = { 8w0xe0 : capture_normalization_ack(); }
        default_action = NoAction(); size = 1;
    }
    action check_epoch() { m.life_bad = epoch_check.execute(m.idx); }
    action open_epoch() { m.life_bad = epoch_open.execute(m.idx); }
    action first_epoch() { m.life_bad = epoch_first.execute(m.idx); m.first_synack = 1; }
    action reject_lifetime() { m.life_bad = 1; }
    action prepare_open() { m.open_bound = hdr.prov.epoch | 32w0x80000000; }
    table prepare_open_t {
        key = { hdr.prov.kind : exact; }
        actions = { prepare_open; NoAction; }
        const entries = { 8w14 : prepare_open(); }
        default_action = NoAction(); size = 1;
    }
    @placement_priority(100) table lifecycle_access {
        key = { hdr.tcp.isValid() : exact; m.dir : ternary; hdr.prov.kind : ternary; hdr.prov.epoch : ternary; }
        actions = { normalize_epoch; check_epoch; open_epoch; first_epoch; reject_lifetime; NoAction; }
        const entries = {(false, _, _, _): NoAction();(true, 0, _, _): NoAction();(true, _, _, 32w0x80000000 &&& 32w0x80000000): reject_lifetime();(true, _, _, 32w0x7fffffff): reject_lifetime();(true, _, 8w0xe7, 0): reject_lifetime();(true, _, 8w0xe0, _): normalize_epoch();(true, _, 8w14, _): open_epoch();(true, _, 8w0xe3, _): check_epoch();(true, _, 8w0xe4, _): check_epoch();(true, _, 8w0xe5, _): check_epoch();(true, _, 8w0xe7, _): first_epoch();(true, _, 8w9, _): check_epoch();(true, _, 8w10, _): check_epoch();(true, _, 8w11, _): check_epoch();(true, _, 8w12, _): check_epoch();(true, _, 8w13, _): check_epoch();(true, _, _, _): reject_lifetime();}
        default_action = NoAction(); size = 17;
    }
    Register<bit<32>, r_slot_t>(16, 0) master_isn;
    RegisterAction<bit<32>, r_slot_t, bit<32>>(master_isn) isn_open = {
        void apply(inout bit<32> v, out bit<32> rv) { v = hdr.tcp.seq; rv = v; }
    };
    RegisterAction<bit<32>, r_slot_t, bit<32>>(master_isn) isn_read = {
        void apply(inout bit<32> v, out bit<32> rv) { rv = v ^ hdr.tcp.seq; }
    };
    action open_isn() { isn_open.execute(m.idx); }
    action check_isn() { m.life_bad = isn_read.execute(m.idx); }
    table isn_access {
        key = { hdr.prov.kind : exact; m.life_bad : exact; }
        actions = { open_isn; check_isn; NoAction; }
        const entries = { (14, 0) : open_isn(); (8w0xe0, 0) : check_isn(); }
        default_action = NoAction(); size = 2;
    }
    action normalization_stamp(bit<32> same) {
        hdr.prov.aux = same;
    }
    table normalization_result {
        key = { m.life_bad : exact; }
        actions = { normalization_stamp; }
        const entries = { 32w0 : normalization_stamp(32w1); }
        default_action = normalization_stamp(32w0); size = 1;
    }
    action commit_return() { hdr.prov.kind = 8w0xe6; }
    action unbound_normalization() { hdr.prov.epoch = 0; hdr.prov.aux = 0; hdr.prov.kind = 8w0xe1; }
    action normalization_return() { hdr.prov.kind = 8w0xe1; }
    action strip_provenance() { hdr.prov.setInvalid(); }
    action drop_lifetime() { md.drop_ctl = 3w1; }
    table envelope_result {
        key = { hdr.prov.kind : exact; }
        actions = { commit_return; strip_provenance; normalization_return; NoAction; }
        const entries = { 8w0xe0 : normalization_return(); 8w0xe1 : NoAction(); 8w0xe5 : commit_return(); }
        default_action = strip_provenance(); size = 3;
    }

    /* ============ mapper registers ============ */
    Register<bit<8>, r_slot_t>(16, 0) mode;
    RegisterAction<bit<8>, r_slot_t, bit<8>>(mode) mode_arm_map = { void apply(inout bit<8> v, out bit<8> rv) { rv = v; if (v == 2) { v = 1; } } };
    RegisterAction<bit<8>, r_slot_t, bit<8>>(mode) mode_arm_nat = { void apply(inout bit<8> v) { v = 2; } };
    RegisterAction<bit<8>, r_slot_t, bit<8>>(mode) mode_read = { void apply(inout bit<8> v, out bit<8> rv) { rv = v; } };
    action do_mode_arm_map() { m.mode = (bit<2>)(mode_arm_map.execute(m.idx)); }
    action do_mode_arm_nat() { mode_arm_nat.execute(m.idx); }
    action do_mode_read() { m.mode = (bit<2>)(mode_read.execute(m.idx)); }
    table mode_t {
        key = { hdr.prov.kind : ternary; }
        actions = { do_mode_arm_map; do_mode_arm_nat; do_mode_read; NoAction; }
        const entries = { 8w14 : do_mode_arm_nat(); 8w0xe7 : do_mode_arm_map(); _ : do_mode_read(); }
        default_action = NoAction(); size = 3;
    }


    Register<bit<32>, r_slot_t>(16, 0) front;
    RegisterAction<bit<32>, r_slot_t, bit<32>>(front) front_arm = {
        void apply(inout bit<32> v) { v = hdr.tcp.seq + 1; } };
    RegisterAction<bit<32>, r_slot_t, bit<32>>(front) front_step = {
        void apply(inout bit<32> v, out bit<32> rv) { rv = hdr.tcp.seq - v; if (v == hdr.tcp.seq) { v = v + m.leff; } } };
    action do_front_arm() { front_arm.execute(m.idx); }
    action do_front_step() { m.front_ret = front_step.execute(m.idx); }
    table front_t {
        key = { hdr.prov.kind : ternary; m.dir : exact; m.shape : ternary; }
        actions = { do_front_arm; do_front_step; NoAction; } size = 4; const default_action = NoAction();
        const entries = {(8w0xe7, 1, (bit<3>)r_SH_SYNACK_OK): do_front_arm();(_, 1, 3w4 &&& 3w7): do_front_step();}
    }

    /* acct = {lo: W, hi: U = W - A}; a commit adds the whole 58-byte image (L + d = 58 for both
       profiles), any other frontier segment adds Leff. */
    action set_ina(bit<32> v) { m.ina = v; }
    table ina_img_t { key = { m.read_shape : exact; m.ctl_shape : exact; hdr.dl.len : ternary; }
        actions = { set_ina; NoAction; } size = 4; const default_action = NoAction();
        const entries = { (1, 0, 8w0x27) : set_ina(141); (1, 0, 8w0x11) : set_ina(158); (0, 1, _) : set_ina(60); } }
    Register<r_pair32, r_slot_t>(16, {0, 0}) acct;
    RegisterAction<r_pair32, r_slot_t, bit<8>>(acct) acct_arm = {
        void apply(inout r_pair32 v) { v.lo = m.ina; v.hi = 0; } };
    RegisterAction<r_pair32, r_slot_t, bit<8>>(acct) acct_try = {
        void apply(inout r_pair32 v, out bit<8> rv) {
            rv = 0;
            if (v.hi == 0) { v.lo = v.lo + m.ina; v.hi = v.hi + m.ina; rv = 1; }
            else { v.lo = v.lo + m.leff; v.hi = v.hi + m.leff; }
        } };
    RegisterAction<r_pair32, r_slot_t, bit<8>>(acct) acct_grow = {
        void apply(inout r_pair32 v) { v.lo = v.lo + m.leff; v.hi = v.hi + m.leff; } };
    RegisterAction<r_pair32, r_slot_t, bit<8>>(acct) acct_rev = {
        void apply(inout r_pair32 v) { v.hi = v.lo - m.ina; } };
    action do_acct_arm() { acct_arm.execute(m.idx); }
    action do_acct_try() { m.grant = (bit<1>)(acct_try.execute(m.idx)); }
    action do_acct_grow() { acct_grow.execute(m.idx); }
    action do_acct_rev() { acct_rev.execute(m.idx); }
    table acct_t {   
        key = { hdr.prov.kind : ternary; m.dir : exact; m.shape : ternary; m.front_ret : ternary; m.enable : ternary; hdr.tcp.flags : ternary;
                m.leff : ternary; m.read_shape : ternary; m.ctl_shape : ternary; m.badh : ternary;
                m.rbad0 : ternary; m.rbad1 : ternary; m.rbadt : ternary; m.cbad0 : ternary; m.cbadt : ternary; }
        actions = { do_acct_arm; do_acct_try; do_acct_grow; do_acct_rev; NoAction; } size = 10;
        const default_action = NoAction();
