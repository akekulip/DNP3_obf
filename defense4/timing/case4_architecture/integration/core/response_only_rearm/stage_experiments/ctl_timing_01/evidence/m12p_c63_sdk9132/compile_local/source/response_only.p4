 state rx_response_dl{pkt.extract(hdr.dl);tc.subtract(hdr.dl);transition select(hdr.dl.len,hdr.ip.len){(8w0x4c,16w143):read_response_fb;(8w0x73,16w186):read_response_fb;default:accept;}}
 state read_response_fb{pkt.extract(hdr.first);tc.subtract(hdr.first);m.packet_kind=8w11;transition finish_shallow;}
 state finish_shallow{m.parsed=(bit<1>)(8w1);m.shape_valid=(bit<1>)(8w1);transition accept;}
 state read_request{pkt.extract(hdr.rd_req);tc.subtract(hdr.rd_req);m.packet_kind=8w9;transition finish;}
 state read_response_block{pkt.extract(hdr.first);tc.subtract(hdr.first);transition read_response_second;}
 state read_response_second{pkt.extract(hdr.second);tc.subtract(hdr.second);transition read_response_tail;}
 state read_response_tail{pkt.extract(hdr.rd_tail);tc.subtract(hdr.rd_tail);m.packet_kind=8w11;transition finish;}
 state read_t0{pkt.extract(hdr.t0);transition origin;}
 state native_block{pkt.extract(hdr.first);tc.subtract(hdr.first);transition native_tail;}
 state native_tail{pkt.extract(hdr.tail);tc.subtract(hdr.tail);transition select(hdr.first.w0[15:8]){8w3:select_finish;8w4:operate_finish;default:accept;}}
 state select_finish{m.packet_kind=8w5;transition finish;}
 state operate_finish{m.packet_kind=8w7;transition finish;}
 state response_block{pkt.extract(hdr.first);tc.subtract(hdr.first);transition rtail37;}
 state rtail37{pkt.extract(hdr.rtail);tc.subtract(hdr.rtail);pkt.extract(hdr.cstatus);tc.subtract(hdr.cstatus);m.response=(bit<1>)(8w1);m.packet_kind=8w6;transition finish;}
 state ts_ip_flags{transition select(hdr.ip.frag,hdr.ip.flags){(13w0,3w0):ts_tcp;(13w0,3w2):ts_tcp;default:accept;}}
 state ts_tcp{pkt.extract(hdr.tcp);tc.subtract(hdr.tcp);transition select(hdr.tcp.offset,hdr.tcp.flags){(4w8,8w16):ts_ack;(4w8,8w17):ts_close;(4w8,8w25):ts_close;(4w8,8w20):ts_close;(4w8,8w4):ts_close;default:accept;}}
 state ts_ack{pkt.extract(hdr.tso);tc.subtract(hdr.tso);transition select(hdr.tso.a){32w0x0101080a:ack;default:accept;}}
 state ts_close{pkt.extract(hdr.tso);tc.subtract(hdr.tso);transition select(hdr.tso.a){32w0x0101080a:close;default:accept;}}
 state ts_syn{pkt.extract(hdr.mss);tc.subtract(hdr.mss);m.packet_kind=8w1;transition ts_syn_mss;}
 state ts_synack_ip_flags{transition select(hdr.ip.frag,hdr.ip.flags){(13w0,3w0):ts_synack_tcp;(13w0,3w2):ts_synack_tcp;default:accept;}}
 state ts_synack_tcp{pkt.extract(hdr.tcp);tc.subtract(hdr.tcp);transition select(hdr.tcp.offset,hdr.tcp.flags){(4w11,8w18):ts_synack;default:accept;}}
 state ts_synack{pkt.extract(hdr.mss);tc.subtract(hdr.mss);m.packet_kind=8w2;transition ts_synack_mss;}
 state ts_read_ip_flags{transition select(hdr.ip.frag,hdr.ip.flags){(13w0,3w0):ts_read_tcp;(13w0,3w2):ts_read_tcp;default:accept;}}
 state ts_read_tcp{pkt.extract(hdr.tcp);tc.subtract(hdr.tcp);transition select(hdr.tcp.offset,hdr.tcp.reserved,hdr.tcp.urgent,hdr.tcp.flags){(4w8,4w0,16w0,8w16):ts_read_opt;(4w8,4w0,16w0,8w24):ts_read_opt;default:accept;}}
 state ts_read_opt{pkt.extract(hdr.tso);tc.subtract(hdr.tso);transition select(hdr.tso.a){32w0x0101080a:read_dl;default:accept;}}
 state ts_read_response_ip_flags{transition select(hdr.ip.frag,hdr.ip.flags){(13w0,3w0):ts_read_response_tcp;(13w0,3w2):ts_read_response_tcp;default:accept;}}
 state ts_read_response_tcp{pkt.extract(hdr.tcp);tc.subtract(hdr.tcp);transition select(hdr.tcp.offset,hdr.tcp.reserved,hdr.tcp.urgent,hdr.tcp.flags){(4w8,4w0,16w0,8w16):ts_read_response_opt;(4w8,4w0,16w0,8w24):ts_read_response_opt;default:accept;}}
 state ts_read_response_opt{pkt.extract(hdr.tso);tc.subtract(hdr.tso);transition select(hdr.tso.a){32w0x0101080a:read_response_dl;default:accept;}}
 state ts_syn_value{pkt.extract(hdr.hs1);tc.subtract(hdr.hs1);transition ts_syn_echo;}
 state ts_synack_values{pkt.extract(hdr.oa);tc.subtract(hdr.oa);pkt.extract(hdr.ob);tc.subtract(hdr.ob);m.tcp_sum=tc.get();transition finish_handshake;}
 state finish_handshake{m.parsed=(bit<1>)(8w1);m.shape_valid=(bit<1>)(8w1);transition accept;}
 state finish{m.tcp_sum=tc.get();m.parsed=(bit<1>)(8w1);m.shape_valid=(bit<1>)(8w1);transition accept;}

}
@pa_mutually_exclusive("ingress", "hdr.rd_req", "hdr.rd_req_full")
@pa_mutually_exclusive("ingress", "hdr.rd_req", "hdr.rd_req_mx")
@pa_mutually_exclusive("ingress", "hdr.rd_req_full", "hdr.rd_req_mx")
@pa_container_size("ingress", "m.expected_work_phase", 32)
@pa_solitary("ingress", "m.expected_work_phase")
control n_Ingress(inout n_headers_t hdr,inout n_meta_t m,in ingress_intrinsic_metadata_t ig,in ingress_intrinsic_metadata_from_parser_t p,inout ingress_intrinsic_metadata_for_deparser_t md,inout ingress_intrinsic_metadata_for_tm_t tm){
 n_ExpectedWorkRecord() work;
 Register<bit<32>,bit<1>>(1,0) counter;
 RegisterAction<bit<32>,bit<1>,bit<32>>(counter) allocate={void apply(inout bit<32> v,out bit<32> r){r=32w0;if(v<32w0x7ffffffe){v=v+32w1;r=v;}}};
 Register<bit<32>,bit<1>>(1,0) owner;
 RegisterAction<bit<32>,bit<1>,bit<32>>(owner) check_owner={void apply(inout bit<32> v,out bit<32> r){r=v-m.expected;}};
 RegisterAction<bit<32>,bit<1>,bit<32>>(owner) read_owner={void apply(inout bit<32> v,out bit<32> r){r=v;}};
 RegisterAction<bit<32>,bit<1>,bit<32>>(owner) compare_owner={void apply(inout bit<32> v,out bit<32> r){r=v-m.expected;if(v==m.expected){v=m.desired;}}};
 Register<bit<32>,bit<4>>(4,0) count_first;
RegisterAction<bit<32>,bit<4>,bit<32>>(count_first) count_first_bump={void apply(inout bit<32> v,out bit<32> r){if((int<32>)v!=-1){v=v+32w1;}r=v;}};
Register<bit<32>,bit<4>>(8,0) count_busy;
RegisterAction<bit<32>,bit<4>,bit<32>>(count_busy) count_busy_bump={void apply(inout bit<32> v,out bit<32> r){if((int<32>)v!=-1){v=v+32w1;}r=v;}};
Register<bit<32>,bit<4>>(4,0) count_term;
RegisterAction<bit<32>,bit<4>,bit<32>>(count_term) count_term_bump={void apply(inout bit<32> v,out bit<32> r){if((int<32>)v!=-1){v=v+32w1;}r=v;}};
action count_retry_duplicate(){count_term_bump.execute(4w0);}
 action deny(){md.drop_ctl=3w1;}
 action committed_to_t(bit<16> event){hdr.event.event=event;tm.ucast_egress_port=n_READ_HANDOFF_PORT;tm.bypass_egress=1w0;}
 table committed_t{key={hdr.event.event:exact;}actions={committed_to_t;deny;}size=3;const entries={16w0xe609:committed_to_t(16w0x0900);16w0xe60c:committed_to_t(16w0x0c00);16w0xe60f:committed_to_t(16w0x0f00);}const default_action=deny();}
 /* response-only: no bypass_egress here; final departures to 9/64 cross pipe 0 egress (B' mapper) */
action route(PortId_t port){m.port_valid=(bit<1>)(8w1);tm.ucast_egress_port=port;}
 /* every master-side IPv4 TCP packet -> one reverse-map lap through pipe 0 egress; (bit<8>)m.port_valid stays 0 */
action normalize_ack(){hdr.event.event=16w0xe000;tm.ucast_egress_port=n_N_ACK_RETURN;tm.bypass_egress=1w0;}
table ports{key={ig.ingress_port:exact;hdr.ip.isValid():ternary;hdr.ip.proto:ternary;hdr.ip.src:ternary;}actions={route;normalize_ack;deny;}size=8;default_action=deny();}
 action forward_flow(PortId_t port){m.direction=(bit<2>)(8w1);m.output_port=port;}
 action reverse_flow(PortId_t port){m.direction=(bit<2>)(8w2);m.output_port=port;}
 table connection{key={hdr.ip.src:exact;hdr.ip.dst:exact;hdr.tcp.sport:exact;hdr.tcp.dport:exact;ig.ingress_port:exact;}actions={forward_flow;reverse_flow;NoAction;}size=4;default_action=NoAction();}
 action network_accept(){m.network_valid=(bit<1>)(8w1);}
 table network{key={m.parsed:exact;m.kind:exact;hdr.tcp.flags:ternary;m.ip_error:exact;m.tcp_sum:exact;hdr.ip.ttl:range;hdr.tcp.reserved:exact;hdr.tcp.urgent:exact;}actions={network_accept;NoAction;}size=32;const default_action=NoAction();const entries={(1w1,8w0,_,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w1,8w2,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w2,8w18,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w3,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w4,8w17&&&8w0xf7,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w4,8w20,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w4,8w4,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w255,_,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w5,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w5,8w24,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w6,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w6,8w24,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w7,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w7,8w24,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w24,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w24,8w24,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w8,8w2,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w8,8w18,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w8,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w8,8w24,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w25,8w24,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w25,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w9,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w9,8w24,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w10,8w16,false,16w0xffeb,8w1..8w255,4w0,16w0):network_accept();(1w1,8w11,8w16,false,16w0xffeb,8w1..8w2