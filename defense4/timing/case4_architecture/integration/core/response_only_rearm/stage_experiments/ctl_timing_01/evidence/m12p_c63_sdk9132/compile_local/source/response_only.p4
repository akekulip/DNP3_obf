 action syn_shape(){m.shape_valid=(bit<1>)(8w1);m.kind=8w1;}
 action synack_shape(){m.shape_valid=(bit<1>)(8w1);m.kind=8w2;}
 table syn_shapes{key={m.direction:exact;hdr.tcp.flags:exact;hdr.mss.kind:exact;hdr.mss.len:exact;hdr.mss.value:range;}
 actions={syn_shape;synack_shape;NoAction;}size=2;const default_action=NoAction();const entries={(2w1,8w2,8w2,8w4,16w1460):syn_shape();(2w2,8w18,8w2,8w4,16w1460):synack_shape();}}
 action ack_shape(){m.shape_valid=(bit<1>)(8w1);m.kind=8w3;}
 action close_shape(){m.shape_valid=(bit<1>)(8w1);m.kind=8w4;}
 table short_shapes{key={m.direction:exact;hdr.tcp.flags:exact;}
 actions={ack_shape;close_shape;NoAction;}size=9;const default_action=NoAction();const entries={(2w1,8w16):ack_shape();(2w1,8w17):close_shape();(2w2,8w17):close_shape();(2w1,8w25):close_shape();(2w2,8w25):close_shape();(2w1,8w20):close_shape();(2w2,8w20):close_shape();(2w1,8w4):close_shape();(2w2,8w4):close_shape();}}
 action configure(bit<16> index,bit<8> code,bit<8> repeat,bit<32> on,bit<32> off){m.enabled=(bit<1>)(8w1);m.decoy_index=index;m.decoy_code=code;m.decoy_repeat=repeat;m.decoy_on=on;m.decoy_off=off;}
 table data_connection{key={hdr.ip.src:exact;hdr.ip.dst:exact;hdr.tcp.sport:exact;hdr.tcp.dport:exact;}actions={configure;NoAction;}size=2;default_action=NoAction();}
 action eligible(){m.profile=8w1;}
 table profile{key={hdr.dl.magic:exact;hdr.dl.len:exact;hdr.dl.ctrl:exact;hdr.first.w0:ternary;hdr.first.w1:exact;hdr.first.w2:exact;hdr.first.w3:exact;hdr.tail.off:exact;hdr.tail.status:exact;hdr.tail.index2:exact;hdr.tail.code2:exact;hdr.tail.count2:exact;hdr.tail.on2:exact;hdr.tail.off2:exact;hdr.tail.status2:exact;}actions={eligible;NoAction;}size=2;const default_action=NoAction();const entries={(16w0x0564,8w36,8w0xc4,32w0xc0c0030c&&&32w0xc0f0ffff,32w0x01170201,32w0x0101c800,32w0,16w0,8w0,8w3,8w1,8w1,32w0xc8000000,32w0,8w0):eligible();(16w0x0564,8w36,8w0xc4,32w0xc0c0040c&&&32w0xc0f0ffff,32w0x01170201,32w0x0101c800,32w0,16w0,8w0,8w3,8w1,8w1,32w0xc8000000,32w0,8w0):eligible();}}
 CRCPolynomial<bit<16>>(16w0x3D65,true,false,false,16w0,16w0xFFFF) poly;
Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_head;
action input_tail(){m.tcrc=16w0x993a;}
action tail_crc_bad(){m.tcrc=16w0;}
@stage(2) table input_tail_t{key={hdr.tail.crc:exact;}actions={input_tail;tail_crc_bad;}size=1;const default_action=tail_crc_bad();const entries={16w0x15ee:input_tail();}}
table response_profile{key={hdr.dl.magic:exact;hdr.dl.len:exact;hdr.dl.ctrl:exact;hdr.first.w0:ternary;hdr.first.w1:ternary;hdr.first.w2:exact;hdr.first.w3:exact;hdr.rtail.off:exact;hdr.rtail.index2:exact;hdr.rtail.code2:exact;hdr.rtail.count2:exact;hdr.rtail.on2:exact;hdr.rtail.off2:exact;}actions={eligible;NoAction;}size=1;const default_action=NoAction();const entries={(16w0x0564,8w38,8w0x44,32w0xc0c08100&&&32w0xc0f0ff00,32w0x000c0117&&&32w0x00ffffff,32w0x02010101,32w0xc8000000,32w0,8w3,8w1,8w1,32w0xc8000000,32w0):eligible();}}
Hash<bit<16>>(HashAlgorithm_t.CUSTOM,poly) hash_first;
/* response-only: one table computes the link-header n_CRC (every DNP3 kind) and the first-block n_CRC (every
   kind that carries hdr.first). It replaces input_head_t, rd_head_t, input_body_t, response_crc0_t and
   rd_first_crc_t, which computed the same two CRCs over the same bits (input_body's byte slices
   concatenate to {w0,w1,w2,w3}). Fewer hash tables and crossbar bytes in N's stage 1, which pipe 0's
   egress response path also needs (evidence/route_ab_01/response_only_04). */
action crc_head(){m.hcrc=hash_head.get({hdr.dl.magic,hdr.dl.len,hdr.dl.ctrl,hdr.dl.dst,hdr.dl.src,hdr.dl.crc});}
action crc_head_first(){crc_head();m.bcrc=hash_first.get({hdr.first.w0,hdr.first.w1,hdr.first.w2,hdr.first.w3,hdr.first.crc});}
action crc_head_first_shallow(){crc_head();m.bcrc=hash_first.get({hdr.first.w0,hdr.first.w1,hdr.first.w2,hdr.first.w3,hdr.first.crc});m.tcp_sum=16w0xffeb;}
@stage(1) table crc_t{key={m.packet_kind:exact;}actions={crc_head;crc_head_first;crc_head_first_shallow;NoAction;}size=8;const default_action=NoAction();const entries={8w5:crc_head_first();8w6:crc_head_first();8w7:crc_head_first();8w9:crc_head();8w11:crc_head_first_shallow();}}
action response_status_good(){m.crc1=16w0x993a;}
