      - default_action: { allowed: true, is_constant: true }
      - handle: 0x200000c9
      - next_table: 0
      - set hdr.t0.$valid, 0
      - set H0(0..7), 65535
    default_action: n_Ingress.abort_work
stage 0 egress:
  exact_match conn_0 0:
    p4: { name: r_Egress.conn, size: 32 }
    p4_param_order: 
      hdr.ip.src: { type: exact, size: 32, full_size: 32 }
      hdr.ip.dst: { type: exact, size: 32, full_size: 32 }
      hdr.tcp.sport: { type: exact, size: 16, full_size: 16 }
      hdr.tcp.dport: { type: exact, size: 16, full_size: 16 }
      eg_intr_md.egress_port: { type: exact, size: 9, full_size: 9, key_name: "eg.egress_port" }
    row: 6
    bus: 1
    column: [ 6, 7, 8, 9 ]
    stash: 
      row: [ 6 ]
      col: [ 6 ]
      unit: [ 1 ]
    ways:
      - { group: 0, index: 0..9, select: 40..51 & 0x0, rams: [[6, 6]] }
      - { group: 0, index: 10..19, select: 40..51 & 0x0, rams: [[6, 7]] }
      - { group: 0, index: 20..29, select: 40..51 & 0x0, rams: [[6, 8]] }
      - { group: 0, index: 30..39, select: 40..51 & 0x0, rams: [[6, 9]] }
    input_xbar:
      exact group 0: { 0: eg_intr_md.egress_port, 16: hdr.tcp.dport, 32: hdr.tcp.sport, 48: hdr.ip.dst.0-15, 64: hdr.ip.dst.16-31, 80: hdr.ip.src.0-15, 96: hdr.ip.src.16-31 }
      hash 0:
        0..7: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(0..7)
        8: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(8)
        9: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ hdr.tcp.dport(0)
        11..18: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(0..7)
        19: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(8)
        10: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ hdr.tcp.dport(0)
        22..29: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(0..7)
        20: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(8)
        21: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ hdr.tcp.dport(0)
        33..39: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(0..6)
        30: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(7)
        31: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ eg_intr_md.egress_port(8)
        32: random(hdr.tcp.dport(1..15), hdr.tcp.sport, hdr.ip.dst.0-15) ^ hdr.tcp.dport(0)
      hash 1:
        0..9: random(hdr.ip.dst.16-31, hdr.ip.src.0-15, hdr.ip.src.16-31)
        10..19: random(hdr.ip.dst.16-31, hdr.ip.src.0-15, hdr.ip.src.16-31)
        20..29: random(hdr.ip.dst.16-31, hdr.ip.src.0-15, hdr.ip.src.16-31)
        30..39: random(hdr.ip.dst.16-31, hdr.ip.src.0-15, hdr.ip.src.16-31)
      hash group 0:
        table: [0, 1]
        seed: 0xc41816a24b
    format: { action(0): 0..1, immediate(0): 2..6, version(0): 112..115, match(0): [ 17..23, 32..111, 8..15 ] }
    match: [ hdr.tcp.dport(1..7), hdr.tcp.dport(8..15), hdr.tcp.sport(0..7), hdr.tcp.sport(8..15), hdr.ip.dst.0-15(0..7), hdr.ip.dst.0-15(8..15), hdr.ip.dst.16-31(0..7), hdr.ip.dst.16-31(8..15), hdr.ip.src.0-15(0..7), hdr.ip.src.0-15(8..15), hdr.ip.src.16-31(0..7), hdr.ip.src.16-31(8..15) ]
    match_group_map: [ [ 0 ] ]
    hit: [  prepare_open_t_0 ]
    miss:  prepare_open_t_0
    action_bus: { 0 : immediate(0..4) }
    instruction: conn_0(action, $DEFAULT)
    actions:
      r_Egress.fwd_conn(0, 1):
      - p4_param_order: { idx: 4, enable: 8 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x200000d5
      - next_table: 0
      - { idx_3: immediate(0..3), idx: idx_3, enable_1.0-0: immediate(4..4), enable.0-0: enable_1.0-0 }
      - set m.dir, 1
      - set m.idx, idx
      - set m.enable, enable.0-0
      r_Egress.rev_conn(1, 2):
      - p4_param_order: { idx: 4 }
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x200000d6
      - next_table: 0
      - { idx_4: immediate(0..3), idx: idx_4 }
      - set m.dir, 2
      - set m.idx, idx
      - set m.enable, 0
      NoAction(2, 0):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x200000d7
      - next_table: 0
      - {  }
    default_action: NoAction
  exact_match prepare_open_t_0 1:
    p4: { name: r_Egress.prepare_open_t, size: 1 }
    p4_param_order: 
      hdr.prov.kind: { type: exact, size: 8, full_size: 8 }
    row: 0
    result_bus: 1
    gateway:
      name: prepare_open_t_0-gateway
      input_xbar:
        exact group 0: { 112: hdr.prov.kind }
      row: 0
      bus: 0
      unit: 0
      payload_row: 0
      payload_unit: 1
      payload: 0x20001
      format: { action: 0..1, immediate: 2..17 }
