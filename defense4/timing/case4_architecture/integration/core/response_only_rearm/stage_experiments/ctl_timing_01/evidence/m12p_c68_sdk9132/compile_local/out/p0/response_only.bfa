    format: {ig: 0..63}
    constant_value: 0
    actions:
      set_port_metadata:
      - handle: 0x20000000
      - p4_param_order: { ig: 64 } 
  ternary_match retry_epoch_t_0 9:
    p4: { name: n_Ingress.retry_epoch_t, size: 5 }
    p4_param_order: 
      m.stage: { type: exact, size: 2, full_size: 2 }
      m.kind: { type: exact, size: 8, full_size: 8 }
      m.retry: { type: exact, size: 2, full_size: 2 }
      hdr.origin.normalized_epoch: { type: ternary, size: 16, full_size: 32 }
    row: 8
    bus: 0
    column: 0
    input_xbar:
      ternary group 8: { 0: hdr.origin.normalized_epoch(0..15), 16: m.kind, 26: m.retry, 32: m.stage }
    match:
    - { group: 8, byte_config: 3, dirtcam: 0x155 }
    hit: [  connection_0 ]
    miss:  connection_0
    context_json:
      static_entries:
      - priority: 0
        match_key_fields_values:
        - field_name: m.stage
          value: "0x0"
        - field_name: m.kind
          value: "0x0"
        - field_name: m.retry
          value: "0x1"
        - field_name: hdr.origin.normalized_epoch
          value: "0x0"
          mask: "0x0"
        action_handle: 0x20000006
        is_default_entry: false
        action_parameters_values: []
      - priority: 1
        match_key_fields_values:
        - field_name: m.stage
          value: "0x2"
        - field_name: m.kind
          value: "0x1"
        - field_name: m.retry
          value: "0x0"
        - field_name: hdr.origin.normalized_epoch
          value: "0x0"
          mask: "0x0"
        action_handle: 0x20000007
        is_default_entry: false
        action_parameters_values: []
      - priority: 2
        match_key_fields_values:
        - field_name: m.stage
          value: "0x2"
        - field_name: m.kind
          value: "0x4"
        - field_name: m.retry
          value: "0x0"
        - field_name: hdr.origin.normalized_epoch
          value: "0x200"
          mask: "0xFFFFFFFF"
        action_handle: 0x20000008
        is_default_entry: false
        action_parameters_values: []
      - priority: 3
        match_key_fields_values:
        - field_name: m.stage
          value: "0x2"
        - field_name: m.kind
          value: "0x4"
        - field_name: m.retry
          value: "0x0"
        - field_name: hdr.origin.normalized_epoch
          value: "0x10F"
          mask: "0xFFFFFFFF"
        action_handle: 0x20000008
        is_default_entry: false
        action_parameters_values: []
      - priority: 4
        match_key_fields_values:
        - field_name: m.stage
          value: "0x2"
        - field_name: m.kind
          value: "0x11"
        - field_name: m.retry
          value: "0x0"
        - field_name: hdr.origin.normalized_epoch
          value: "0x10F"
          mask: "0xFFFFFFFF"
        action_handle: 0x20000008
        is_default_entry: false
        action_parameters_values: []

    indirect: retry_epoch_t_0$tind
  stateful retry_epoch_t_0$salu.n_Ingress.retry_epoch:
    p4: { name: n_Ingress.retry_epoch, size: 1 }
    row: 15
    logical_bus: S
    column: [ 4, 5 ]
    maprams: [ 4, 5 ]
    home_row: 15
    input_xbar:
      exact group 3: { 64: hdr.envelope.epoch }
    data_bytemask: 15
    format: { lo: 32 }
    actions:
      check_retry_epoch_0:
      - equ lo, lo, -phv_lo
      - alu_a cmplo, hi, 1
      - alu_a !cmplo, hi, 2
      - output (cmplo | !cmplo), alu_hi
      note_retry_epoch_0:
      - alu_a lo, phv_lo
      clear_retry_epoch_0:
      - equ lo, lo, -phv_lo
      - alu_a cmplo, lo, 0
  ternary_indirect retry_epoch_t_0$tind:
    row: 1
    bus: 0
    column: 2
    input_xbar:
      ternary group 8: { 0: hdr.origin.normalized_epoch(0..15), 16: m.kind, 26: m.retry, 32: m.stage }
    format: { action: 0..1, meter_addr: 2..11, meter_pfe: 12..12, meter_type: 13..15 }
    action_bus: { 36..37 : retry_epoch_t_0$salu.n_Ingress.retry_epoch(0..15) }
    stateful: retry_epoch_t_0$salu.n_Ingress.retry_epoch(meter_addr, meter_pfe, meter_type)
    instruction: retry_epoch_t_0$tind(action, $DEFAULT)
    actions:
      n_Ingress.retry_epoch_check(0, 1):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x20000006
      - next_table: 0
      - set H69(10..11), retry_epoch_t_0$salu.n_Ingress.retry_epoch
      - retry_epoch_t_0$salu.n_Ingress.retry_epoch(check_retry_epoch_0, 0)
      n_Ingress.retry_epoch_note(1, 0):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x20000007
      - next_table: 0
      - retry_epoch_t_0$salu.n_Ingress.retry_epoch(note_retry_epoch_0, 0)
      n_Ingress.retry_epoch_clear(2, 2):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: false, reason: has_const_default_action }
      - handle: 0x20000008
      - next_table: 0
      - retry_epoch_t_0$salu.n_Ingress.retry_epoch(clear_retry_epoch_0, 0)
      NoAction(3, 3):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true, is_constant: true }
      - handle: 0x20000009
      - next_table: 0
    default_action: NoAction
  exact_match connection_0 10:
    p4: { name: n_Ingress.connection, size: 4 }
    p4_param_order: 
      hdr.ip.src: { type: exact, size: 32, full_size: 32 }
      hdr.ip.dst: { type: exact, size: 32, full_size: 32 }
      hdr.tcp.sport: { type: exact, size: 16, full_size: 16 }
      hdr.tcp.dport: { type: exact, size: 16, full_size: 16 }
      ig_intr_md.ingress_port: { type: exact, size: 9, full_size: 9, key_name: "ig.ingress_port" }
    row: 7
    bus: 0
    column: [ 2, 6, 7, 8 ]
    stash: 
      row: [ 7 ]
      col: [ 2 ]
      unit: [ 0 ]
    ways:
      - { group: 3, index: 0..9, select: 40..51 & 0x0, rams: [[7, 2]] }
      - { group: 3, index: 10..19, select: 40..51 & 0x0, rams: [[7, 6]] }
      - { group: 3, index: 20..29, select: 40..51 & 0x0, rams: [[7, 7]] }
      - { group: 3, index: 30..39, select: 40..51 & 0x0, rams: [[7, 8]] }
    input_xbar:
      exact group 4: { 0: hdr.ip.dst, 32: hdr.ip.src, 64: hdr.tcp.dport, 80: hdr.tcp.sport, 96: ig_intr_md.ingress_port }
      hash 8:
        0..9: random(hdr.ip.dst, hdr.ip.src)
        10..19: random(hdr.ip.dst, hdr.ip.src)
        20..29: random(hdr.ip.dst, hdr.ip.src)
