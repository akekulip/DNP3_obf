      $precompute(0, 4):
      - hit_allowed: { allowed: true }
      - default_action: { allowed: true }
      - handle: 0x200000e3
      - next_table: 0
      - set W16(0..31), hash_dist(0, 1, 0..31)
    default_action: $precompute
  exact_match normalization_ack_t_0 3:
    p4: { name: r_Egress.normalization_ack_t, size: 1 }
    p4_param_order: 
      hdr.prov.kind: { type: exact, size: 8, full_size: 8 }
    row: 0
    result_bus: 0
    gateway:
      name: normalization_ack_t_0-gateway
      input_xbar:
        exact group 0: { 112: hdr.prov.kind }
      row: 6
      bus: 1
      unit: 0
      payload_row: 0
      payload_unit: 0
      payload: 0x1
      format: { action: 0..1 }
      match: { 0: hdr.prov.kind }
      0xe0:
        action: capture_normalization_ack
        next:  shape_t_0
      miss:
        run_table: true
    hit: [  shape_t_0 ]
    miss:  shape_t_0
    instruction: normalization_ack_t_0(action, $DEFAULT)
    actions:
