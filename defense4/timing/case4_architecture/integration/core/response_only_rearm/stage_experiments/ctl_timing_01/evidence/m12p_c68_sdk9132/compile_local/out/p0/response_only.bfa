  init_zero: [ W18, H46, H47, B39, H62, TH0, H80, B25, B49, W20, W23, B36, W16, W19, W25, W26, W24, W27, W30, B48, B38, W29, H19, H17, B17, B16, H57, H60, H59, B18, B19, B20, B21, H61 ]
  bitwise_or: [ B21, B25, H61 ]
  hdr_len_adj: 27
  meta_opt: 8191
  states:
    $init_match:
      *:
        counter:
          imm: 38
        0..1: H21  # bit[7..15] -> H21 bit[8..0]: egress::eg_intr_md.egress_port
        intr_md: 9
        load: { half : 0..1 }
        shift: 27
        buf_req: 27
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0b*******000001001:
        counter: dec 16
        0..1: H37  # egress::hdr.prov.epoch[31:16].16-31
        2..3: H36  # egress::hdr.prov.epoch[15:0].0-15
        4..7: W22  # egress::hdr.prov.wgen
        8..9: H35  # egress::hdr.prov.aux[31:16].16-31
        10..11: H34  # egress::hdr.prov.aux[15:0].0-15
        12: B31  # egress::hdr.prov.kind
        13: TB8  # egress::hdr.prov.stage
        H61: 1  # value 1 -> H61 bit[0]: egress::hdr.prov.$valid
        load: { half : 14..15 }
        shift: 14
        buf_req: 16
        next: provenance.$split_0
      0b*******001000000:
        counter: dec 16
        0..1: H37  # egress::hdr.prov.epoch[31:16].16-31
        2..3: H36  # egress::hdr.prov.epoch[15:0].0-15
        4..7: W22  # egress::hdr.prov.wgen
        8..9: H35  # egress::hdr.prov.aux[31:16].16-31
        10..11: H34  # egress::hdr.prov.aux[15:0].0-15
        12: B31  # egress::hdr.prov.kind
        13: TB8  # egress::hdr.prov.stage
        H61: 1  # value 1 -> H61 bit[0]: egress::hdr.prov.$valid
        load: { half : 14..15 }
        shift: 14
        buf_req: 16
        next: provenance.$split_0
      0b*******000110000:
        counter: dec 16
        0..1: H37  # egress::hdr.prov.epoch[31:16].16-31
        2..3: H36  # egress::hdr.prov.epoch[15:0].0-15
        4..7: W22  # egress::hdr.prov.wgen
        8..9: H35  # egress::hdr.prov.aux[31:16].16-31
        10..11: H34  # egress::hdr.prov.aux[15:0].0-15
        12: B31  # egress::hdr.prov.kind
        13: TB8  # egress::hdr.prov.stage
        H61: 1  # value 1 -> H61 bit[0]: egress::hdr.prov.$valid
        load: { half : 14..15 }
        shift: 14
        buf_req: 16
        next: provenance.$split_0
      0x****:
        buf_req: 0
        next: $entry_point.start.$ctr_stall0
    provenance.$split_0:
      match: [ half ]
      0x0000:
        0..1: TH1  # egress::hdr.prov.reserved
        load: { half : 14..15 }
        shift: 2
        buf_req: 16
        next: eth
      0x****:
        0..1: TH1  # egress::hdr.prov.reserved
        shift: 2
        buf_req: 2
        next: min_parse_depth_reject_initial
    eth:
      match: [ half ]
      0x0800:
        counter: dec 14
        0..1: TH26  # egress::hdr.eth.dst[47:32].32-47
        2..5: TW1  # egress::hdr.eth.dst[31:0].0-31
        6..7: TH25  # egress::hdr.eth.src[47:32].32-47
        8..11: TW0  # egress::hdr.eth.src[31:0].0-31
        12..13: TH24  # egress::hdr.eth.type
        H61: 2  # value 1 -> H61 bit[1]: egress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: ip
      0x****:
        counter: dec 14
        0..1: TH26  # egress::hdr.eth.dst[47:32].32-47
        2..5: TW1  # egress::hdr.eth.dst[31:0].0-31
        6..7: TH25  # egress::hdr.eth.src[47:32].32-47
        8..11: TW0  # egress::hdr.eth.src[31:0].0-31
        12..13: TH24  # egress::hdr.eth.type
        H61: 2  # value 1 -> H61 bit[1]: egress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: min_parse_depth_accept_initial
    ip:
      *:
        counter: dec 20
        0..1: TH4
            # - bit[0..3] -> TH4 bit[15..12]: egress::hdr.ip.version
            # - bit[4..7] -> TH4 bit[11..8]: egress::hdr.ip.ihl
            # - bit[8..15] -> TH4 bit[7..0]: egress::hdr.ip.tos
        2..3: H16  # egress::hdr.ip.len
        4..5: TH12  # egress::hdr.ip.id
        6: TB2
            # - bit[48..50] -> TB2 bit[7..5]: egress::hdr.ip.flags
            # - bit[51..55] -> TB2 bit[4..0]: egress::hdr.ip.frag[12:8].8-12
        7: TB3  # egress::hdr.ip.frag[7:0].0-7
        8: TB1  # egress::hdr.ip.ttl
        9: TB0  # egress::hdr.ip.proto
        10..11: TH5  # egress::hdr.ip.checksum
        load: { byte1 : 0, byte0 : 9 }
        shift: 2
        buf_req: 12
        next: ip.$split_0
    ip.$split_0:
      match: [ byte1, byte0 ]
      0x4506:
        10..11: H49  # egress::hdr.ip.src[31:16].16-31
        12..13: H48  # egress::hdr.ip.src[15:0].0-15
        14..15: H39  # egress::hdr.ip.dst[31:16].16-31
        16..17: H38  # egress::hdr.ip.dst[15:0].0-15
        H61: 4  # value 1 -> H61 bit[2]: egress::hdr.ip.$valid
        load: { half : 4..5 }
        buf_req: 18
        next: ip_frag
      0x4*06:
        10..11: H49  # egress::hdr.ip.src[31:16].16-31
        12..13: H48  # egress::hdr.ip.src[15:0].0-15
        14..15: H39  # egress::hdr.ip.dst[31:16].16-31
        16..17: H38  # egress::hdr.ip.dst[15:0].0-15
        H61: 4  # value 1 -> H61 bit[2]: egress::hdr.ip.$valid
        shift: 18
        buf_req: 18
        next: ip_odd
      0x****:
        10..11: H49  # egress::hdr.ip.src[31:16].16-31
        12..13: H48  # egress::hdr.ip.src[15:0].0-15
        14..15: H39  # egress::hdr.ip.dst[31:16].16-31
        16..17: H38  # egress::hdr.ip.dst[15:0].0-15
        H61: 4  # value 1 -> H61 bit[2]: egress::hdr.ip.$valid
        shift: 18
        buf_req: 18
        next: end
    ip_frag:
      match: [ half ]
      0x0000:
        load: { half : 0..1 }
        shift: 18
        buf_req: 18
        next: tcp
      0x4000:
        load: { half : 0..1 }
        shift: 18
        buf_req: 18
        next: tcp
      0x****:
        B25: 1  # value 1 -> B25 bit[0]: egress::m.ip_odd
        shift: 18
        buf_req: 18
        next: end
    tcp:
      *:
        checksum 0:
          type: RESIDUAL
          mask: [ 4..7, 8..11, 14..15 ]
          swap: 0
          start: 1
          end: 0
        counter: dec 20
        0..1: H33  # egress::hdr.tcp.sport
        2..3: H32  # egress::hdr.tcp.dport
        4..7: W17  # egress::hdr.tcp.seq
        8..11: W21  # egress::hdr.tcp.ack
        12..13: H23
            # - bit[96..99] -> H23 bit[15..12]: egress::hdr.tcp.offset
            # - bit[100..103] -> H23 bit[11..8]: egress::hdr.tcp.reserved
            # - bit[104..111] -> H23 bit[7..0]: egress::hdr.tcp.flags
        14..15: H22  # egress::hdr.tcp.window
        H61: 8  # value 1 -> H61 bit[3]: egress::hdr.tcp.$valid
        load: { byte1 : 12 }
        shift: 16
        buf_req: 16
        next: tcp.$split_0
    tcp.$split_0:
      match: [ byte1 ]
      0x8*:
        checksum 0:
          type: RESIDUAL
          mask: [ 0..1 ]
          swap: 0
          start: 0
          end: 1
          dest: TH0
          end_pos: 3
        0..1: TH14  # egress::hdr.tcp.checksum
        2..3: TH13  # egress::hdr.tcp.urgent
        shift: 4
        buf_req: 4
        next: dl_len
      0xa*:
        checksum 0:
          type: RESIDUAL
          mask: [ 0..1 ]
          swap: 0
          start: 0
          end: 1
          dest: TH0
          end_pos: 3
        0..1: TH14  # egress::hdr.tcp.checksum
        2..3: TH13  # egress::hdr.tcp.urgent
        load: { half : 4..5, byte0 : 6, byte1 : 7 }
        shift: 4
        buf_req: 8
        next: syn_ts
      0xb*:
        checksum 0:
          type: RESIDUAL
          mask: [ 0..1 ]
          swap: 0
          start: 0
          end: 1
          dest: TH0
          end_pos: 3
        0..1: TH14  # egress::hdr.tcp.checksum
        2..3: TH13  # egress::hdr.tcp.urgent
        shift: 4
        buf_req: 4
        next: synack_ts
      0x**:
        checksum 0:
          type: RESIDUAL
          mask: [ 0..1 ]
          swap: 0
          start: 0
          end: 1
          dest: TH0
          end_pos: 3
        0..1: TH14  # egress::hdr.tcp.checksum
        2..3: TH13  # egress::hdr.tcp.urgent
        shift: 4
        buf_req: 4
        next: tcp_odd
    dl_len:
      match: [ half ]
      0x004d:
        buf_req: 0
        next: ctl_len
      0b000000000100111*:
        buf_req: 0
        next: ctl_len
      0x005*:
        buf_req: 0
        next: ctl_len
      0b00000000011*****:
        buf_req: 0
        next: ctl_len
      0b000000001*******:
        buf_req: 0
        next: ctl_len
      0x01**:
        buf_req: 0
        next: ctl_len
      0o001***:
        buf_req: 0
        next: ctl_len
      0b000001**********:
        buf_req: 0
        next: ctl_len
      0b00001***********:
        buf_req: 0
        next: ctl_len
      0x1***:
        buf_req: 0
        next: ctl_len
      0b001*************:
        buf_req: 0
        next: ctl_len
      0b01**************:
        buf_req: 0
        next: ctl_len
      0o1*****:
        buf_req: 0
        next: ctl_len
      0x****:
        counter: dec 12
        0..3: TW8  # egress::hdr.tso.a
        4..7: TW3  # egress::hdr.tso.b
        8..11: TW2  # egress::hdr.tso.c
        H61: 16  # value 1 -> H61 bit[4]: egress::hdr.tso.$valid
        load: { half : 0..1, byte0 : 2, byte1 : 3 }
        shift: 12
        buf_req: 12
        next: ts12_short
    ctl_len:
      match: [ half ]
      0x004d:
        load: { half : 0..1, byte0 : 2, byte1 : 3 }
        buf_req: 4
        next: ts12_mid
      0b000000000100111*:
        load: { half : 0..1, byte0 : 2, byte1 : 3 }
        buf_req: 4
        next: ts12_mid
      0o00012*:
        load: { half : 0..1, byte0 : 2, byte1 : 3 }
        buf_req: 4
        next: ts12_mid
      0x0058:
        load: { half : 0..1, byte0 : 2, byte1 : 3 }
        buf_req: 4
        next: ts12_mid
      0x****:
        load: { half : 0..1, byte0 : 2, byte1 : 3 }
        buf_req: 4
        next: ts12
    ts12_mid:
      match: [ half, byte0, byte1 ]
      0x0101080a:
        counter: dec 12
        0..3: TW8  # egress::hdr.tso.a
        4..7: TW3  # egress::hdr.tso.b
        8..11: TW2  # egress::hdr.tso.c
        H61: 16  # value 1 -> H61 bit[4]: egress::hdr.tso.$valid
        load: { byte1 : 14 }
        shift: 12
        buf_req: 15
        next: dl_mid
      0x********:
        counter: dec 12
        0..3: TW8  # egress::hdr.tso.a
        4..7: TW3  # egress::hdr.tso.b
        8..11: TW2  # egress::hdr.tso.c
        H61: 16  # value 1 -> H61 bit[4]: egress::hdr.tso.$valid
        shift: 12
        buf_req: 12
        next: tcp_odd
    dl_mid:
      match: [ byte1 ]
      0x27:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: read_pp
      0x11:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: read_pp
      0x26:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: end
      0x**:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: end
    read_pp:
      *:
        counter: dec 10
        0: B28  # egress::hdr.rh.tpctrl
        1..2: H30
            # - bit[8..15] -> H30 bit[15..8]: egress::hdr.rh.appctrl
            # - bit[16..23] -> H30 bit[7..0]: egress::hdr.rh.func
        3..4: TH2  # egress::hdr.rh.iin
        5: B29  # egress::hdr.robj.g_group
        6..7: H27
            # - bit[48..55] -> H27 bit[15..8]: egress::hdr.robj.g_var
            # - bit[56..63] -> H27 bit[7..0]: egress::hdr.robj.g_qual
        8..9: H26
            # - bit[64..71] -> H26 bit[15..8]: egress::hdr.robj.g_start
            # - bit[72..79] -> H26 bit[7..0]: egress::hdr.robj.g_stop
        H61: 1536
            # - value 1 -> H61 bit[9]: egress::hdr.rh.$valid
            # - value 1 -> H61 bit[10]: egress::hdr.robj.$valid
        shift: 10
        buf_req: 10
        next: end
    tcp_odd:
      *:
        B25: 2  # value 1 -> B25 bit[1]: egress::m.tcp_odd
        buf_req: 0
        next: end
    ts12:
      match: [ half, byte0, byte1 ]
      0x0101080a:
        counter: dec 12
        0..3: TW8  # egress::hdr.tso.a
        4..7: TW3  # egress::hdr.tso.b
        8..11: TW2  # egress::hdr.tso.c
        H61: 16  # value 1 -> H61 bit[4]: egress::hdr.tso.$valid
        load: { byte1 : 14 }
        shift: 12
        buf_req: 15
        next: dl
      0x********:
        counter: dec 12
        0..3: TW8  # egress::hdr.tso.a
        4..7: TW3  # egress::hdr.tso.b
        8..11: TW2  # egress::hdr.tso.c
        H61: 16  # value 1 -> H61 bit[4]: egress::hdr.tso.$valid
        shift: 12
        buf_req: 12
        next: tcp_odd
    dl:
      match: [ byte1 ]
      0x27:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: read_pp
      0x11:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: read_pp
      0x26:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: ctl_b0
      0x**:
        counter: dec 10
        0..3: W48
            # - bit[0..15] -> W48 bit[31..16]: egress::hdr.dl.start
            # - bit[16..23] -> W48 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> W48 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W56
            # - bit[32..47] -> W56 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W56 bit[15..0]: egress::hdr.dl.src
        8: B32  # egress::hdr.dl.crc[15:8].8-15
        9: B33  # egress::hdr.dl.crc[7:0].0-7
        H61: 256  # value 1 -> H61 bit[8]: egress::hdr.dl.$valid
        shift: 10
        buf_req: 10
        next: end
    ctl_b0:
      *:
        counter: dec 39
        0..1: H55
            # - bit[0..7] -> H55 bit[15..8]: egress::hdr.cb0.tpctrl
            # - bit[8..15] -> H55 bit[7..0]: egress::hdr.cb0.appctrl
        2..3: H29
            # - bit[16..23] -> H29 bit[15..8]: egress::hdr.cb0.func
            # - bit[24..31] -> H29 bit[7..0]: egress::hdr.cb0.iin[15:8].8-15
        4..5: H28
            # - bit[32..39] -> H28 bit[15..8]: egress::hdr.cb0.iin[7:0].0-7
            # - bit[40..47] -> H28 bit[7..0]: egress::hdr.cb0.g_group
        6..7: H54
            # - bit[48..55] -> H54 bit[15..8]: egress::hdr.cb0.g_var
            # - bit[56..63] -> H54 bit[7..0]: egress::hdr.cb0.g_qual
        16: B35  # egress::hdr.cb0.crc0[15:8].8-15
        17: B37  # egress::hdr.cb0.crc0[7:0].0-7
        18..21: W31  # egress::hdr.ctn.off
        22: B26  # egress::hdr.ctn.status
        25..28: W60
            # - bit[200..207] -> W60 bit[31..24]: egress::hdr.ctn.count2
            # - bit[208..231] -> W60 bit[23..0]: egress::hdr.ctn.on2[31:8].8-31
