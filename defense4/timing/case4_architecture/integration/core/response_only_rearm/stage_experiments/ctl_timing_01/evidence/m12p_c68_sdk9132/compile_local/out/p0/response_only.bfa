      hash 2:
      hash group 1:
        table: [2]
        seed: 0x0
    gateway:
      name: leff_t_0$precompute-gateway
      row: 1
      bus: 0
      unit: 0
      0x0:  normalization_ack_t_0
      miss:  normalization_ack_t_0
      condition: 
        expression: "true(always hit)"
        true:  normalization_ack_t_0
        false:  normalization_ack_t_0
    next: []
    action_bus: { 96..99 : hash_dist(0, 1) }
    instruction: leff_t_0$precompute($DEFAULT, $DEFAULT)
