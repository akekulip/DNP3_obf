stage 0 ingress:
  phase0_match n_IgParser.$PORT_METADATA:
    p4:
      name: n_IgParser.$PORT_METADATA
      size: 288
      preferred_match_type: exact
      match_type: exact
    size: 288
    p4_param_order:
