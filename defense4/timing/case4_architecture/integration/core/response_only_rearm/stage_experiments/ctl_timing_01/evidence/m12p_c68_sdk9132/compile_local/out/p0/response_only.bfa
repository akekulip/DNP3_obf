        buf_req: 29
        next: ctl_b0.$split_0
    ctl_b0.$split_0:
      *:
        0..1: H25
            # - bit[0..7] -> H25 bit[15..8]: egress::hdr.cb0.g_count
            # - bit[8..15] -> H25 bit[7..0]: egress::hdr.cb0.index
        2..3: H24
