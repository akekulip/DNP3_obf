        shift: 11
        buf_req: 11
        next: min_parse_depth_accept_loop.$it1.$split_0
      0b**:
        buf_req: 0
        next: end
    min_parse_depth_accept_loop.$it1.$split_0:
      match: [ ctr_neg, ctr_zero ]
      option: ignore_max_depth
      0x0:
        counter: dec 11
        0: TB2  # egress::hdr.min_parse_depth_padding_1[2].packet_payload[87:80].80-87
        1..2: TH23  # egress::hdr.min_parse_depth_padding_1[2].packet_payload[79:64].64-79
        3..6: TW12  # egress::hdr.min_parse_depth_padding_1[2].packet_payload[63:32].32-63
        7: TB11  # egress::hdr.min_parse_depth_padding_1[2].packet_payload[31:24].24-31
        8: TB10  # egress::hdr.min_parse_depth_padding_1[2].packet_payload[23:16].16-23
        9: TB9  # egress::hdr.min_parse_depth_padding_1[2].packet_payload[15:8].8-15
        shift: 10
