            # - bit[48..55] -> W18 bit[31..24]: egress::hdr.robj.g_var
            # - bit[56..63] -> W18 bit[23..16]: egress::hdr.robj.g_qual
            # - bit[64..71] -> W18 bit[15..8]: egress::hdr.robj.g_start
            # - bit[72..79] -> W18 bit[7..0]: egress::hdr.robj.g_stop
