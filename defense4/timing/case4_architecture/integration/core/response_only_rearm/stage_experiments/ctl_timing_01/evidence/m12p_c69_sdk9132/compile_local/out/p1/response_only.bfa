          type: RESIDUAL
          mask: [ 16..17 ]
          swap: 0
          start: 1
          end: 1
          dest: TH0
          end_pos: 19
        counter: dec 20
        0..3: W19
            # - bit[0..15] -> W19 bit[31..16]: egress::hdr.tcp.sport
            # - bit[16..31] -> W19 bit[15..0]: egress::hdr.tcp.dport
        4..7: TW11  # egress::hdr.tcp.seq
        8..11: TW10  # egress::hdr.tcp.ack
        12..15: TW0
            # - bit[96..99] -> TW0 bit[31..28]: egress::hdr.tcp.offset
            # - bit[100..103] -> TW0 bit[27..24]: egress::hdr.tcp.reserved
            # - bit[104..111] -> TW0 bit[23..16]: egress::hdr.tcp.flags
            # - bit[112..127] -> TW0 bit[15..0]: egress::hdr.tcp.window
        16..17: TH21  # egress::hdr.tcp.checksum
        18: TB11  # egress::hdr.tcp.urgent[15:8].8-15
        19: TB10  # egress::hdr.tcp.urgent[7:0].0-7
        W26: 8  # value 1 -> W26 bit[3]: egress::hdr.tcp.$valid
        shift: 20
        buf_req: 20
        next: end
    ts12:
      *:
        counter: dec 12
        0..1: TH16  # egress::hdr.tso.a[31:16].16-31
        2..3: TH15  # egress::hdr.tso.a[15:0].0-15
        4..5: TH14  # egress::hdr.tso.b[31:16].16-31
        6..7: TH13  # egress::hdr.tso.b[15:0].0-15
        W26: 16  # value 1 -> W26 bit[4]: egress::hdr.tso.$valid
        load: { half : 0..1, byte0 : 2, byte1 : 3 }
        shift: 8
        buf_req: 8
        next: ts12.$split_0
    ts12.$split_0:
      match: [ half, byte0, byte1 ]
      0x0101080a:
        0..1: TH12  # egress::hdr.tso.c[31:16].16-31
        2..3: TH5  # egress::hdr.tso.c[15:0].0-15
        load: { byte1 : 6 }
        shift: 4
        buf_req: 7
        next: dl
      0x********:
        0..1: TH12  # egress::hdr.tso.c[31:16].16-31
        2..3: TH5  # egress::hdr.tso.c[15:0].0-15
        shift: 4
        buf_req: 4
        next: end
    dl:
      match: [ byte1 ]
      0x4c:
        counter: dec 10
        0..1: TH1  # egress::hdr.dl.start
        2..3: H29
            # - bit[16..23] -> H29 bit[15..8]: egress::hdr.dl.len
            # - bit[24..31] -> H29 bit[7..0]: egress::hdr.dl.ctrl
        4..7: W16
            # - bit[32..47] -> W16 bit[31..16]: egress::hdr.dl.dst
            # - bit[48..63] -> W16 bit[15..0]: egress::hdr.dl.src
        8..9: H36  # egress::hdr.dl.crc
        W26: 32  # value 1 -> W26 bit[5]: egress::hdr.dl.$valid
