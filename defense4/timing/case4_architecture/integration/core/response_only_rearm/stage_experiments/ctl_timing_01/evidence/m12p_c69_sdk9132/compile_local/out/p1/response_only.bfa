      match: [ half ]
      0xe100:
        0..3: W0  # ingress::md.packet_epoch
        0..3: W2  # ingress::hdr.tev.epoch
        0..3: W10  # bit[1..31] -> W10 bit[30..0]: ingress::md.epoch_delta[30:0].0-30
        12: B6  # ingress::md.event_kind
        12..13: H8
            # - bit[96..103] -> H8 bit[15..8]: ingress::hdr.tev.kind
            # - bit[104..111] -> H8 bit[7..0]: ingress::hdr.tev.stage
        14: B4  # ingress::hdr.tev.reserved[15:8].8-15
        15: B3  # ingress::hdr.tev.reserved[7:0].0-7
        W10: 2147483648  # value 1 -> W10 bit[31]: ingress::md.epoch_delta[31:31].31-31
        B5: 1  # value 1 -> B5 bit[0]: ingress::hdr.tev.$valid
        load: { byte1 : 12, half : 14..15 }
        shift: 4
        buf_req: 16
        next: parse_clone_tev.$split_0
      0x****:
        buf_req: 0
        next: end
    parse_clone_tev.$split_0:
      match: [ byte1, half ]
      0x090000:
        0..3: W9  # ingress::hdr.tev.wgen
        4..7: W8  # ingress::hdr.tev.t0q
        12..13: TH8  # ingress::hdr.eth.dst[47:32].32-47
        14..17: TW5  # ingress::hdr.eth.dst[31:0].0-31
        18..19: TH7  # ingress::hdr.eth.src[47:32].32-47
        20..23: TW4  # ingress::hdr.eth.src[31:0].0-31
        24..25: TH6  # ingress::hdr.eth.type
        B5: 2  # value 1 -> B5 bit[1]: ingress::hdr.eth.$valid
        shift: 26
        buf_req: 26
        next: end
      0x0c0000:
        0..3: W9  # ingress::hdr.tev.wgen
        4..7: W8  # ingress::hdr.tev.t0q
        12..13: TH8  # ingress::hdr.eth.dst[47:32].32-47
        14..17: TW5  # ingress::hdr.eth.dst[31:0].0-31
        18..19: TH7  # ingress::hdr.eth.src[47:32].32-47
        20..23: TW4  # ingress::hdr.eth.src[31:0].0-31
        24..25: TH6  # ingress::hdr.eth.type
        B5: 2  # value 1 -> B5 bit[1]: ingress::hdr.eth.$valid
        shift: 26
        buf_req: 26
        next: end
      0x******:
        0..3: W9  # ingress::hdr.tev.wgen
        4..7: W8  # ingress::hdr.tev.t0q
        shift: 12
        buf_req: 12
        next: end
    parse_timer:
      match: [ byte1 ]
      0b***01000:
        0: B2
            # - bit[0..2] -> B2 bit[7..5]: ingress::hdr.timer._pad1
            # - bit[3..4] -> B2 bit[4..3]: ingress::hdr.timer.pipe_id
            # - bit[5..7] -> B2 bit[2..0]: ingress::hdr.timer.app_id
        1: B3  # ingress::hdr.timer._pad2
        2..3: H3  # ingress::hdr.timer.batch_id
        4..5: H10  # ingress::hdr.timer.packet_id
        B5: 16  # value 1 -> B5 bit[4]: ingress::hdr.timer.$valid
        B7: 1  # value 1 -> B7 bit[7..0]: ingress::md.token_ok
        shift: 6
        buf_req: 6
        next: end
      0x**:
        0: B2
            # - bit[0..2] -> B2 bit[7..5]: ingress::hdr.timer._pad1
            # - bit[3..4] -> B2 bit[4..3]: ingress::hdr.timer.pipe_id
            # - bit[5..7] -> B2 bit[2..0]: ingress::hdr.timer.app_id
        1: B3  # ingress::hdr.timer._pad2
        2..3: H3  # ingress::hdr.timer.batch_id
        4..5: H10  # ingress::hdr.timer.packet_id
        B5: 16  # value 1 -> B5 bit[4]: ingress::hdr.timer.$valid
        shift: 6
        buf_req: 6
        next: end
deparser ingress:
  dictionary:
    B2: B5(4)
        # - bit[7..5]: ingress::hdr.timer._pad1 if ingress::hdr.timer.$valid
        # - bit[4..3]: ingress::hdr.timer.pipe_id if ingress::hdr.timer.$valid
        # - bit[2..0]: ingress::hdr.timer.app_id if ingress::hdr.timer.$valid
    B3: B5(4)  # ingress::hdr.timer._pad2 if ingress::hdr.timer.$valid
    H3: B5(4)  # ingress::hdr.timer.batch_id if ingress::hdr.timer.$valid
    H10: B5(4)  # ingress::hdr.timer.packet_id if ingress::hdr.timer.$valid
    TW6: B5(3)  # ingress::hdr.clone.tag if ingress::hdr.clone.$valid
    W2: B5(0)  # ingress::hdr.tev.epoch if ingress::hdr.tev.$valid
    W9: B5(0)  # ingress::hdr.tev.wgen if ingress::hdr.tev.$valid
    W8: B5(0)  # ingress::hdr.tev.t0q if ingress::hdr.tev.$valid
    H8: B5(0)
        # - bit[15..8]: ingress::hdr.tev.kind if ingress::hdr.tev.$valid
        # - bit[7..0]: ingress::hdr.tev.stage if ingress::hdr.tev.$valid
    B4: B5(0)  # ingress::hdr.tev.reserved.8-15 if ingress::hdr.tev.$valid
    B3: B5(0)  # ingress::hdr.tev.reserved.0-7 if ingress::hdr.tev.$valid
    H9: B5(2)
        # - bit[15..8]: ingress::hdr.ladder.role if ingress::hdr.ladder.$valid
        # - bit[7..0]: ingress::hdr.ladder.child if ingress::hdr.ladder.$valid
    H6: B5(2)  # ingress::hdr.ladder.generation if ingress::hdr.ladder.$valid
    W1: B5(2)  # ingress::hdr.ladder.budget if ingress::hdr.ladder.$valid
    TH8: B5(1)  # ingress::hdr.eth.dst.32-47 if ingress::hdr.eth.$valid
    TW5: B5(1)  # ingress::hdr.eth.dst.0-31 if ingress::hdr.eth.$valid
    TH7: B5(1)  # ingress::hdr.eth.src.32-47 if ingress::hdr.eth.$valid
    TW4: B5(1)  # ingress::hdr.eth.src.0-31 if ingress::hdr.eth.$valid
    TH6: B5(1)  # ingress::hdr.eth.type if ingress::hdr.eth.$valid
  egress_unicast_port: H0(0..8)  # bit[8..0]: ingress::ig_intr_md_for_tm.ucast_egress_port
  qid: B1(0..4)  # bit[4..0]: ingress::ig_intr_md_for_tm.qid
  drop_ctl: B1(5..7)  # bit[7..5]: ingress::ig_intr_md_for_dprsr.drop_ctl
  mirror:
    select: B0(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H2(0..9)  # bit[9..0]: ingress::$tmp4
    1:
      - H1(0..9)  # bit[9..0]: ingress::md.clone_ses
      - H11  # ingress::md.clone_tag.16-31
      - H5  # ingress::md.clone_tag.0-15
parser egress:
  start: $init_match
  init_zero: [ TH0, W27, H20, B20, H32, H33, H40, H16, B17, W26, B16 ]
  bitwise_or: [ B17, W26 ]
  hdr_len_adj: 27
  meta_opt: 8191
  states:
    $init_match:
      *:
        counter:
          imm: 38
        0..1: H17  # bit[7..15] -> H17 bit[8..0]: egress::eg_intr_md.egress_port
        intr_md: 9
        load: { half : 0..1 }
        shift: 27
        buf_req: 27
        next: $entry_point.start
    $entry_point.start:
      match: [ half ]
      0b*******010110100:
        load: { half : 12..13 }
        buf_req: 14
        next: tev
      0x****:
        buf_req: 0
        next: $entry_point.start.$ctr_stall0
    tev:
      match: [ half ]
      0x0b00:
        counter: dec 16
        0..1: TH4  # egress::hdr.tev.epoch[31:16].16-31
        2..3: TH3  # egress::hdr.tev.epoch[15:0].0-15
        4..7: TW3  # egress::hdr.tev.wgen
        8..11: TW2  # egress::hdr.tev.t0q
        12..15: TW1
            # - bit[96..103] -> TW1 bit[31..24]: egress::hdr.tev.kind
            # - bit[104..111] -> TW1 bit[23..16]: egress::hdr.tev.stage
            # - bit[112..127] -> TW1 bit[15..0]: egress::hdr.tev.reserved
        W26: 1  # value 1 -> W26 bit[0]: egress::hdr.tev.$valid
        load: { half : 28..29 }
        shift: 16
        buf_req: 30
        next: eth
      0x****:
        counter: dec 16
        0..1: TH4  # egress::hdr.tev.epoch[31:16].16-31
        2..3: TH3  # egress::hdr.tev.epoch[15:0].0-15
        4..7: TW3  # egress::hdr.tev.wgen
        8..11: TW2  # egress::hdr.tev.t0q
        12..15: TW1
            # - bit[96..103] -> TW1 bit[31..24]: egress::hdr.tev.kind
            # - bit[104..111] -> TW1 bit[23..16]: egress::hdr.tev.stage
            # - bit[112..127] -> TW1 bit[15..0]: egress::hdr.tev.reserved
        W26: 1  # value 1 -> W26 bit[0]: egress::hdr.tev.$valid
        shift: 16
        buf_req: 16
        next: min_parse_depth_accept_initial
    eth:
      match: [ half ]
      0x0800:
        counter: dec 14
        0..1: TH20  # egress::hdr.eth.dst[47:32].32-47
        2..5: TW9  # egress::hdr.eth.dst[31:0].0-31
        6..7: TH19  # egress::hdr.eth.src[47:32].32-47
        8..11: TW8  # egress::hdr.eth.src[31:0].0-31
        12..13: TH18  # egress::hdr.eth.type
        W26: 2  # value 1 -> W26 bit[1]: egress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: ip
      0x****:
        counter: dec 14
        0..1: TH20  # egress::hdr.eth.dst[47:32].32-47
        2..5: TW9  # egress::hdr.eth.dst[31:0].0-31
        6..7: TH19  # egress::hdr.eth.src[47:32].32-47
        8..11: TW8  # egress::hdr.eth.src[31:0].0-31
        12..13: TH18  # egress::hdr.eth.type
        W26: 2  # value 1 -> W26 bit[1]: egress::hdr.eth.$valid
        shift: 14
        buf_req: 14
        next: min_parse_depth_accept_initial
    ip:
      *:
        counter: dec 20
        0..1: TH17
            # - bit[0..3] -> TH17 bit[15..12]: egress::hdr.ip.version
            # - bit[4..7] -> TH17 bit[11..8]: egress::hdr.ip.ihl
            # - bit[8..15] -> TH17 bit[7..0]: egress::hdr.ip.tos
        2..3: H31  # egress::hdr.ip.len
        4..5: TH2  # egress::hdr.ip.id
        6: TB2
            # - bit[48..50] -> TB2 bit[7..5]: egress::hdr.ip.flags
            # - bit[51..55] -> TB2 bit[4..0]: egress::hdr.ip.frag[12:8].8-12
        7: TB3  # egress::hdr.ip.frag[7:0].0-7
        8: TB1  # egress::hdr.ip.ttl
        9: TB0  # egress::hdr.ip.proto
        12..15: W21  # egress::hdr.ip.src
        16..19: W20  # egress::hdr.ip.dst
        W26: 4  # value 1 -> W26 bit[2]: egress::hdr.ip.$valid
        load: { byte1 : 0, byte0 : 9, half : 2..3 }
        shift: 6
        buf_req: 20
        next: ip.$split_0
    ip.$split_0:
      match: [ byte1, byte0 ]
      0x4506:
        4: TB9  # egress::hdr.ip.checksum[15:8].8-15
        5: TB8  # egress::hdr.ip.checksum[7:0].0-7
