        W26: 1984
            # - value 1 -> W26 bit[6]: egress::hdr.rh.$valid
            # - value 1 -> W26 bit[7]: egress::hdr.robj.$valid
            # - value 1 -> W26 bit[8]: egress::hdr.p03.$valid
            # - value 1 -> W26 bit[9]: egress::hdr.p45.$valid
            # - value 1 -> W26 bit[10]: egress::hdr.c0.$valid
        buf_req: 0
        next: end
    min_parse_depth_accept_initial:
