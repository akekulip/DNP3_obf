        buf_req: 0
        next: end
    min_parse_depth_accept_loop.$split_0:
      match: [ ctr_neg, ctr_zero ]
      option: ignore_max_depth
      0x0:
        counter: dec 11
        0: TB1  # egress::hdr.min_parse_depth_padding_1[1].packet_payload[87:80].80-87
        1..2: TH22  # egress::hdr.min_parse_depth_padding_1[1].packet_payload[79:64].64-79
        3..4: TH17  # egress::hdr.min_parse_depth_padding_1[1].packet_payload[63:48].48-63
        5..6: TH2  # egress::hdr.min_parse_depth_padding_1[1].packet_payload[47:32].32-47
        7..10: TW11  # egress::hdr.min_parse_depth_padding_1[1].packet_payload[31:0].0-31
