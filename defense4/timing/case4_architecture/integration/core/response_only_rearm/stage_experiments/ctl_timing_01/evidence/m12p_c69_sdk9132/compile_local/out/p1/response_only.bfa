        shift: 14
        buf_req: 14
        next: ip_len
      0x****:
        4: TB9  # egress::hdr.ip.checksum[15:8].8-15
        5: TB8  # egress::hdr.ip.checksum[7:0].0-7
        shift: 14
        buf_req: 14
        next: end
    ip_len:
      match: [ half ]
      0x008f:
        buf_req: 0
        next: ip_frag
      0x00ba:
        buf_req: 0
        next: ip_frag
      0x****:
        buf_req: 0
        next: end
    ip_frag:
      match: [ byte0, byte1 ]
      0x0000:
        load: { byte1 : 12 }
        buf_req: 13
        next: tcp
      0x4000:
        load: { byte1 : 12 }
        buf_req: 13
        next: tcp
      0x****:
        buf_req: 0
        next: end
    tcp:
      match: [ byte1 ]
      0x8*:
        checksum 0:
          type: RESIDUAL
          mask: [ 16..17 ]
          swap: 0
          start: 1
          end: 1
          dest: TH0
          end_pos: 19
        counter: dec 20
        0..3: W19
            # - bit[0..15] -> W19 bit[31..16]: egress::hdr.tcp.sport
            # - bit[16..31] -> W19 bit[15..0]: egress::hdr.tcp.dport
        4..7: TW11  # egress::hdr.tcp.seq
        8..11: TW10  # egress::hdr.tcp.ack
        12..15: TW0
            # - bit[96..99] -> TW0 bit[31..28]: egress::hdr.tcp.offset
            # - bit[100..103] -> TW0 bit[27..24]: egress::hdr.tcp.reserved
            # - bit[104..111] -> TW0 bit[23..16]: egress::hdr.tcp.flags
            # - bit[112..127] -> TW0 bit[15..0]: egress::hdr.tcp.window
        16..17: TH21  # egress::hdr.tcp.checksum
        18: TB11  # egress::hdr.tcp.urgent[15:8].8-15
        19: TB10  # egress::hdr.tcp.urgent[7:0].0-7
        W26: 8  # value 1 -> W26 bit[3]: egress::hdr.tcp.$valid
        shift: 20
        buf_req: 20
        next: ts12
      0x**:
